  RowBox[{
   RowBox[{"accompaNetModel", "[", 
    RowBox[{
     RowBox[{"rows_List", ":", "accompaNetData"}], ",", 
     RowBox[{"categories_", ":", "Automatic"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "vertices", ",", "sets", ",", "frequencies", ",", "sizes", ",", 
       "incidence", ",", "prevalence", ",", "single", ",", "weights", ",", 
       "fractional", ",", "indices", ",", "pairs", ",", "adjacency", ",", 
       "edges"}], "}"}], ",", 
     RowBox[{
      RowBox[{"vertices", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"categories", "===", "Automatic"}], ",", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"rows", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}], ",", 
         "categories"}], "]"}]}], ";", 
      RowBox[{"sets", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "&"}], "/@", 
        "rows"}]}], ";", 
      RowBox[{"frequencies", "=", 
       RowBox[{"rows", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      RowBox[{"sizes", "=", 
       RowBox[{"Length", "/@", "sets"}]}], ";", 
      RowBox[{"incidence", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Boole", "[", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"s", ",", "v"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "sets"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", "vertices"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"prevalence", "=", 
       RowBox[{"frequencies", ".", "incidence"}]}], ";", 
      RowBox[{"single", "=", 
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"#2", "==", "1"}], ",", "#1", ",", "0"}], "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"frequencies", ",", "sizes"}], "}"}]}], "]"}], ".", 
        "incidence"}]}], ";", 
      RowBox[{"weights", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "incidence", "]"}], ".", 
        RowBox[{"DiagonalMatrix", "[", "frequencies", "]"}], ".", 
        "incidence"}]}], ";", 
      RowBox[{"weights", "-=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Diagonal", "[", "weights", "]"}], "]"}]}], ";", 
      RowBox[{"fractional", "=", 
       RowBox[{
        RowBox[{"Transpose", "[", "incidence", "]"}], ".", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#2", ">", "1"}], ",", 
              RowBox[{"#1", "/", 
               RowBox[{"(", 
                RowBox[{"#2", "-", "1"}], ")"}]}], ",", "0"}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"frequencies", ",", "sizes"}], "}"}]}], "]"}], "]"}], ".",
         "incidence"}]}], ";", 
      RowBox[{"fractional", "-=", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Diagonal", "[", "fractional", "]"}], "]"}]}], ";", 
      RowBox[{"adjacency", "=", 
       RowBox[{"Unitize", "[", "weights", "]"}]}], ";", 
      RowBox[{"indices", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "vertices", "]"}], "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Extract", "[", 
            RowBox[{"weights", ",", "#"}], "]"}], ">", "0"}], "&"}]}], 
        "]"}]}], ";", 
      RowBox[{"pairs", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"vertices", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", "indices"}]}], ";", 
      RowBox[{"edges", "=", 
       RowBox[{"UndirectedEdge", "@@@", "pairs"}]}], ";", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Categories\>\"", "->", "vertices"}], ",", 
        RowBox[{"\"\<Rows\>\"", "->", "rows"}], ",", 
        RowBox[{"\"\<Sets\>\"", "->", "sets"}], ",", 
        RowBox[{"\"\<Frequencies\>\"", "->", "frequencies"}], ",", 
        RowBox[{"\"\<Sizes\>\"", "->", "sizes"}], ",", 
        RowBox[{"\"\<Incidence\>\"", "->", "incidence"}], ",", 
        RowBox[{"\"\<Prevalence\>\"", "->", "prevalence"}], ",", 
        RowBox[{"\"\<SingleLabel\>\"", "->", "single"}], ",", 
        RowBox[{"\"\<Degree\>\"", "->", 
         RowBox[{"Total", "[", "adjacency", "]"}]}], ",", 
        RowBox[{"\"\<Strength\>\"", "->", 
         RowBox[{"Total", "[", "weights", "]"}]}], ",", 
        RowBox[{"\"\<FractionalStrength\>\"", "->", 
         RowBox[{"Total", "[", "fractional", "]"}]}], ",", 
        RowBox[{"\"\<Weights\>\"", "->", "weights"}], ",", 
        RowBox[{"\"\<FractionalWeights\>\"", "->", "fractional"}], ",", 
        RowBox[{"\"\<PairIndices\>\"", "->", "indices"}], ",", 
        RowBox[{"\"\<Pairs\>\"", "->", "pairs"}], ",", 
        RowBox[{"\"\<Adjacency\>\"", "->", "adjacency"}], ",", 
        RowBox[{"\"\<Graph\>\"", "->", 
         RowBox[{"Graph", "[", 
          RowBox[{"vertices", ",", "edges", ",", 
           RowBox[{"EdgeWeight", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Extract", "[", 
                RowBox[{"weights", ",", "#"}], "]"}], "&"}], "/@", 
              "indices"}], ")"}]}]}], "]"}]}], ",", 
        RowBox[{"\"\<BinaryGraph\>\"", "->", 
         RowBox[{"Graph", "[", 
          RowBox[{"vertices", ",", "edges"}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
  ";", 
  RowBox[{
   RowBox[{"accompaNetBetweenness", "[", 
    RowBox[{"adjacency_", "?", "MatrixQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
