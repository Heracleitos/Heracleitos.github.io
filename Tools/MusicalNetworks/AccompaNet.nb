             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<SingleLabel\>\"", "->", 
            RowBox[{"single", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Degree\>\"", "->", 
            RowBox[{"degree", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Strength\>\"", "->", 
            RowBox[{"strength", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<FractionalStrength\>\"", "->", 
            RowBox[{"fractional", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Betweenness\>\"", "->", 
            RowBox[{"betweenness", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Harmonic\>\"", "->", 
            RowBox[{"harmonic", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], "|>"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "k"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"categories", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{"categories", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"#", "[", "\"\<Prevalence\>\"", "]"}]}], ",", 
            RowBox[{"#", "[", "\"\<Category\>\"", "]"}]}], "}"}], "&"}]}], 
        "]"}]}], ";", 
      RowBox[{"pairs", "=", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"ij", ",", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"w", "=", 
              RowBox[{"Extract", "[", 
               RowBox[{
                RowBox[{"model", "[", "\"\<Weights\>\"", "]"}], ",", "ij"}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Categories\>\"", "->", 
               RowBox[{"vertices", "[", 
                RowBox[{"[", "ij", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<Frequency\>\"", "->", "w"}], ",", 
              RowBox[{"\"\<FractionalWeight\>\"", "->", 
               RowBox[{"Extract", "[", 
                RowBox[{
                 RowBox[{"model", "[", "\"\<FractionalWeights\>\"", "]"}], ",",
                  "ij"}], "]"}]}], ",", 
              RowBox[{"\"\<Jaccard\>\"", "->", 
               RowBox[{"w", "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Total", "[", 
                   RowBox[{"prevalence", "[", 
                    RowBox[{"[", "ij", "]"}], "]"}], "]"}], "-", "w"}], 
                 ")"}]}]}]}], "|>"}]}], "]"}]}], "]"}], "/@", 
        RowBox[{"model", "[", "\"\<PairIndices\>\"", "]"}]}]}], ";", 
      RowBox[{"pairs", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{"pairs", ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"#", "[", "\"\<Frequency\>\"", "]"}]}], ",", 
            RowBox[{"Sort", "[", 
             RowBox[{"#", "[", "\"\<Categories\>\"", "]"}], "]"}]}], "}"}], 
          "&"}]}], "]"}]}], ";", 
      RowBox[{"configurations", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<ID\>\"", "->", 
            RowBox[{"rowIDs", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Categories\>\"", "->", 
            RowBox[{"Sort", "[", 
             RowBox[{"rows", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Frequency\>\"", "->", 
            RowBox[{"frequencies", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<DistinctCategories\>\"", "->", 
            RowBox[{"sizes", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<CategoryEntries\>\"", "->", 
            RowBox[{"Length", "[", 
             RowBox[{"rows", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "1"}], "]"}], "]"}], "]"}]}]}], "|>"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "rows", "]"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"sizeRows", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<DistinctCategories\>\"", "->", "m"}], ",", 
           RowBox[{"\"\<Configurations\>\"", "->", 
            RowBox[{"Count", "[", 
             RowBox[{"sizes", ",", "m"}], "]"}]}], ",", 
           RowBox[{"\"\<Recordings\>\"", "->", 
            RowBox[{"Total", "[", 
             RowBox[{"Pick", "[", 
              RowBox[{"frequencies", ",", "sizes", ",", "m"}], "]"}], "]"}]}],
            ",", 
           RowBox[{"\"\<PairOccurrences\>\"", "->", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"Pick", "[", 
               RowBox[{"frequencies", ",", "sizes", ",", "m"}], "]"}], "]"}], 
             RowBox[{"Binomial", "[", 
              RowBox[{"m", ",", "2"}], "]"}]}]}]}], "|>"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"Sort", "[", 
            RowBox[{"DeleteDuplicates", "[", "sizes", "]"}], "]"}]}], "}"}]}],
         "]"}]}], ";", 
      RowBox[{"thresholds", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"h", ",", "components"}], "}"}], ",", 
           RowBox[{
            RowBox[{"h", "=", 
             RowBox[{"Graph", "[", 
              RowBox[{"vertices", ",", 
               RowBox[{"UndirectedEdge", "@@@", 
                RowBox[{"Pick", "[", 
                 RowBox[{
                  RowBox[{"model", "[", "\"\<Pairs\>\"", "]"}], ",", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Extract", "[", 
                    RowBox[{
                    RowBox[{"model", "[", "\"\<Weights\>\"", "]"}], ",", 
                    "#"}], "]"}], ">=", "minimum"}], "&"}], "/@", 
                    RowBox[{"model", "[", "\"\<PairIndices\>\"", "]"}]}], 
                   ")"}]}], "]"}]}]}], "]"}]}], ";", 
            RowBox[{"components", "=", 
             RowBox[{"ConnectedComponents", "[", "h", "]"}]}], ";", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<MinimumWeight\>\"", "->", "minimum"}], ",", 
              RowBox[{"\"\<Edges\>\"", "->", 
               RowBox[{"EdgeCount", "[", "h", "]"}]}], ",", 
              RowBox[{"\"\<Isolates\>\"", "->", 
               RowBox[{"Count", "[", 
                RowBox[{
                 RowBox[{"VertexDegree", "[", "h", "]"}], ",", "0"}], "]"}]}],
               ",", 
              RowBox[{"\"\<Components\>\"", "->", 
               RowBox[{"Length", "[", "components", "]"}]}], ",", 
              RowBox[{"\"\<LargestComponent\>\"", "->", 
               RowBox[{"Max", "[", 
                RowBox[{"Length", "/@", "components"}], "]"}]}]}], "|>"}]}]}],
           "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"minimum", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}], "}"}]}], 
        "]"}]}], ";", 
      RowBox[{"withoutGuitar", "=", 
       RowBox[{"VertexDelete", "[", 
        RowBox[{"g", ",", "\"\<guitar\>\""}], "]"}]}], ";", 
      RowBox[{"guitarIndex", "=", 
       RowBox[{"First", "[", 
        RowBox[{"FirstPosition", "[", 
         RowBox[{"vertices", ",", "\"\<guitar\>\""}], "]"}], "]"}]}], ";", 
      RowBox[{"deletion", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", "b", ",", "values", ",", "ranks", ",", "ties"}],
             "}"}], ",", 
           RowBox[{
            RowBox[{"m", "=", 
             RowBox[{"accompaNetModel", "[", 
              RowBox[{
               RowBox[{"Delete", "[", 
                RowBox[{"rows", ",", "i"}], "]"}], ",", "vertices"}], "]"}]}],
             ";", 
            RowBox[{"values", "=", 
             RowBox[{"accompaNetMetrics", "[", 
              RowBox[{"m", ",", "measureNames"}], "]"}]}], ";", 
            RowBox[{"b", "=", 
             RowBox[{"values", "[", "\"\<Betweenness\>\"", "]"}]}], ";", 
            RowBox[{"ranks", "=", 
             RowBox[{"AssociationMap", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"1", "+", 
                 RowBox[{"Count", "[", 
                  RowBox[{
                   RowBox[{"values", "[", "#", "]"}], ",", 
                   RowBox[{"v_", "/;", 
                    RowBox[{"v", ">", 
                    RowBox[{
                    RowBox[{"values", "[", "#", "]"}], "[", 
                    RowBox[{"[", "guitarIndex", "]"}], "]"}]}]}]}], "]"}]}], 
                "&"}], ",", "measureNames"}], "]"}]}], ";", 
            RowBox[{"ties", "=", 
             RowBox[{"Association", "@", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"name", "->", 
                 RowBox[{"Select", "[", 
                  RowBox[{
                   RowBox[{"DeleteCases", "[", 
                    RowBox[{
                    RowBox[{"Range", "[", "k", "]"}], ",", "guitarIndex"}], 
                    "]"}], ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"values", "[", "name", "]"}], "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "==", 
                    RowBox[{
                    RowBox[{"values", "[", "name", "]"}], "[", 
                    RowBox[{"[", "guitarIndex", "]"}], "]"}]}], "&"}]}], 
                  "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"name", ",", "measureNames"}], "}"}]}], "]"}]}]}], ";", 
            RowBox[{"ties", "=", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"vertices", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "&"}], ",", "ties"}], 
              "]"}]}], ";", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<RemovedConfiguration\>\"", "->", 
               RowBox[{"rowIDs", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<RemovedFrequency\>\"", "->", 
               RowBox[{"frequencies", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<Edges\>\"", "->", 
               RowBox[{"EdgeCount", "[", 
                RowBox[{"m", "[", "\"\<BinaryGraph\>\"", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<Components\>\"", "->", 
               RowBox[{"Length", "[", 
                RowBox[{"ConnectedComponents", "[", 
                 RowBox[{"m", "[", "\"\<BinaryGraph\>\"", "]"}], "]"}], 
                "]"}]}], ",", 
              RowBox[{"\"\<GuitarRanks\>\"", "->", "ranks"}], ",", 
              RowBox[{"\"\<GuitarTies\>\"", "->", "ties"}], ",", 
              RowBox[{"\"\<ExactBetweennessMatchesNative\>\"", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Max", "[", 
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"N", "[", "b", "]"}], "-", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"BetweennessCentrality", "[", 
                    RowBox[{"m", "[", "\"\<BinaryGraph\>\"", "]"}], "]"}], "/", 
                    RowBox[{"Binomial", "[", 
                    RowBox[{
                    RowBox[{"k", "-", "1"}], ",", "2"}], "]"}]}], "]"}]}], 
                   "]"}], "]"}], "<", 
                 RowBox[{"10", "^", 
                  RowBox[{"-", "12"}]}]}], ")"}]}]}], "|>"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "rows", "]"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"allFirst", "=", 
       RowBox[{"And", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Values", "[", 
               RowBox[{"#", "[", "\"\<GuitarRanks\>\"", "]"}], "]"}], "===", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"1", ",", "5"}], "]"}]}], "&&", 
             RowBox[{"AllTrue", "[", 
              RowBox[{
               RowBox[{"Values", "[", 
                RowBox[{"#", "[", "\"\<GuitarTies\>\"", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"#", "===", 
                 RowBox[{"{", "}"}]}], "&"}]}], "]"}]}], ")"}], "&"}], "/@", 
          "deletion"}], ")"}]}]}], ";", 
      RowBox[{"allNative", "=", 
       RowBox[{"And", "@@", 
        RowBox[{"Lookup", "[", 
         RowBox[{"deletion", ",", "\"\<ExactBetweennessMatchesNative\>\""}], 
         "]"}]}]}], ";", 
      RowBox[{"pairWeight", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"pairs", ",", "\"\<Frequency\>\""}], "]"}], "]"}]}], ";", 
      RowBox[{"connectedTriples", "=", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Binomial", "[", 
           RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", "degree"}], "]"}]}], ";", 
      RowBox[{"summary", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Recordings\>\"", "->", 
          RowBox[{"Total", "[", "frequencies", "]"}]}], ",", 
         RowBox[{"\"\<Configurations\>\"", "->", 
          RowBox[{"Length", "[", "rows", "]"}]}], ",", 
         RowBox[{"\"\<PresenceSets\>\"", "->", 
          RowBox[{"Length", "[", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"model", "[", "\"\<Sets\>\"", "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Categories\>\"", "->", "k"}], ",", 
         RowBox[{"\"\<CategoryAppearances\>\"", "->", 
          RowBox[{"frequencies", ".", "sizes"}]}], ",", 
         RowBox[{"\"\<CategoryEntries\>\"", "->", 
          RowBox[{"Total", "[", 
           RowBox[{"frequencies", 
            RowBox[{"(", 
             RowBox[{"Length", "/@", 
              RowBox[{"rows", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ")"}]}], "]"}]}], ",", 
         RowBox[{"\"\<Edges\>\"", "->", 
          RowBox[{"EdgeCount", "[", "g", "]"}]}], ",", 
         RowBox[{"\"\<PairWeight\>\"", "->", "pairWeight"}], ",", 
         RowBox[{"\"\<Density\>\"", "->", 
          RowBox[{
           RowBox[{"EdgeCount", "[", "g", "]"}], "/", 
           RowBox[{"Binomial", "[", 
            RowBox[{"k", ",", "2"}], "]"}]}]}], ",", 
         RowBox[{"\"\<Components\>\"", "->", 
          RowBox[{"Length", "[", 
           RowBox[{"ConnectedComponents", "[", "g", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<Diameter\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ConnectedGraphQ", "[", "g", "]"}], ",", 
            RowBox[{"Max", "[", "distances", "]"}], ",", 
            RowBox[{"Missing", "[", "\"\<Disconnected\>\"", "]"}]}], "]"}]}], 
         ",", 
         RowBox[{"\"\<MeanPathLength\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ConnectedGraphQ", "[", "g", "]"}], ",", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{"Flatten", "[", "distances", "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"k", 
               RowBox[{"(", 
                RowBox[{"k", "-", "1"}], ")"}]}], ")"}]}], ",", 
            RowBox[{"Missing", "[", "\"\<Disconnected\>\"", "]"}]}], "]"}]}], 
         ",", 
         RowBox[{"\"\<Transitivity\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"connectedTriples", ">", "0"}], ",", 
            RowBox[{"3", 
             RowBox[{
              RowBox[{"Length", "[", "triangles", "]"}], "/", 
              "connectedTriples"}]}], ",", "0"}], "]"}]}], ",", 
         RowBox[{"\"\<MeanLocalClustering\>\"", "->", 
          RowBox[{"Mean", "[", "clustering", "]"}]}], ",", 
         RowBox[{"\"\<Triangles\>\"", "->", 
          RowBox[{"Length", "[", "triangles", "]"}]}], ",", 
         RowBox[{"\"\<SupportedTriangles\>\"", "->", 
          RowBox[{"Length", "[", "observed", "]"}]}], ",", 
         RowBox[{"\"\<UnsupportedTriangles\>\"", "->", 
          RowBox[{"Length", "[", "unsupported", "]"}]}], ",", 
         RowBox[{"\"\<UnsupportedTriangleFraction\>\"", "->", 
          RowBox[{
           RowBox[{"Length", "[", "unsupported", "]"}], "/", 
           RowBox[{"Length", "[", "triangles", "]"}]}]}], ",", 
         RowBox[{"\"\<SingleOccurrenceEdges\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"pairs", ",", "\"\<Frequency\>\""}], "]"}], ",", "1"}], 
           "]"}]}], ",", 
         RowBox[{"\"\<ConfigurationDeletionScenarios\>\"", "->", 
          RowBox[{"Length", "[", "deletion", "]"}]}], ",", 
         RowBox[{"\"\<GuitarStrictlyFirstInAllScenarios\>\"", "->", 
          "allFirst"}]}], "|>"}]}], ";", 
      RowBox[{"checks", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<EmbeddedDataTotals\>\"", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"summary", ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Recordings\>\"", ",", "\"\<Configurations\>\"", 
                ",", "\"\<PresenceSets\>\"", ",", "\"\<Categories\>\""}], 
               "}"}]}], "]"}], "===", 
            RowBox[{"{", 
             RowBox[{"100", ",", "60", ",", "59", ",", "30"}], "}"}]}], 
           ")"}]}], ",", 
         RowBox[{"\"\<AuthorConfirmedGuitarFrequencies\>\"", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rows", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", "24", ",", "60"}], "}"}], ",", "2"}], "]"}],
              "]"}], "===", 
            RowBox[{"{", 
             RowBox[{"18", ",", "1", ",", "1"}], "}"}]}], ")"}]}], ",", 
         RowBox[{"\"\<MultiplicityRetained\>\"", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"rows", "[", 
             RowBox[{"[", 
              RowBox[{"24", ",", "1"}], "]"}], "]"}], "===", 
            RowBox[{"{", 
             RowBox[{"\"\<guitar\>\"", ",", "\"\<guitar\>\""}], "}"}]}], 
           ")"}]}], ",", 
         RowBox[{"\"\<IncidenceMatchesNotebook\>\"", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"model", "[", "\"\<Incidence\>\"", "]"}], "===", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Boole", "[", 
               RowBox[{"MemberQ", "[", 
                RowBox[{
                 RowBox[{"row", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", "v"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"row", ",", "rows"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"v", ",", "vertices"}], "}"}]}], "]"}]}], ")"}]}], ",", 
         RowBox[{"\"\<PrevalenceMatchesNotebook\>\"", "->", 
          RowBox[{"(", 
           RowBox[{"prevalence", "===", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"accompaNetSupport", "[", 
                RowBox[{"{", "#", "}"}], "]"}], "&"}], "/@", "vertices"}], 
             ")"}]}], ")"}]}], ",", 
         RowBox[{"\"\<SingleLabelMatchesNotebook\>\"", "->", 
          RowBox[{"(", 
           RowBox[{"single", "===", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Cases", "[", 
                RowBox[{"rows", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"s_", ",", "f_"}], "}"}], "/;", 
                   RowBox[{
                    RowBox[{"DeleteDuplicates", "[", "s", "]"}], "===", 
                    RowBox[{"{", "v", "}"}]}]}], ":>", "f"}]}], "]"}], "]"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"v", ",", "vertices"}], "}"}]}], "]"}]}], ")"}]}], ",", 
         RowBox[{"\"\<DegreeMatchesNotebook\>\"", "->", 
          RowBox[{"(", 
           RowBox[{"degree", "===", 
            RowBox[{"VertexDegree", "[", "g", "]"}]}], ")"}]}], ",", 
         RowBox[{"\"\<StrengthMatchesNotebook\>\"", "->", 
          RowBox[{"(", 
           RowBox[{"strength", "===", 
            RowBox[{"Normal", "[", 
             RowBox[{"Total", "[", 
              RowBox[{"WeightedAdjacencyMatrix", "[", 
               RowBox[{"model", "[", "\"\<Graph\>\"", "]"}], "]"}], "]"}], 
             "]"}]}], ")"}]}], ",", 
         RowBox[{"\"\<FractionalStrengthMatchesNotebook\>\"", "->", 
          RowBox[{"(", 
           RowBox[{"fractional", "===", 
            RowBox[{"Total", "[", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"#2", ">", "1"}], ",", 
                  RowBox[{"#1", "#3"}], ",", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"0", ",", "k"}], "]"}]}], "]"}], "&"}], ",", 
               RowBox[{"{", 
                RowBox[{"frequencies", ",", "sizes", ",", 
                 RowBox[{"model", "[", "\"\<Incidence\>\"", "]"}]}], "}"}]}], 
              "]"}], "]"}]}], ")"}]}], ",", 
         RowBox[{"\"\<EveryPairWeightMatchesNotebook\>\"", "->", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"pairs", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"accompaNetSupport", "[", 
               RowBox[{"#", "[", "\"\<Categories\>\"", "]"}], "]"}], "===", 
              RowBox[{"#", "[", "\"\<Frequency\>\"", "]"}]}], "&"}]}], 
