Cell[TextData[{
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "7cbcedec-5115-da4e-b995-5fe6ec50d8c0"],
 " : Observed assay-1 result\n",
 Cell[BoxData[
  FormBox["D", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "15fec865-528f-a846-b5b7-364262eb1a77"],
 " : Latent class\n",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "10abcac7-4dda-164a-a131-7145f974618b"],
 " : Class index (0 or 1)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "(", "x", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"a7d096cb-b971-8f4c-acc8-4b69f3e7cfee"],
 " : Posterior probability of latent class 1\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", "p", "(", "x", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e509588c-8e73-6440-9b76-0e3c0dd93557"],
 " : Posterior probability of latent class 0\n",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "737aabc2-7c93-e441-8a82-dbdf8c3777ae"],
 " : Class-1 probability conditional on the latent new-test value and model \
parameters\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", 
    StyleBox["parameter",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f571d918-b66e-8d46-b2ac-18ad8f1630ec"],
 " : Parameter standard uncertainty\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", 
    StyleBox["measurement",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "b2b8cb94-9cf1-1a40-9246-9c0a5fcbdae5"],
 " : New-result measurement standard uncertainty\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", 
    StyleBox["Q",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "33b8411f-821b-1146-b0bf-13b21d8708d6"],
 " : Total standard uncertainty\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["CV", 
    StyleBox["j",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "fc66d898-dd0a-9446-986b-47155b93ff6d"],
 " : Fixed analytical coefficient of variation for assay j, expressed as a \
fraction\n",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6864e8d4-072d-4e46-8d43-089569e8b1e6"],
 " : Analytical-error covariance matrix\n",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6a77136f-8346-ef4d-a8c7-f516af16e689"],
 " : Model parameters\n",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "81f6a53e-03e2-3441-854c-d2b32d76c712"],
 " : Number of training observations\n",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "13ad5b79-3b12-7048-a6c1-032e794067d1"],
 " : Number of retained posterior draws\nMCMC settings : Iterations, burn-in, \
thinning, and seed\nImportance ESS : Effective sample size after \
predictive-likelihood weighting\nCredible level : Posterior probability mass \
of the credible interval\nParameter interval : Credible interval for \
probability averaged over latent new-test uncertainty\nTotal-Q interval : \
Credible interval for conditional probability across posterior parameter and \
latent new-test draws\n",
 Cell[BoxData[
  FormBox["y", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "593c3e50-7818-1d4b-9052-3db711402bcc"],
 " : Observed log assay-1 result, log x\n",
 Cell[BoxData[
  FormBox["Y", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "e23691a1-e6ab-4940-9af1-f0d5dba6cd73"],
 " : Observed log-measurement vector\n",
 Cell[BoxData[
  FormBox["Z", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dbc47d5b-a2f8-f341-83c2-11ccfdf19d7b"],
 " : Latent log-measurement vector\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalSigma]", 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "682d5cd7-35a8-844e-883c-33a7ab7a3931"],
 " : Latent class covariance matrix\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["T", 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "deac31a9-d8b9-fa42-ae8e-21806a005c99"],
 " : Observed class covariance matrix\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f54903f1-9b73-f640-ad47-39c2be19a8bf"],
 " : Class mean vector\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Pi]", 
    StyleBox["d",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0fda3717-f659-4542-a20c-895b5bbd3da3"],
 " : Class proportion\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", 
    StyleBox["jj",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "9e822fc2-f691-eb4d-a1ff-93867b158fd9"],
 " : Analytical log-error variance for assay j\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", 
    StyleBox["ds",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d5d714ee-7a09-a54d-b834-d249269c196f"],
 " : Marginal density of log assay 1 for class d at draw s\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", 
    StyleBox["s",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "d319dc92-7806-f54a-81c2-32426ab05cf8"],
 " : Class-weighted predictive density of log assay 1 at draw s\nfit : Prefix \
of the fitted model's SHA-256 fingerprint\n",
 Cell[BoxData[
