Cell[BoxData[
 DynamicModuleBox[{panel$$, loading$$, message$$, initialized$$, expanded$$, 
  loadDefinitions$$}, 
  TagBox[GridBox[{
     {
      TemplateBox[{
        PaneSelectorBox[{
         False -> ButtonBox[
           "\"Start analysis\"", Appearance -> Automatic, ButtonFunction :> If[
              Not[
               TrueQ[loading$$]], loading$$ = True; 
              message$$ = "Loading the calculator..."; panel$$ = CheckAbort[
                 If[
                  loadDefinitions$$[], 
                  Module[{calculator = BDPUOpenCalculator[]}, 
                   If[
                    MatchQ[calculator, 
                    Blank[DynamicModule]], 
                    
                    With[{ageFit = bduAgeDefaultFit, baseFit = 
                    nfBayesDefaultFit}, 
                    Block[{bduAgeDefaultFit, nfBayesDefaultFit}, 
                    RawBoxes[
                    ToBoxes[
                    Replace[
                    calculator, {
                    HoldPattern[ageFit] :> bduAgeDefaultFit, 
                    HoldPattern[baseFit] :> nfBayesDefaultFit}, {3}], 
                    StandardForm]]]], $Failed]], $Failed], $Aborted]; 
              message$$ = 
               Switch[panel$$, $Aborted, 
                 "Loading was interrupted. Select Start analysis to retry.", \
$Failed, "The calculator could not load. Select Start analysis to retry.", 
                 Blank[], ""]; loading$$ = False], Enabled -> Dynamic[
              Not[
               TrueQ[loading$$]], TrackedSymbols :> {loading$$}], Evaluator -> 
            Automatic, Method -> "Queued"], True -> ButtonBox[
            DynamicBox[
             ToBoxes[
              If[
               TrueQ[expanded$$], "Hide calculator", "Show calculator"], 
              StandardForm], 
             ImageSizeCache -> {83.326171875, {0.140625, 8.8828125}}, 
             TrackedSymbols :> {expanded$$}], Appearance -> Automatic, 
            ButtonFunction :> (expanded$$ = Not[
               TrueQ[expanded$$]]), Evaluator -> Automatic, Method -> 
            "Preemptive"]}, 
         Dynamic[
          MatchQ[panel$$, 
           Blank[RawBoxes]], TrackedSymbols :> {panel$$}]], 
        TemplateBox[{12}, "Spacer1"], 
        ButtonBox["\"Load functions for examples\"", ButtonFunction :> If[
           Not[
            TrueQ[loading$$]], loading$$ = True; 
           message$$ = "Loading functions..."; message$$ = If[
              TrueQ[
               CheckAbort[
                loadDefinitions$$[], False]], 
              "Functions are ready. Select an example input cell and press \
Shift+Enter.", 
              "Functions could not load. Select Load functions for examples \
to retry."]; loading$$ = False], Enabled -> Dynamic[
           Not[
            TrueQ[loading$$]], TrackedSymbols :> {loading$$}], Method -> 
         "Queued", Appearance -> Automatic, Evaluator -> Automatic]},
       "RowDefault"]},
     {
      DynamicBox[ToBoxes[
        If[
         Or[
          Not[
           StringQ[message$$]], message$$ === ""], 
         Spacer[{0, 0}], message$$], StandardForm],
       ImageSizeCache->{0., {0., 0.}},
       SynchronousUpdating->False,
       TrackedSymbols:>{message$$}]},
     {
      PaneBox[
       DynamicBox[ToBoxes[
         If[
          MatchQ[panel$$, 
           Blank[RawBoxes]], panel$$, 
          Spacer[{0, 0}]], StandardForm],
        ImageSizeCache->{0., {0., 0.}},
        SynchronousUpdating->False,
        TrackedSymbols:>{panel$$}],
       ImageSize->Dynamic[
         If[
          TrueQ[expanded$$], Automatic, {0, 0}], 
         TrackedSymbols :> {expanded$$}],
       ScrollPosition->{0., 0.},
       Scrollbars->False]}
    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
    GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{0.45}}}],
   "Column"],
  DynamicModuleValues:>{},
  Initialization:>(panel$$ = None; loading$$ = False; message$$ = ""; 
   initialized$$ = False; expanded$$ = True; loadDefinitions$$[] := If[
      And[
       TrueQ[initialized$$], DownValues[BDPUOpenCalculator] =!= {}, 
       DownValues[BDPUReferenceAudit] =!= {}], True, 
      Module[{book$, cells$}, book$ = Quiet[
          Check[
           Get[
            NotebookFileName[
             EvaluationNotebook[]]], $Failed]]; If[Head[book$] =!= Notebook, 
         Return[False]]; cells$ = Cases[
          First[book$], Condition[
            Pattern[c, 
             Cell[
              Blank[BoxData], "Input", 
              Pattern[opts, 
               BlankNullSequence[]]]], 
            MemberQ[{opts}, InitializationCell -> True]] :> c, Infinity]; 
       initialized$$ = And[Length[cells$] === 6, 
          Check[Scan[
             Function[c, 
              ToExpression[
               Part[c, 1, 1], StandardForm]], cells$]; 
           And[DownValues[BDPUOpenCalculator] =!= {}, 
             DownValues[BDPUReferenceAudit] =!= {}], False]]]]),
  SynchronousInitialization->True,
  UnsavedVariables:>{
   panel$$, loading$$, message$$, initialized$$, expanded$$, 
    loadDefinitions$$}]], "Output",
 GeneratedCell->False,
 CellTags->"BDPUStart",ExpressionUUID->"adf39feb-dcd8-6444-afa7-7d4f34124fea"],

Cell[CellGroupData[{

Cell["Run the reference example", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
