                     -0.11430364727876371, AutoDelete -> True], NumberForm[#1, {8, 2}] & ], "\" to \"", 
                   TagBox[InterpretationBox[StyleBox["\"1.08\"", ShowStringCharacters -> False], 
                     1.079531465553546, AutoDelete -> True], NumberForm[#1, {8, 2}] & ], "\")\""}, 
                  "RowDefault"]}, {"\"Calibration slope\"", TemplateBox[{TagBox[InterpretationBox[
                     StyleBox["\"1.25\"", ShowStringCharacters -> False], 1.2533094339927675, 
                     AutoDelete -> True], NumberForm[#1, {8, 2}] & ], "\" (\"", TagBox[InterpretationBox[
                     StyleBox["\"0.85\"", ShowStringCharacters -> False], 0.8499946773294594, 
                     AutoDelete -> True], NumberForm[#1, {8, 2}] & ], "\" to \"", TagBox[
                    InterpretationBox[StyleBox["\"1.97\"", ShowStringCharacters -> False], 
                     1.9749969591368703, AutoDelete -> True], NumberForm[#1, {8, 2}] & ], "\")\""}, 
                  "RowDefault"], TemplateBox[{TagBox[InterpretationBox[StyleBox["\"1.43\"", 
                      ShowStringCharacters -> False], 1.4345914730438583, AutoDelete -> True], 
                    NumberForm[#1, {8, 2}] & ], "\" (\"", TagBox[InterpretationBox[StyleBox["\"1.01\"", 
                      ShowStringCharacters -> False], 1.0135287029473894, AutoDelete -> True], 
                    NumberForm[#1, {8, 2}] & ], "\" to \"", TagBox[InterpretationBox[StyleBox[
                      "\"2.26\"", ShowStringCharacters -> False], 2.260158742237093, AutoDelete -> 
                      True], NumberForm[#1, {8, 2}] & ], "\")\""}, "RowDefault"]}, {"\"Brier score\"", 
                 TemplateBox[{TagBox[InterpretationBox[StyleBox["\"0.03044\"", ShowStringCharacters -> 
                       False], 0.030436611900673236, AutoDelete -> True], NumberForm[#1, {8, 5}] & ], 
                   "\" (\"", TagBox[InterpretationBox[StyleBox["\"0.01539\"", ShowStringCharacters -> 
                       False], 0.015388677680783185, AutoDelete -> True], NumberForm[#1, {8, 5}] & ], 
                   "\" to \"", TagBox[InterpretationBox[StyleBox["\"0.04729\"", ShowStringCharacters -> 
                       False], 0.04728656567247656, AutoDelete -> True], NumberForm[#1, {8, 5}] & ], 
                   "\")\""}, "RowDefault"], TemplateBox[{TagBox[InterpretationBox[StyleBox[
                      "\"0.03088\"", ShowStringCharacters -> False], 0.030877171944399862, AutoDelete -> 
                      True], NumberForm[#1, {8, 5}] & ], "\" (\"", TagBox[InterpretationBox[
                     StyleBox["\"0.01561\"", ShowStringCharacters -> False], 0.01560898066081379, 
                     AutoDelete -> True], NumberForm[#1, {8, 5}] & ], "\" to \"", TagBox[
                    InterpretationBox[StyleBox["\"0.04848\"", ShowStringCharacters -> False], 
                     0.04848495222263935, AutoDelete -> True], NumberForm[#1, {8, 5}] & ], "\")\""}, 
                  "RowDefault"]}, {"\"Logarithmic loss\"", TemplateBox[{TagBox[InterpretationBox[
                     StyleBox["\"0.12057\"", ShowStringCharacters -> False], 0.12056608300161856, 
                     AutoDelete -> True], NumberForm[#1, {8, 5}] & ], "\" (\"", TagBox[InterpretationBox[
                     StyleBox["\"0.06614\"", ShowStringCharacters -> False], 0.06613980255739828, 
                     AutoDelete -> True], NumberForm[#1, {8, 5}] & ], "\" to \"", TagBox[
                    InterpretationBox[StyleBox["\"0.18220\"", ShowStringCharacters -> False], 
                     0.18219963664290162, AutoDelete -> True], NumberForm[#1, {8, 5}] & ], "\")\""}, 
                  "RowDefault"], TemplateBox[{TagBox[InterpretationBox[StyleBox["\"0.11531\"", 
                      ShowStringCharacters -> False], 0.1153146463738815, AutoDelete -> True], 
                    NumberForm[#1, {8, 5}] & ], "\" (\"", TagBox[InterpretationBox[StyleBox[
                      "\"0.06381\"", ShowStringCharacters -> False], 0.06380667221788258, AutoDelete -> 
                      True], NumberForm[#1, {8, 5}] & ], "\" to \"", TagBox[InterpretationBox[
                     StyleBox["\"0.17436\"", ShowStringCharacters -> False], 0.17435927226860753, 
                     AutoDelete -> True], NumberForm[#1, {8, 5}] & ], "\")\""}, "RowDefault"]}, 
                {"\"AUROC\"", TemplateBox[{TagBox[InterpretationBox[StyleBox["\"0.8617\"", 
                      ShowStringCharacters -> False], 0.8617300131061599, AutoDelete -> True], 
                    NumberForm[#1, {8, 4}] & ], "\" (\"", TagBox[InterpretationBox[StyleBox[
                      "\"0.7226\"", ShowStringCharacters -> False], 0.7226456522685167, AutoDelete -> 
                      True], NumberForm[#1, {8, 4}] & ], "\" to \"", TagBox[InterpretationBox[
                     StyleBox["\"0.9732\"", ShowStringCharacters -> False], 0.9732212903000139, 
                     AutoDelete -> True], NumberForm[#1, {8, 4}] & ], "\")\""}, "RowDefault"], 
                 TemplateBox[{TagBox[InterpretationBox[StyleBox["\"0.9198\"", ShowStringCharacters -> 
                       False], 0.919833988641328, AutoDelete -> True], NumberForm[#1, {8, 4}] & ], 
                   "\" (\"", TagBox[InterpretationBox[StyleBox["\"0.8532\"", ShowStringCharacters -> 
                       False], 0.8531867306624874, AutoDelete -> True], NumberForm[#1, {8, 4}] & ], 
                   "\" to \"", TagBox[InterpretationBox[StyleBox["\"0.9737\"", ShowStringCharacters -> 
                       False], 0.9737358471744226, AutoDelete -> True], NumberForm[#1, {8, 4}] & ], 
                   "\")\""}, "RowDefault"]}}, AutoDelete -> False, BaseStyle -> 
                {FontFamily -> "Source Sans Pro", FontSize -> 12, FontWeight -> Plain}, 
               GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxBackground -> {"Columns" -> {{None}}, 
                 "Rows" -> {RGBColor[0.92, 0.96, 1.], {GrayLevel[1]}}}, GridBoxFrame -> 
                {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxItemSize -> 
                {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, GridBoxSpacings -> 
                {"Columns" -> {{1.2}}, "Rows" -> {{0.7}}}, FrameStyle -> RGBColor[0., 0.35, 1.], 
               GridBoxItemStyle -> {"Rows" -> {Directive[FontWeight -> Plain], {Directive[FontWeight -> 
                      Plain]}}}], "Grid"]], "Output", CellTags -> "BDPUHoldoutTable20261018", 
            ExpressionUUID -> "4bd072ed-16ee-9246-9e6f-29d23abb01d1"],

Cell["Mean predicted \
probabilities of measured-reference positivity were 0.0295 without age and 0.0255 with age. Observed \
positivity was 4.11%. Observed/expected event ratios were 1.39 and 1.61. Calibration intercepts use \
logit(prediction) as an offset and have ideal value zero; slopes are estimated with a free intercept and \
have ideal value one. Both models underpredicted the observed positive frequency, with greater \
underprediction after adding age. The Brier score and logarithmic loss are overall prediction scores, \
while AUROC describes discrimination; none is a calibration-only measure.", "Text", 
            ExpressionUUID -> "b05a9207-2f17-1a47-9d82-65a6a8170508"],

Cell["Paired differences (age \
minus no age): Brier score 0.00044 (95% CI -0.00198 to 0.00361); absolute mean calibration error 0.00392 \
(-0.00370 to 0.00691); logarithmic loss -0.00525 (-0.01923 to 0.00864); AUROC 0.0581 (-0.0165 to \
0.1543). The age-free constant training-fraction comparator has Brier score 0.03937. The comparison does \
not establish superiority or equivalence. Higher AUROC and lower logarithmic loss for the age model \
remain descriptive.", "Text", ExpressionUUID -> "3458aa46-5677-7446-907a-f1eca1a36f57"],

Cell["The exploratory analysis plan preceded the new age predictions. Confidence intervals \
use 5,000 ordinary paired participant bootstrap resamples (seed 20261018) with the same resampled \
participants for both models; no calibration fits failed. Intervals are conditional on the saved fits \
and exclude model-training and survey-design uncertainty. This selected-cohort, unweighted, same-cycle \
internal comparison contains only 14 positives. It does not establish external calibration, age-subgroup \
calibration, latent-endpoint validity, interval coverage or clinical benefit.", "Text", 
            ExpressionUUID -> "046e9254-8614-3740-b77f-c3d8245b3d7d"],

Cell["Calibration definitions: \
Van Calster B, McLernon DJ, van Smeden M, Wynants L, Steyerberg EW. Calibration: the Achilles heel of \
predictive analytics. BMC Medicine. 2019;17:230. doi:10.1186/s12916-019-1466-7. Computational \
consistency checks are distinct from independent clinical validation.", "Text", 
            ExpressionUUID -> "b42936e3-8502-734e-b78c-56f9db337561"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Callable functions and worked examples", "Section",
 FontSize->24,
 FontColor->RGBColor[0.8, 0.043137254901960784`, 0.00784313725490196],
 CellTags->"Fitting",ExpressionUUID->"1916b00f-4ce3-ce42-9546-9617aeb98db9"],

Cell["\<\
In Use the calculator, select Load functions for examples or Start analysis. \
Then select an input cell and press Shift+Enter. Each example below can run \
independently using this notebook's embedded data.\
\>", "Text",ExpressionUUID->"91fa443b-bdb5-f942-89d9-99b4d6bb1fc1"],

Cell[CellGroupData[{

Cell["Callable functions", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"06e69bd6-b292-d34f-8e05-\
84bf86c4d794"],

Cell[TextData[{
 StyleBox["BDPUOpenCalculator[]", "InlineCode"],
 "   ",
 "Open the updated calculator with the embedded baseline and age fits. Use \
BayesianDiagnosticHarmonizedInterface[ageFit, baselineFit] to supply your own \
fitted models."
}], "Text",ExpressionUUID->"567a42ee-9047-9848-ae80-2c84c2000800"],

Cell[TextData[{
 StyleBox["BayesianDiseaseProbability[fit, x, options]", "InlineCode"],
 "   ",
 "Evaluate a single observed test result. Set \"ReferenceThreshold\" in the \
reference measurement's units and \"CredibleLevel\" as a fraction. A \
successful call returns an association on the 0 to 1 scale. See the \
executable example under NHANES reference example."
}], "Text",ExpressionUUID->"ea91457b-9987-9f44-b753-c68750a7d8e7"],

Cell[TextData[{
 StyleBox["BayesianAgeDiseaseProbability[jointFit, x, age, options]", 
  "InlineCode"],
 "   ",
 "Evaluate at an age in years within the training range. For several \
measurements at the same age, obtain conditioned = \
BayesianAgeConditionFit[jointFit, age], then call \
BayesianAgeDiseaseProbability[conditioned, x, options]."
}], "Text",ExpressionUUID->"17239b7e-8d62-8a41-898a-3f273addfd4f"],

Cell[TextData[{
 StyleBox["BayesianDiseaseFit[rows, options]   /   \
BayesianAgeDiseaseFit[rows, options]", "InlineCode"],
 "   ",
 "Create a posterior from two measurement columns or from those columns plus \
age. Options[BayesianDiseaseFit] and Options[BayesianAgeDiseaseFit] list \
component, analytical CV, prior and sampler settings."
}], "Text",ExpressionUUID->"4961fe85-66e3-e64f-8957-41079e39e17c"],

Cell[TextData[{
 StyleBox["BayesianSimulateMeasurements[settings]", "InlineCode"],
 "   ",
 "Generate class-specific measurements under the specified distributions, \
sample sizes, prevalence and seed."
}], "Text",ExpressionUUID->"f05c0cd2-be2f-644c-b39b-14d6726b75dd"],

Cell[TextData[{
 StyleBox["BayesianSimulationBootstrap[run, replicates, seed, level]", 
  "InlineCode"],
 "   ",
 "Fit the two class distributions and generate bootstrap replicates. Supply \
the confidence level as a fraction."
}], "Text",ExpressionUUID->"0edc1323-0afb-b74f-9f91-44a722fdfadf"],

Cell[TextData[{
 StyleBox["BayesianSimulationUncertainty[bootstrap, x, level]", "InlineCode"],
 "   ",
 "Return the generating and fitted probabilities, standard uncertainties and \
pointwise intervals at x. Omitting level uses the confidence level stored \
with the bootstrap."
}], "Text",ExpressionUUID->"5b71c82f-52c4-a946-916b-e1c3ae7bcd59"],

Cell[TextData[{
 StyleBox["AgeSimulationSettings[settings, age, anchor, diseaseSlope, \
nondiseaseSlope, logitSlope]", "InlineCode"],
 "   ",
 "Apply fixed changes per decade in each class mean and in the log odds of \
prevalence relative to the anchor age. Pass the returned scenario settings to \
BayesianSimulateMeasurements."
}], "Text",ExpressionUUID->"a9deb466-2346-7b4d-986e-585f02bbbfd9"],

Cell[TextData[{
 StyleBox["BayesianSimulationUncertaintyCurve[bootstrap, values, level]", 
  "InlineCode"],
 "   ",
 "Evaluate several observed values using the same bootstrap replicates. \
BayesianSimulationPlotGrid[bootstrap, lo, hi] supplies a grid that includes \
distribution support boundaries where applicable."
}], "Text",ExpressionUUID->"ee60136e-a267-bb49-a6fc-00123af2d41f"]
}, Closed]],

Cell[CellGroupData[{

Cell["Condition a probability on age", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"af411ef5-900f-6c4a-969d-\
39d8f33648e7"],

Cell["\<\
Estimate the probability of latent OGTT at or above 200 mg/dL for FPG 126 \
mg/dL at age 50. The saved random inputs reproduce the calculator's total-Q \
draws for its reference age fit.\
\>", "Text",ExpressionUUID->"31dce056-0499-6d49-977e-c65838d1292d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"KeyTake", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"BayesianAgeDiseaseProbability", "[", 
    RowBox[{
    "bduAgeDefaultFit", ",", " ", "126.", ",", " ", "50.", ",", "\n", "    ", 
     RowBox[{"\"\<ReferenceThreshold\>\"", " ", "->", " ", "200."}], ",", " ", 
     RowBox[{"\"\<CredibleLevel\>\"", " ", "->", " ", "0.95"}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<RandomTape\>\"", " ", "->", " ", "bduAgePredictionTape"}]}],
     "]"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"\"\<Probability\>\"", ",", 
     " ", "\"\<ParameterCredibleInterval\>\"", ",", 
     " ", "\"\<TotalQCredibleInterval\>\""}], "}"}]}], "\n", "]"}]], "Input",
 CellTags->{"BDPUWorkedExample", "BDPUAgeExample"},
 CellLabel->
  "In[234]:=",ExpressionUUID->"30e9f306-11f6-644d-9de8-a0fe440df9ea"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Probability\"\>", "\[Rule]", "0.13658467481346492`"}], ",", 
   RowBox[{"\<\"ParameterCredibleInterval\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.08304594921996426`", ",", "0.20914903199774465`"}], "}"}]}], ",", 
   RowBox[{"\<\"TotalQCredibleInterval\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.07754584459045111`", ",", "0.23025962368049158`"}], "}"}]}]}],
   "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.004060153217602*^9, 4.004356310157696*^9},
 CellTags->{"BDPUWorkedExample", "BDPUAgeExample"},
 CellLabel->
  "Out[234]=",ExpressionUUID->"9f0522be-7c3b-144d-9f90-a5344d849db7"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Fit a new model and predict", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"92f4286c-db3c-be47-94b4-\
238cd3722499"],

Cell["\<\
The log-measurement model requires two positive, continuous measurements. \
Categorical or negative-valued tests require a different likelihood. This \
short one-component chain uses 36 embedded training rows. Replace the rows \
with Import[path, \"CSV\"] for a header-free numeric file containing \
predictor and reference measurements, in that order. The age fit also needs a \
third column of varying ages in years. Both fitting functions require at \
least ten complete rows.\
\>", "Text",ExpressionUUID->"04f9dc28-61d4-3b49-a175-0243a633cc37"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rows", " ", "=", " ", 
      RowBox[{"Take", "[", 
       RowBox[{"nfBayesTrainingData", ",", " ", "36"}], "]"}]}], ",", " ", 
     "fit", ",", " ", "result"}], "}"}], ",", "\n", "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Use", " ", "the", " ", "same", " ", "fitted", " ", "draws", " ", "for", " ",
      "subsequent", " ", 
     RowBox[{"predictions", "."}]}], " ", "*)"}], "\n", "  ", 
   RowBox[{
    RowBox[{"fit", " ", "=", " ", 
     RowBox[{"BayesianDiseaseFit", "[", 
      RowBox[{"rows", ",", " ", 
       RowBox[{"\"\<Components\>\"", " ", "->", " ", "1"}], ",", "\n", "    ", 
       RowBox[{"\"\<AnalyticalCV\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0.013", ",", " ", "0.010"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<Iterations\>\"", " ", "->", " ", "120"}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<BurnIn\>\"", " ", "->", " ", "40"}], ",", " ", 
       RowBox[{"\"\<Thin\>\"", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "5101"}]}], "]"}]}], ";", "\n",
     "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"AssociationQ", "[", "fit", "]"}]}], ",", " ", 
      RowBox[{"Return", "[", "fit", "]"}]}], "]"}], ";", "\n", "  ", 
    RowBox[{"result", " ", "=", " ", 
     RowBox[{"BayesianDiseaseProbability", "[", 
      RowBox[{"fit", ",", " ", "112.", ",", " ", 
       RowBox[{"\"\<ReferenceThreshold\>\"", " ", "->", " ", "200."}]}], 
      "]"}]}], ";", "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"AssociationQ", "[", "result", "]"}]}], ",", " ", 
      RowBox[{"Return", "[", "result", "]"}]}], "]"}], ";", "\n", "  ", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{"fit", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<TrainingCount\>\"", ",", " ", "\"\<Components\>\""}], 
         "}"}]}], "]"}], ",", "\n", "    ", 
      RowBox[{"KeyTake", "[", 
       RowBox[{"result", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<ObservedResult\>\"", ",", " ", "\"\<Probability\>\"", ",",
           " ", "\"\<DrawCount\>\""}], "}"}]}], "]"}]}], "]"}]}]}], "\n", 
  "]"}]], "Input",
 CellTags->{"BDPUWorkedExample", "BDPURefitExample"},
 CellLabel->
  "In[235]:=",ExpressionUUID->"a8f75f20-6c3e-e643-88eb-7324d646515c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"TrainingCount\"\>", "\[Rule]", "36"}], ",", 
   RowBox[{"\<\"Components\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"ObservedResult\"\>", "\[Rule]", "112.`"}], ",", 
   RowBox[{"\<\"Probability\"\>", "\[Rule]", "0.0725121452880714`"}], ",", 
   RowBox[{"\<\"DrawCount\"\>", "\[Rule]", "40"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0040601533884583`*^9, 4.0043563103170147`*^9},
 CellTags->{"BDPUWorkedExample", "BDPURefitExample"},
 CellLabel->
  "Out[235]=",ExpressionUUID->"7d4adb2b-df3c-4847-8d41-17b90eec4bb1"]
}, Open  ]],

Cell["\<\
The example retains 40 draws to demonstrate the calls. An analysis for \
inference requires longer independent chains, convergence checks on \
label-invariant predictions, and posterior predictive checks. Set analytical \
CVs and prior hyperparameters for your assays and population. Refit when \
these assumptions, the training data or the component count change.\
\>", "Text",ExpressionUUID->"41887fc1-4324-9746-b713-29ea160cca64"]
}, Closed]],

Cell[CellGroupData[{

Cell["Generate and bootstrap a simulation", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"8660c213-49a8-a74a-852a-\
cdf5e5381c0d"],

Cell["\<\
Specify the two class distributions and the population prevalence, then \
generate measurements, bootstrap the fitted distributions and evaluate a test \
result. The two seeds control generation and resampling independently. The DF \
fields are required by the settings format and are used for Student t \
distributions.\
\>", "Text",ExpressionUUID->"6217e5c8-56a6-5848-82ab-0f2aaec0cb14"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "settings", ",", " ", "run", ",", " ", "bootstrap", ",", " ", "result"}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"settings", " ", "=", " ", 
     RowBox[{"<|", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<DiseaseFamily\>\"", " ", "->", " ", "\"\<Normal\>\""}], ",",
        " ", 
       RowBox[{"\"\<DiseaseMean\>\"", " ", "->", " ", "130."}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<DiseaseSD\>\"", " ", "->", " ", "20."}], ",", " ", 
       RowBox[{"\"\<DiseaseDF\>\"", " ", "->", " ", "5"}], ",", "\n", "    ", 
       RowBox[{"\"\<NondiseaseFamily\>\"", " ", "->", " ", "\"\<Normal\>\""}],
        ",", " ", 
       RowBox[{"\"\<NondiseaseMean\>\"", " ", "->", " ", "100."}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<NondiseaseSD\>\"", " ", "->", " ", "15."}], ",", " ", 
       RowBox[{"\"\<NondiseaseDF\>\"", " ", "->", " ", "5"}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<Prevalence\>\"", " ", "->", " ", "0.10"}], ",", " ", 
       RowBox[{"\"\<DiseaseCount\>\"", " ", "->", " ", "100"}], ",", "\n", 
       "    ", 
       RowBox[{"\"\<NondiseaseCount\>\"", " ", "->", " ", "100"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "20261010"}]}], "|>"}]}], ";", 
    "\n", "  ", 
    RowBox[{"run", " ", "=", " ", 
     RowBox[{"BayesianSimulateMeasurements", "[", "settings", "]"}]}], ";", 
    "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"AssociationQ", "[", "run", "]"}]}], ",", " ", 
      RowBox[{"Return", "[", "run", "]"}]}], "]"}], ";", "\n", "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Resample", " ", "the", " ", "fitted", " ", "class", " ", 
      "distributions", " ", "at", " ", "fixed", " ", 
      RowBox[{"prevalence", "."}]}], " ", "*)"}], "\n", "  ", 
    RowBox[{"bootstrap", " ", "=", " ", 
     RowBox[{"BayesianSimulationBootstrap", "[", 
      RowBox[{
      "run", ",", " ", "120", ",", " ", "20261011", ",", " ", "0.95"}], 
      "]"}]}], ";", "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"AssociationQ", "[", "bootstrap", "]"}]}], ",", " ", 
      RowBox[{"Return", "[", "bootstrap", "]"}]}], "]"}], ";", "\n", "  ", 
    RowBox[{"result", " ", "=", " ", 
     RowBox[{"BayesianSimulationUncertainty", "[", 
      RowBox[{"bootstrap", ",", " ", "126."}], "]"}]}], ";", "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"AssociationQ", "[", "result", "]"}]}], ",", " ", 
      RowBox[{"Return", "[", "result", "]"}]}], "]"}], ";", "\n", "  ", 
    RowBox[{"KeyTake", "[", 
     RowBox[{"result", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<GeneratingDiseaseProbability\>\"", ",", 
        " ", "\"\<DiseaseProbability\>\"", ",", "\n", 
        "    ", "\"\<DiseaseInterval\>\"", ",", 
        " ", "\"\<NondiseaseProbability\>\"", ",", 
        " ", "\"\<NondiseaseInterval\>\"", ",", "\n", 
        "    ", "\"\<ValidReplicates\>\"", ",", " ", "\"\<Status\>\""}], 
       "}"}]}], "]"}]}]}], "\n", "]"}]], "Input",
 CellTags->{"BDPUWorkedExample", "BDPUSimulationExample"},
 CellLabel->
  "In[236]:=",ExpressionUUID->"3a900ccb-4331-f546-b869-3480435fcfb0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"GeneratingDiseaseProbability\"\>", "\[Rule]", 
    "0.2684139583576063640531052095012141571774866468613762096374`38.\
05348099758715"}], ",", 
   RowBox[{"\<\"DiseaseProbability\"\>", "\[Rule]", 
    "0.2519990597464953472003949512320388491244749652026616126666`38.\
02902279110882"}], ",", 
   RowBox[{"\<\"DiseaseInterval\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.18831701453543365`", ",", "0.41162880745015207`"}], "}"}]}], ",", 
   RowBox[{"\<\"NondiseaseProbability\"\>", "\[Rule]", 
    "0.7480009402535046527996050487679611508755250347973383873334`37.\
91838058268559"}], ",", 
   RowBox[{"\<\"NondiseaseInterval\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.5883711925498479`", ",", "0.8116829854645664`"}], "}"}]}], ",", 
   RowBox[{"\<\"ValidReplicates\"\>", "\[Rule]", "120"}], ",", 
   RowBox[{"\<\"Status\"\>", "\[Rule]", "\<\"Complete\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.00406015354607*^9, 4.0043563104701805`*^9},
 CellTags->{"BDPUWorkedExample", "BDPUSimulationExample"},
 CellLabel->
  "Out[236]=",ExpressionUUID->"cf4ffe89-b2a9-244f-a92c-0eb4e8449e16"]
}, Open  ]],

Cell["\<\
GeneratingDiseaseProbability uses the specified distributions. \
DiseaseProbability uses the distributions fitted to the generated \
measurements. DiseaseInterval gives a pointwise percentile bootstrap \
confidence interval. The implementation reports an interval only when every \
replicate gives a valid probability at this value and at least 100 replicates \
succeed.\
\>", "Text",ExpressionUUID->"0a32a47f-9107-1a40-bf44-4ccdd6512de1"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reproducibility and numerical checks", "Section",
 FontSize->24,
 CellTags->"Checks",ExpressionUUID->"a1214d7f-c4f0-a542-a897-c795facb0ade"],

Cell["Source documentation: NHANES OGTT_H, DEMO_H, and DIQ_H codebooks at \
https://wwwn.cdc.gov/Nchs/Data/Nhanes/Public/2013/DataFiles/OGTT_H.htm and the corresponding demographic \
and diabetes questionnaire files. Analytical CV assumptions follow the 2013-2014 fasting-glucose \
quality-control tables. Embedded reference data and posterior draws support the default Wolfram \
calculations. New model fits and simulation results should be exported with their settings and seeds. \
Archived holdout confidence intervals are reported results and are not regenerated by the native \
consistency checks.", "Text", ExpressionUUID -> "860d0b1a-95ce-ea47-a6fc-21edffb5a3fd"],

Cell["Version 1.0.0 evaluates the conditional mean analytically and integrates centered \
second moments with a 32-node rule, a higher-order comparison, and adaptive integration when required. \
Invalid moments return an explicit failure. Zero-weight draws are excluded from weighted interval \
interpolation. These numerical safeguards do not establish model adequacy.", "Text", 
            ExpressionUUID -> "53e97a7b-a972-ad42-a09f-327d5b42dd4b"],

Cell["After loading the embedded \
functions, evaluate BDPUReferenceAudit[] below. It checks the reference probability at FPG 126 mg/dL, \
the variance decomposition, interval ordering, probability bounds and embedded sample sizes. The \
archived held-out comparison used separate participant-level ages and a paired bootstrap. Those holdout \
ages are unavailable in the embedded data.", "Text", ExpressionUUID -> 
             "68607c56-3103-924f-90b5-9d8d8b07bd46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"audit", "=", 
     RowBox[{"BDPUReferenceAudit", "[", "]"}]}], "}"}], ",", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"AssociationQ", "[", "audit", "]"}], ",", 
     TagBox[GridBox[{
        {
         RowBox[{"audit", "[", "\"\<Status\>\"", "]"}]},
        {
         RowBox[{"Dataset", "[", 
          RowBox[{
           RowBox[{"audit", "[", "\"\<Checks\>\"", "]"}], ",", 
           RowBox[{"HeaderStyle", "\[Rule]", 
            RowBox[{"Directive", "[", 
             RowBox[{"FontWeight", "\[Rule]", "Plain"}], "]"}]}], ",", 
           RowBox[{"ItemStyle", "\[Rule]", 
            RowBox[{"Directive", "[", 
             RowBox[{"FontWeight", "\[Rule]", "Plain"}], "]"}]}]}], "]"}]}
       },
       DefaultBaseStyle->"Column",
       GridBoxAlignment->{"Columns" -> {{Left}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
      "Column"], ",", "audit"}], "]"}]}], "]"}]], "Input",
 CellLabel->
  "In[237]:=",ExpressionUUID->"44a7b027-f925-0040-aa19-d7af8b3703e7"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Passed\"\>"},
    {
     TagBox[
      TagBox[
       DynamicModuleBox[{TypeSystem`NestedGrid`PackagePrivate`$state$$ = <|
        "InitialData" -> {<|
           "Check" -> "Release", "Value" -> "1.0.0", "Passed" -> True|>, <|
           "Check" -> "Two-dimensional reference draws", "Value" -> 6000, 
            "Passed" -> True|>, <|
           "Check" -> "Age-model reference draws", "Value" -> 6000, "Passed" -> 
            True|>, <|
           "Check" -> "Training rows", "Value" -> 1361, "Passed" -> True|>, <|
           "Check" -> "Held-out rows", "Value" -> 341, "Passed" -> True|>, <|
           "Check" -> "Probability at 126 mg/dL", "Value" -> 
            0.2227819404198289, "Passed" -> True|>, <|
           "Check" -> "Variance decomposition residual", "Value" -> 0., 
            "Passed" -> True|>, <|
           "Check" -> "Probability variance bound", "Value" -> 
            0.0020685621013765035`, "Passed" -> True|>, <|
           "Check" -> "Ordered probability intervals", 
            "Value" -> {{0.16798219292634473`, 0.28596404593212893`}, {
             0.14434133516634032`, 0.320423029766826}}, "Passed" -> True|>}, 
         "AllowEmbedding" -> True, "InitialShape" -> 
         TypeSystem`PackageScope`HeaderShape[<|{All, "Check"} -> 
            1, {All, "Value"} -> 1, {All, "Passed"} -> 1|>, 
           TypeSystem`PackageScope`Limited[
            TypeSystem`PackageScope`ColumnShape[
             TypeSystem`PackageScope`Limited[
              
              TypeSystem`PackageScope`RowShape[<|
               "Check" -> 
                TypeSystem`PackageScope`AtomShape[347.20000000000005`], 
                "Value" -> TypeSystem`PackageScope`UnknownShape[False], 
                "Passed" -> TypeSystem`PackageScope`AtomShape[36]|>], 
              DirectedInfinity[1], 3, {All}]], 9, 
            DirectedInfinity[1], {}]], "InitialType" -> TypeSystem`Vector[
           TypeSystem`Struct[{"Check", "Value", "Passed"}, {
             TypeSystem`Atom[String], TypeSystem`AnyType, 
             TypeSystem`Atom[TypeSystem`Boolean]}], 9], 
         "Meta" -> <|
          HeaderStyle -> Directive[FontWeight -> Plain], ItemStyle -> 
           Directive[FontWeight -> Plain]|>, "RowTarget" -> 20, 
         "ColumnTarget" -> 10, "Shape" -> 
         TypeSystem`PackageScope`HeaderShape[<|{All, "Check"} -> 
            1, {All, "Value"} -> 1, {All, "Passed"} -> 1|>, 
           TypeSystem`PackageScope`Limited[
