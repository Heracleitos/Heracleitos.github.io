nfBayesLatentQ[s_, f_, r_, cut_] := Module[{pi = s[\\\"weights\\\"], m = s[\\\
\"means\\\"], \\n            t = s[\\\"total_covariances\\\"], sig, lw, w, \
gmean, gvar}, sig = (#1 - r & ) /@ t; \\n            lw = MapThread[Log[#1] + \
