Reverse[r[\\\"TotalQCredibleInterval\\\"]]]; \\n     Column[{Row[{\\\"Latent \
reference endpoint: \\\", bduAgeAppliedLabel[applied, \\\"ReferenceLabel\\\", \
\\\"Reference\\\"], \\n         \\\" \[GreaterEqual] \\\", \
r[\\\"ReferenceThreshold\\\"], \\\" \\\", bduAgeAppliedLabel[applied, \
\\\"MeasurementUnit\\\", \\n          \\\"original scale\\\"], \
If[TrueQ[applied[\\\"AgeEnabled\\\"]], Row[{\\\"; age \\\", applied[\\\"Age\\\
\"], \\n            \\\" years\\\"}], \\\"\\\"]}], \
bduHTable[Prepend[({#1[[1]], bduHFormat[#1[[2]], digits]} & ) /@ \\n          \
{{\\\"Observed result\\\", r[\\\"ObservedResult\\\"]}, {\\\"Reference \
threshold\\\", \\n            r[\\\"ReferenceThreshold\\\"]}, {\\\"Interval \
level\\\", applied[\\\"Level\\\"]}, \\n           {\\\"Posterior \
probability\\\", p}, {\\\"Total standard uncertainty\\\", \
r[\\\"TotalSD\\\"]}, \\n           {If[selectedBand === \
\\\"TotalQCredibleInterval\\\", \\\"Total-Q credible interval\\\", \\n        \
     \\\"Parameter credible interval\\\"], If[selectedBand === \
\\\"TotalQCredibleInterval\\\", qi, \\n             ci]}}, {\\\"Quantity\\\", \
\\\"Result\\\"}]], Row[{100*applied[\\\"Level\\\"], \\n         \\\"% \
pointwise credible intervals\\\"}], OpenerView[{\\\"Detailed uncertainty and \
diagnostics\\\", \\n         nfBayesDisplayResult[r, disease, digits]}, \
False]}, \\n      BaseStyle -> {FontFamily -> \\\"Source Sans Pro\\\", 12}]]; \
, \\n bduHSimulationSummary[applied_, disease_, digits_] := \\n   Module[{r = \
applied[\\\"Result\\\"], key = If[TrueQ[disease], \\\"Disease\\\", \
\\\"Nondisease\\\"], p, sd, ci}, \\n    p = Lookup[r, StringJoin[key, \
\\\"Probability\\\"], Missing[\\\"Undefined\\\"]]; \\n     sd = Lookup[r, \
StringJoin[key, \\\"StandardUncertainty\\\"], Missing[\\\"Undefined\\\"]]; \
\\n     ci = Lookup[r, StringJoin[key, \\\"Interval\\\"], \
Missing[\\\"Undefined\\\"]]; \\n     Column[{\\\"Sample-fitted probability \
and known generating probability\\\", \\n       bduHTable[Prepend[({#1[[1]], \
bduHFormat[#1[[2]], digits]} & ) /@ \\n          {{\\\"Sample-fitted \
probability\\\", p}, {\\\"Known generating probability\\\", \\n            \
Lookup[r, StringJoin[\\\"Generating\\\", key, \\\"Probability\\\"], \
Missing[\\\"Undefined\\\"]]}, \\n           {\\\"Bootstrap sampling standard \
uncertainty\\\", sd}, {\\\"Pointwise percentile interval\\\", ci}}, \\n       \
  {\\\"Quantity\\\", \\\"Result\\\"}]], Row[{100*r[\\\"ConfidenceLevel\\\"], \
\\n         \\\"% pointwise bootstrap confidence interval; \\\", r[\\\"Status\
\\\"]}], \\n       Lookup[r, \\\"StatusMessage\\\", \\\"\\\"], OpenerView[{\\\
\"Detailed uncertainty and diagnostics\\\", \\n         \
bduHTable[Prepend[({#1[[1]], bduHFormat[#1[[2]], digits]} & ) /@ \\n          \
  {{\\\"Evaluated measurement value\\\", r[\\\"ObservedResult\\\"]}, \
{\\\"Applied age\\\", \\n              If[TrueQ[applied[\\\"AgeEnabled\\\"]], \
applied[\\\"Age\\\"], \\\"not used\\\"]}, \\n             {\\\"Relative \
standard uncertainty\\\", If[bduAgeRealQ[p] && p > 0 && bduAgeRealQ[sd], \
sd/\\n                p, Missing[\\\"Undefined\\\"]]}, {\\\"Valid bootstrap \
replicates\\\", r[\\\"ValidReplicates\\\"]}, \\n             {\\\"Total \
bootstrap replicates\\\", r[\\\"TotalReplicates\\\"]}}, {\\\"Quantity\\\", \\\
\"Result\\\"}]]}, \\n        False]}, BaseStyle -> {FontFamily -> \\\"Source \
Sans Pro\\\", 12}]]; ]]\>\""}], ";", 
   RowBox[{"ToExpression", "[", "bduHCompleteSource", "]"}], ";"}]}]], "Input",
 InitializationCell->True,
