Cell["Age conditioning and simulation", "Subsubsection",ExpressionUUID->"450fdae9-f35b-fe49-a385-13a0f3b9903a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "harmonized", " ", "source", " ", "includes", " ", "the", " ",
      "age", " ", "model"}], ",", " ", 
    RowBox[{
    "recorded", " ", "random", " ", "inputs", " ", "and", " ", "simulation", " ",
      "methods", " ", "so", " ", "exported", " ", "calculators", " ", "can", " ",
      "initialize", " ", 
     RowBox[{"independently", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
   "bduHCompleteSource", 
    "=", "\"\<ReleaseHold[HoldComplete[Null, ClearAll[bduHFailureText, \
bduHAgeNumberText, bduHAgeRangeText, \\n   bduHAgeRangeFailure, \
bduHAgeGridFailure]; , \\n bduHFailureText[f_Failure] := Module[{data = \
f[[2]], template, parameters, message}, \\n    template = Lookup[data, \
\\\"MessageTemplate\\\", \\n       \\\"The calculation could not be \
completed. Check the inputs and try again.\\\"]; \\n     parameters = \
Lookup[data, \\\"MessageParameters\\\", {}]; \\n     message = \
If[StringQ[template], Quiet[Check[TemplateApply[template, parameters], \
template]], \\n       $Failed]; If[StringQ[message], message, \\n      \
\\\"The calculation could not be completed. Check the inputs and try again.\\\
\"]]; , \\n bduHFailureText[$Aborted] := \\n   \\\"The calculation was \
interrupted. Try again with fewer age subdivisions.\\\"; , \\n \
bduHFailureText[$Failed] := \\n   \\\"The calculation could not be completed. \
Check the inputs and try again.\\\"; , \\n bduHFailureText[s_String] := s; , \
\\n bduHFailureText[_] := \\\"The calculation could not be completed. Check \
the inputs and try again.\\\"; , \\n bduHAgeNumberText[x_] := \
ToString[If[NumberQ[x] && TrueQ[x == Round[x]], Round[x], x], OutputForm]; , \
\\n bduHAgeRangeText[fit_Association] := Module[{range = Lookup[fit, \
\\\"AgeRange\\\", {}]}, \\n    If[MatchQ[range, {_?bduAgeRealQ, \
_?bduAgeRealQ}], StringJoin[\\\"Supported ages: \\\", \\n      \
bduHAgeNumberText[First[range]], \\\" to \\\", \
bduHAgeNumberText[Last[range]], \\n      \\\" years (observed training \
range).\\\"], \\n     \\\"The fitted model has no valid observed age range.\\\
\"]]; , \\n bduHAgeRangeFailure[fit_Association, ages_List] := \\n   \
Module[{range = fit[\\\"AgeRange\\\"], requested = MinMax[ages], label}, \\n  \
  label = If[First[requested] == Last[requested], StringJoin[\\\"Requested \
age \\\", \\n        bduHAgeNumberText[First[requested]]], \
StringJoin[\\\"Requested ages \\\", \\n        \
bduHAgeNumberText[First[requested]], \\\" to \\\", \
bduHAgeNumberText[Last[requested]]]]; \\n     Failure[\\\"AgeRange\\\", \
Association[\\\"MessageTemplate\\\" -> StringJoin[label, \\n         \
If[First[requested] == Last[requested], \\\" is\\\", \\\" are\\\"], \\n       \
  \\\" outside the supported range. Choose ages from \\\", \
bduHAgeNumberText[First[range]], \\n         \\\" to \\\", \
bduHAgeNumberText[Last[range]], \\\" years. Extrapolation is disabled.\\\"], \
\\n       \\\"RequestedAgeRange\\\" -> requested, \\\"ObservedAgeRange\\\" -> \
range]]]; , \\n bduHAgeGridFailure[fit_Association, ages_List] := \
Module[{range = Lookup[fit, \\\"AgeRange\\\", {}]}, \\n    If[ !MatchQ[range, \
{_?bduAgeRealQ, _?bduAgeRealQ}] ||  !TrueQ[First[range] < Last[range]], \\n   \
   Return[Failure[\\\"Posterior\\\", Association[\\\"MessageTemplate\\\" -> \
\\n          \\\"The fitted model has no valid observed age range.\\\"]]]]; \
\\n     If[TrueQ[First[range] <= Min[ages] && Max[ages] <= Last[range]], \
None, \\n      bduHAgeRangeFailure[fit, ages]]]; , Null, \\n \
ReleaseHold[HoldComplete[ClearAll[nfBayesCV, nfBayesLogPDF, \
nfBayesLogPDFVector, nfBayesNormalize, \\n      nfBayesCovDraw, \
nfBayesHermite, nfBayesLatentQ, nfBayesOne, nfBayesWeightedQuantile, \\n      \
nfBayesOneFast, nfBayesDisplayResult, nfBayesCurve, nfBayesProbabilityPlot, \
\\n      nfBayesUncertaintyPlot, nfBayesDensityPlot]; , Null, \\n    \
ClearAll[BayesianDiseaseFit, BayesianDiseaseProbability, \
BayesianDiseaseInterface]; , Null, \\n    nfBayesCV = {0.013320978779277787, \
0.010230462910635745}; , Null, \\n    Options[BayesianDiseaseFit] = \
{\\\"Components\\\" -> 2, \\\"Iterations\\\" -> 6500, \\\"BurnIn\\\" -> 2000, \
\\n       \\\"Thin\\\" -> 3, \\\"Seed\\\" -> 4101, \\\"AnalyticalCV\\\" -> \
Automatic, \\\"PriorMean\\\" -> Log[{100., 110.}], \\n       \\\"PriorKappa\\\
\" -> 0.1, \\\"PriorNu\\\" -> 4., \\\"PriorScale\\\" -> DiagonalMatrix[{0.04, \
0.25}]}; , Null, \\n    nfBayesLogPDF[z_, m_, t_] := -Log[2*Pi] - \
Log[Det[t]]/2 - (z - m) . Inverse[t] . (z - m)/2; , \\n    Null, \
nfBayesLogPDFVector[z_, m_, t_] := Module[{d = (#1 - m & ) /@ z, inv = \
Inverse[t]}, \\n       -Log[2*Pi] - Log[Det[t]]/2 - MapThread[Dot, {d, d . \
inv}]/2]; , Null, \\n    nfBayesNormalize[v_] := With[{a = Exp[v - Max[v]]}, \
a/Total[a]]; , Null, \\n    nfBayesCovDraw[z_, r_, m0_, k0_, nu0_, p0_] := \
Module[{n = Length[z], bar, kn, mn, pn, t, \\n        tries = 0}, bar = If[n \
> 0, Mean[z], m0]; kn = k0 + n; mn = (k0*m0 + n*bar)/kn; \\n        pn = p0 + \
If[n > 0, Total[(Outer[Times, #1 - bar, #1 - bar] & ) /@ z], \\n           \
ConstantArray[0., {2, 2}]] + k0*(n/kn)*Outer[Times, bar - m0, bar - m0]; \\n  \
      While[True, t = RandomVariate[InverseWishartMatrixDistribution[nu0 + n, \
pn]]; \\n          If[Min[Eigenvalues[t - r]] > 10^(-10), Break[]]; tries++; \
If[tries > 10000, \\n           Return[$Failed]]]; \
{RandomVariate[MultinormalDistribution[mn, t/kn]], t}]; , Null, \\n    \
BayesianDiseaseFit[(data_)?MatrixQ, OptionsPattern[]] := \\n      Module[{z, \
k, it, burn, thin, cv, r, m0, k0, nu0, p0, n, labels, pi, pars, prob, saved, \
\\n        fail = False}, If[Dimensions[data][[2]] != 2 || Length[data] < 10 \
|| \\n           !MatrixQ[data, NumericQ] || Min[data] <= 0, \
Return[Failure[\\\"Data\\\", \\n           \
Association[\\\"MessageTemplate\\\" -> \\n             \\\"A positive numeric \
n by 2 matrix with n >= 10 is required.\\\"]]]]; \\n        {k, it, burn, \
thin} = {OptionValue[\\\"Components\\\"], OptionValue[\\\"Iterations\\\"], \
\\n          OptionValue[\\\"BurnIn\\\"], OptionValue[\\\"Thin\\\"]}; If[ \
!MemberQ[{1, 2}, k] || \\n           !And @@ IntegerQ /@ {it, burn, thin} || \
burn < 0 || it <= burn || thin < 1, \\n         Return[$Failed]]; cv = \
Replace[OptionValue[\\\"AnalyticalCV\\\"], Automatic :> nfBayesCV]; \\n       \
 If[Length[cv] != 2 ||  !VectorQ[cv, NumericQ] || Min[cv] < 0, \
Return[$Failed]]; \\n        r = DiagonalMatrix[Log[1 + cv^2]]; z = \
Log[N[data]]; n = Length[z]; \\n        {m0, k0, nu0, p0} = \
{OptionValue[\\\"PriorMean\\\"], OptionValue[\\\"PriorKappa\\\"], \\n         \
 OptionValue[\\\"PriorNu\\\"], OptionValue[\\\"PriorScale\\\"]}; \\n        \
If[k0 <= 0 || nu0 <= 1 || Min[Eigenvalues[p0]] <= 0, Return[$Failed]]; \\n    \
    BlockRandom[SeedRandom[OptionValue[\\\"Seed\\\"]]; labels = If[k == 1, \
ConstantArray[1, n], \\n            (If[#1[[1]] > Quantile[z[[All,1]], 0.8], \
2, 1] & ) /@ z]; \\n          saved = Reap[Do[pars = \
Table[nfBayesCovDraw[Pick[z, labels, j], r, m0, k0, nu0, p0], \\n             \
    {j, k}]; If[MemberQ[pars, $Failed], fail = True; Break[]]; pi = If[k == \
1, {1.}, \\n                 With[{gam = \
Table[RandomVariate[GammaDistribution[Count[labels, j] + 1., 1.]], \\n        \
             {j, k}]}, gam/Total[gam]]]; prob = nfBayesNormalize /@ \
Transpose[\\n                  Table[Log[pi[[j]]] + nfBayesLogPDFVector[z, \
pars[[j,1]], pars[[j,2]]], {j, k}]]; \\n               labels = \
Table[RandomChoice[prob[[h]] -> Range[k]], {h, n}]; If[i > burn && \\n        \
         Mod[i - burn - 1, thin] == 0, Sow[Association[\\\"weights\\\" -> pi, \
\\\"means\\\" -> \\n                   pars[[All,1]], \\\"total_covariances\\\
\" -> pars[[All,2]]]]], {i, it}]][[2]]]; \\n        If[fail || saved == {}, \
Return[$Failed]]; Association[\\\"Samples\\\" -> First[saved], \\n         \\\
\"AnalyticalCV\\\" -> cv, \\\"TrainingCount\\\" -> n, \\\"LikelihoodScope\\\" \
-> \\\"iid selected cohort\\\", \\n         \\\"Components\\\" -> k, \
\\\"Iterations\\\" -> it, \\\"BurnIn\\\" -> burn, \\\"Thin\\\" -> thin, \\n   \
      \\\"Seed\\\" -> OptionValue[\\\"Seed\\\"], \\\"Prior\\\" -> \
Association[\\\"Mean\\\" -> m0, \\\"Kappa\\\" -> k0, \\n           \\\"Nu\\\" \
-> nu0, \\\"Scale\\\" -> p0, \\\"DirichletAlpha\\\" -> ConstantArray[1., \
k]]]]; , Null, \\n    nfBayesHermite[n_] := nfBayesHermite[n] = Module[{jac, \
vals, vec}, \\n        jac = DiagonalMatrix[Sqrt[N[Range[n - 1]]], 1] + \
DiagonalMatrix[Sqrt[N[Range[n - 1]]], -1]; \\n         {vals, vec} = \
Eigensystem[jac]; Transpose[{vals, vec[[All,1]]^2}]]; , Null, \\n    \
nfBayesLatentQ[s_, f_, r_, cut_] := Module[{pi = s[\\\"weights\\\"], m = s[\\\
\"means\\\"], \\n        t = s[\\\"total_covariances\\\"], sig, lw, w, gmean, \
gvar}, sig = (#1 - r & ) /@ t; \\n        lw = MapThread[Log[#1] + \
Log[PDF[NormalDistribution[#2[[1]], Sqrt[#3[[1,1]]]], f]] & , \\n          \
{pi, m, sig}]; w = nfBayesNormalize[lw]; \\n        gmean = MapThread[#1[[2]] \
+ (#2[[2,1]]/#2[[1,1]])*(f - #1[[1]]) & , {m, sig}]; \\n        gvar = \
(#1[[2,2]] - #1[[2,1]]^2/#1[[1,1]] & ) /@ sig; \\n        \
Total[MapThread[#1*(1 - CDF[NormalDistribution[#2, Sqrt[#3]], cut]) & , \\n   \
       {w, gmean, gvar}]]]; , Null, nfBayesOne[s_, y_, r_, cut_, nodes_] := \
\\n      Module[{pi = s[\\\"weights\\\"], m = s[\\\"means\\\"], t = \
s[\\\"total_covariances\\\"], sig, lw, w, gm, gv, \\n        fm, fv, q, gh = \
nfBayesHermite[nodes], mean, second, fs, comp}, \\n       sig = (#1 - r & ) \
/@ t; lw = MapThread[Log[#1] + Log[PDF[NormalDistribution[#2[[1]], Sqrt[\\n   \
             #3[[1,1]]]], y]] & , {pi, m, t}]; w = nfBayesNormalize[lw]; \\n  \
      gm = MapThread[#1[[2]] + (#2[[2,1]]/#3[[1,1]])*(y - #1[[1]]) & , {m, \
sig, t}]; \\n        gv = MapThread[#1[[2,2]] - #1[[2,1]]^2/#2[[1,1]] & , \
{sig, t}]; \\n        mean = Total[MapThread[#1*(1 - \
CDF[NormalDistribution[#2, Sqrt[#3]], cut]) & , \\n           {w, gm, gv}]]; \
fm = MapThread[#1[[1]] + (#2[[1,1]]/#3[[1,1]])*(y - #1[[1]]) & , \\n          \
{m, sig, t}]; fv = MapThread[#1[[1,1]]*(r[[1,1]]/#2[[1,1]]) & , {sig, t}]; \
\\n        second = \
Total[Table[w[[j]]*Total[Table[gh[[a,2]]*nfBayesLatentQ[s, fm[[j]] + \\n      \
            Sqrt[fv[[j]]]*gh[[a,1]], r, cut]^2, {a, Length[gh]}]], {j, \
Length[pi]}]]; \\n        comp = RandomChoice[w -> Range[Length[w]]]; \\n     \
   fs = fm[[comp]] + Sqrt[fv[[comp]]]*RandomVariate[NormalDistribution[]]; \
\\n        {mean, Max[0., second - mean^2], nfBayesLatentQ[s, fs, r, cut]}]; \
, Null, \\n    Options[BayesianDiseaseProbability] = \
{\\\"ReferenceThreshold\\\" -> Automatic, \\\"Nodes\\\" -> 32, \\n       \
\\\"CredibleLevel\\\" -> 0.95, \\\"Seed\\\" -> 555}; , Null, \\n    \
nfBayesWeightedQuantile[v_, w_, probs_] := Module[{ord = Ordering[v], vv, ww, \
cum}, \\n       vv = v[[ord]]; ww = w[[ord]]; cum = Accumulate[ww] - ww/2; \
