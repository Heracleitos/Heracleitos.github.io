Cell[CellGroupData[{

Cell["Computational efficiency", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"f7242e47-51a0-a349-9220-\
143184577776"],

Cell["The numerical engine packs compatible \
machine-real arrays, checks them in bulk and evaluates posterior draws in batches. Within a draw, each \
component's quantities that are constant across quadrature nodes are computed once. The reference \
evaluator handles other supported array representations and exceptional numerical cases.", "Text", 
               ExpressionUUID -> "4a5cbb1b-a679-d34a-820f-5b22d54614af"],

Cell["A second request with \
identical applied inputs can reuse the result. Changing only the observed test value requires a new \
point estimate, while the curve for the same fit, threshold, interval level and plot range can be \
reused. Changing the displayed outcome or precision updates the presentation from the applied result.", 
               "Text", ExpressionUUID -> "212c8c77-a472-a341-95a6-65aacc8fd3ac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Native execution and reproducibility", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"3ec7c36e-4bf7-284b-9051-\
a348cd98652b"],

Cell["Local Wolfram \
virtual-machine code evaluates the packed draws. The kernel generates random inputs in draw order before \
dispatch. The result rows follow the same order, including draws that require adaptive integration. \
Fits, numerical inputs and seeds together determine which results are reproducible.", "Text", 
               ExpressionUUID -> "8e24b504-1147-e842-b831-4174d1f8f7ad"],

Cell["The session cache holds \
up to 16 age-conditioned fits and two complete curves. A cache hit requires an exact match of the fitted \
model and calculation settings after hash lookup. Curve keys include the relevant seed and quadrature \
defaults, and the prediction tape when used. The cache stores successful deterministic calculations. \
BDPUCalculationCacheInformation[] reports cache activity and the compiled backend. \
BDPUClearCalculationCache[] or reinitialization clears the cache.", "Text", ExpressionUUID -> 
                "e6e199e1-dcfd-5c43-8ce3-d75b7d2f1aa5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Embedded Wolfram implementation", "Section",
 FontSize->24,
 CellTags->
  "Implementation",ExpressionUUID->"9c96c05b-bdad-a546-a293-bf088ad4d90a"],

Cell[TextData[{"The initialization cells below contain the model code, training and holdout \
measurements, saved posterior draws, simulation methods, calculator and reference checks. Select ", 
              StyleBox["Load functions for examples", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], 
              " to use them in the current kernel or ", StyleBox["Start analysis", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], 
              " to open the calculator. Wolfram's Evaluate Initialization Cells command also loads the \
implementation."}], "Text", ExpressionUUID -> "88eb2a94-2af4-7340-9f5d-d0604e29a0c8"],

Cell[CellGroupData[{

Cell["Probability model and fitting", "Subsubsection",ExpressionUUID->"5abe6d3a-22b3-7144-b25c-034a769b752d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Fit", " ", "the", " ", "mixture", " ", "model", " ", "and", " ", 
    "propagate", " ", "measurement", " ", "error", " ", "through", " ", "its",
     " ", "posterior", " ", 
    RowBox[{"draws", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "nfBayesCV", ",", " ", "nfBayesLogPDF", ",", " ", "nfBayesLogPDFVector", 
      ",", " ", "nfBayesNormalize", ",", " ", "nfBayesCovDraw", ",", " ", 
      "nfBayesHermite", ",", " ", "nfBayesLatentQ", ",", " ", "nfBayesOne", ",",
       " ", "nfBayesWeightedQuantile", ",", " ", "nfBayesOneFast", ",", " ", 
      "nfBayesDisplayResult", ",", " ", "nfBayesCurve", ",", " ", 
      "nfBayesProbabilityPlot", ",", " ", "nfBayesUncertaintyPlot", ",", " ", 
      "nfBayesDensityPlot"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "BayesianDiseaseFit", ",", " ", "BayesianDiseaseProbability", ",", " ", 
      "BayesianDiseaseInterface"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nfBayesCV", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.013320978779277787", ",", " ", "0.010230462910635745"}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "BayesianDiseaseFit", "]"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<Components\>\"", " ", "->", " ", "2"}], ",", " ", 
       RowBox[{"\"\<Iterations\>\"", " ", "->", " ", "6500"}], ",", " ", 
       RowBox[{"\"\<BurnIn\>\"", " ", "->", " ", "2000"}], ",", " ", 
       RowBox[{"\"\<Thin\>\"", " ", "->", " ", "3"}], ",", " ", 
       RowBox[{"\"\<Seed\>\"", " ", "->", " ", "4101"}], ",", " ", 
       RowBox[{"\"\<AnalyticalCV\>\"", " ", "->", " ", "Automatic"}], ",", 
       " ", 
       RowBox[{"\"\<PriorMean\>\"", " ", "->", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"{", 
          RowBox[{"100.", ",", " ", "110."}], "}"}], "]"}]}], ",", " ", 
       RowBox[{"\"\<PriorKappa\>\"", " ", "->", " ", "0.1"}], ",", " ", 
       RowBox[{"\"\<PriorNu\>\"", " ", "->", " ", "4."}], ",", " ", 
       RowBox[{"\"\<PriorScale\>\"", " ", "->", " ", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"{", 
          RowBox[{"0.04", ",", " ", "0.25"}], "}"}], "]"}]}]}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"nfBayesLogPDF", "[", 
      RowBox[{"z_", ",", " ", "m_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Log", "[", 
        RowBox[{"2", " ", "Pi"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{"Det", "[", "t", "]"}], "]"}], " ", "/", " ", "2"}], " ", "-",
       " ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"z", " ", "-", " ", "m"}], ")"}], " ", ".", " ", 
        RowBox[{"Inverse", "[", "t", "]"}], " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{"z", " ", "-", " ", "m"}], ")"}]}], " ", "/", " ", "2"}]}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"nfBayesLogPDFVector", "[", 
      RowBox[{"z_", ",", " ", "m_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#", " ", "-", " ", "m"}], ")"}], "&"}], " ", "/@", " ", 
           "z"}]}], ",", " ", 
         RowBox[{"inv", " ", "=", " ", 
          RowBox[{"Inverse", "[", "t", "]"}]}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Log", "[", 
          RowBox[{"2", " ", "Pi"}], "]"}]}], " ", "-", " ", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"Det", "[", "t", "]"}], "]"}], " ", "/", " ", "2"}], " ", "-",
         " ", 
        RowBox[{
         RowBox[{"MapThread", "[", 
          RowBox[{"Dot", ",", " ", 
           RowBox[{"{", 
            RowBox[{"d", ",", " ", 
             RowBox[{"d", " ", ".", " ", "inv"}]}], "}"}]}], "]"}], " ", "/", 
         " ", "2"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"nfBayesNormalize", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"v", " ", "-", " ", 
           RowBox[{"Max", "[", "v", "]"}]}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"a", " ", "/", " ", 
        RowBox[{"Total", "[", "a", "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"nfBayesCovDraw", "[", 
      RowBox[{
      "z_", ",", " ", "r_", ",", " ", "m0_", ",", " ", "k0_", ",", " ", 
       "nu0_", ",", " ", "p0_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", " ", "=", " ", 
          RowBox[{"Length", "[", "z", "]"}]}], ",", " ", "bar", ",", " ", 
         "kn", ",", " ", "mn", ",", " ", "pn", ",", " ", "t", ",", " ", 
         RowBox[{"tries", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"bar", " ", "=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"n", " ", ">", " ", "0"}], ",", " ", 
           RowBox[{"Mean", "[", "z", "]"}], ",", " ", "m0"}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"kn", " ", "=", " ", 
         RowBox[{"k0", " ", "+", " ", "n"}]}], ";", "\n", "  ", 
        RowBox[{"mn", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k0", " ", "m0"}], " ", "+", " ", 
            RowBox[{"n", " ", "bar"}]}], ")"}], " ", "/", " ", "kn"}]}], ";", 
        "\n", "  ", 
        RowBox[{"pn", " ", "=", " ", 
         RowBox[{"p0", " ", "+", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"n", " ", ">", " ", "0"}], ",", " ", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Outer", "[", 
                RowBox[{"Times", ",", " ", 
                 RowBox[{"#", " ", "-", " ", "bar"}], ",", " ", 
                 RowBox[{"#", " ", "-", " ", "bar"}]}], "]"}], "&"}], " ", "/@",
               " ", "z"}], "]"}], ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"0.", ",", " ", 
              RowBox[{"{", 
               RowBox[{"2", ",", " ", "2"}], "}"}]}], "]"}]}], "]"}], " ", "+",
           " ", 
          RowBox[{"k0", " ", 
           RowBox[{"n", " ", "/", " ", "kn"}], " ", 
           RowBox[{"Outer", "[", 
            RowBox[{"Times", ",", " ", 
             RowBox[{"bar", " ", "-", " ", "m0"}], ",", " ", 
             RowBox[{"bar", " ", "-", " ", "m0"}]}], "]"}]}]}]}], ";", "\n", 
        "  ", 
        RowBox[{"While", "[", 
         RowBox[{"True", ",", " ", 
          RowBox[{
           RowBox[{"t", " ", "=", " ", 
            RowBox[{"RandomVariate", "[", 
             RowBox[{"InverseWishartMatrixDistribution", "[", 
              RowBox[{
               RowBox[{"nu0", " ", "+", " ", "n"}], ",", " ", "pn"}], "]"}], 
             "]"}]}], ";", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Eigenvalues", "[", 
                RowBox[{"t", " ", "-", " ", "r"}], "]"}], "]"}], " ", ">", 
              " ", 
              RowBox[{"10", "^", 
               RowBox[{"-", "10"}]}]}], ",", " ", 
             RowBox[{"Break", "[", "]"}]}], "]"}], ";", " ", 
           RowBox[{"tries", "++"}], ";", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"tries", " ", ">", " ", "10000"}], ",", " ", 
             RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}]}]}], "]"}], ";",
         "\n", "  ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"RandomVariate", "[", 
           RowBox[{"MultinormalDistribution", "[", 
            RowBox[{"mn", ",", " ", 
             RowBox[{"t", " ", "/", " ", "kn"}]}], "]"}], "]"}], ",", " ", 
          "t"}], "}"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BayesianDiseaseFit", "[", 
      RowBox[{
       RowBox[{"data_", "?", "MatrixQ"}], ",", " ", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
