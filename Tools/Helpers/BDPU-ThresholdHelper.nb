                    RowBox[{"path", ",", " ", 
                    RowBox[{"bduHSurfacePlot", "[", 
                    RowBox[{"surface", ",", " ", "disease"}], "]"}], ",", 
                    " ", "\"\<PNG\>\"", ",", " ", 
                    RowBox[{"ImageResolution", " ", "->", " ", "180"}]}], 
                    "]"}]}], "]"}]}]}], "]"}], ",", " ", "\n", "    ", 
                    RowBox[{"Enabled", " ", "->", " ", 
                    RowBox[{"Dynamic", "[", 
                    RowBox[{"AssociationQ", "[", "surface", "]"}], "]"}]}], ",",
                     " ", 
                    RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}]}], 
                    "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", "False"}], 
                    "]"}], ",", "\n", "     ", 
                    RowBox[{"OpenerView", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"\"\<Methods\>\"", ",", " ", 
                    RowBox[{"Pane", "[", 
                    RowBox[{
                    RowBox[{"Column", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"\"\<Age disabled: the unchanged two-dimensional \
Bayesian engine is dispatched directly. Age enabled: conditioning uses the \
joint model of log test, log reference and recorded age, including both \
component and posterior-draw likelihood weights.\>\"", ",", 
                    " ", "\"\<Age profiles independently evaluate the exact \
fixed observed result at each applied age; no surface interpolation is used. \
Separate profile and surface snapshots retain applied settings after controls \
change. Real age extrapolation beyond observed training support is \
disabled.\>\"", ",", 
                    " ", "\"\<Real intervals are pointwise Bayesian credible \
intervals. Simulated intervals are pointwise percentile parametric-bootstrap \
sampling intervals. Family, Student t degrees of freedom, prevalence and \
supplied age effects are fixed. Allocation is not prevalence. No additional \
analytical measurement error is added in simulated mode.\>\"", ",", 
                    " ", "\"\<The known generating simulated probability is \
distinct from the sample-fitted estimate. At least 100 successful bootstrap \
replicates and complete support are required for reported bootstrap standard \
uncertainty and intervals. Undefined support is retained; Uniform views use \
unconnected points including all bounds.\>\"", ",", 
                    
                    " ", "\"\<Age comparisons contrast two models fitted to \
matching measurement rows; they are not causal estimates or evidence of \
improved predictive validity. Custom comparisons require paired fits. No \
interval for the between-model difference is inferred.\>\"", ",", 
                    " ", "\"\<Probability surfaces use the native LakeColors, \
used consistently across views.  All plots explicitly use the Scientific \
theme, with the Source Sans Pro 12, frame colors, plot sizes and table \
conventions.\>\"", ",", 
                    " ", "\"\<Research software: same-visit latent-reference \
endpoint; no confirmed clinical diagnosis or externally validated decision \
rule. Fixed analytical CVs exclude unknown bias, preanalytical and biological \
contributions.\>\""}], "}"}], ",", " ", 
                    RowBox[{"Spacings", " ", "->", " ", "1"}]}], "]"}], ",", 
                    " ", "650"}], "]"}]}], "}"}], ",", " ", "False"}], 
                    "]"}]}], "\n", "     ", "}"}], ",", " ", 
                    RowBox[{"Spacings", " ", "->", " ", ".75"}]}], "]"}], ",",
                     " ", 
                    RowBox[{"TrackedSymbols", " ", ":>", " ", 
                    RowBox[{"{", "applied", "}"}]}]}], "]"}]}], "\n", "   ", 
                  "}"}], ",", " ", 
                 RowBox[{"Spacings", " ", "->", " ", ".75"}]}], "]"}], ",", 
               " ", 
               RowBox[{
               "FontFamily", " ", "->", " ", "\"\<Source Sans Pro\>\""}], ",",
                " ", 
               RowBox[{"FontSize", " ", "->", " ", "12"}]}], "]"}], ",", "\n",
              "   ", 
             RowBox[{"Initialization", " ", ":>", " ", "dependencies"}]}], 
            "]"}]}], "]"}]}], ";", "\n", 
        RowBox[{"nfBDPUReleaseVersion", "=", "\"\<1.0.0\>\""}], ";", "\n", 
        RowBox[{"nfBDPUCorrectionVersion", "=", "\"\<1.0.0\>\""}], ";", "\n", 
        RowBox[{
         RowBox[{"bduAgeDefaultFit", "[", "\"\<Metadata\>\"", "]"}], "=", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"bduAgeDefaultFit", "[", "\"\<Metadata\>\"", "]"}], ",", 
           RowBox[{"<|", 
            
            RowBox[{"\"\<PopulationLabel\>\"", 
             "->", "\"\<NHANES 2013-2014 selected training cohort, ages \
20-79; optional joint age model\>\""}], "|>"}]}], "]"}]}], ";"}], ",", 
       RowBox[{"Function", "[", 
        RowBox[{"text", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringQ", "[", "bduHCompleteSource", "]"}], ",", 
           RowBox[{"bduHCompleteSource", "=", 
            RowBox[{
            "bduHCompleteSource", "<>", "\"\<;\\n\>\"", "<>", "text"}]}]}], 
          "]"}]}], "]"}]}], "]"}], ";"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellTags->"BDPUInitialization",
 CellLabel->
  "In[272]:=",ExpressionUUID->"3aa3614a-d672-8e4b-8ab8-d2b1f0becbd1"]
}, Closed]],

Cell[CellGroupData[{

Cell["Numerical integration and caching", "Subsubsection",ExpressionUUID->"ca4b9bbb-b06f-0c43-8c93-5d20d4670a6d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Batch", " ", "the", " ", "quadrature", " ", "over", " ", "posterior", " ", 
     RowBox[{"draws", ".", " ", "Reuse"}], " ", "deterministic", " ", 
     "results", " ", "only", " ", "when", " ", "the", " ", "fitted", " ", 
     "model"}], ",", " ", 
    RowBox[{"inputs", " ", "and", " ", "numerical", " ", "options", " ", 
     RowBox[{"match", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"ToExpression", "[", 
   RowBox[{"\"\<nfBDPUOptimizationSource=\\\"(* BDPU-Threshold Exact Native \
Optimization 1.0.0 *)\\\\n(* Exact operation reuse: invariant component \
quantities are computed once per draw\\\\n   instead of once per quadrature \
node. Divisions are retained as divisions. \
*)\\\\nClearAll[nfBDPUPreparedMomentKernel];\\\\nnfBDPUPreparedMomentKernel=\
Compile[{{pi,_Real,1},{m,_Real,2},{tot,_Real,3},\\\\n \
{y,_Real},{r,_Real,2},{cut,_Real},{gh,_Real,2},{unif,_Real},{rv,_Real}},\\\\n \
Module[{k=Length[pi],sig=tot,wo=pi,wl=pi,fm=pi,fv=pi,fsd=pi,\\\\n  \
logWeight=pi,latentNorm=pi,latentSlope=pi,latentSqrt=pi,observedSlope=pi,\
observedSqrt=pi,\\\\n  \
cum=0.,like=0.,mean=0.,variance=0.,first=0.,qq=0.,v=0.,gm=0.,f=0.,sm=0.,\\\\n \
 qsample=0.,top=0.,j=0,a=0,h=0,sel=1},\\\\n  For[j=1,j<=k,j++,\\\\n   \
sig[[j]]=tot[[j]]-r;\\\\n   logWeight[[j]]=Log[pi[[j]]];\\\\n   \
latentNorm[[j]]=logWeight[[j]]-Log[sig[[j,1,1]]]/2;\\\\n   \
latentSlope[[j]]=sig[[j,2,1]]/sig[[j,1,1]];\\\\n   \
v=sig[[j,2,2]]-sig[[j,2,1]]^2/sig[[j,1,1]];latentSqrt[[j]]=Sqrt[2 v];\\\\n   \
observedSlope[[j]]=sig[[j,2,1]]/tot[[j,1,1]];\\\\n   \
v=sig[[j,2,2]]-sig[[j,2,1]]^2/tot[[j,1,1]];observedSqrt[[j]]=Sqrt[2 v];\\\\n  \
 wo[[j]]=logWeight[[j]]-Log[tot[[j,1,1]]]/2-(y-m[[j,1]])^2/(2 \
tot[[j,1,1]]);\\\\n   fm[[j]]=m[[j,1]]+sig[[j,1,1]]/tot[[j,1,1]] \
(y-m[[j,1]]);\\\\n   fv[[j]]=sig[[j,1,1]] \
r[[1,1]]/tot[[j,1,1]];fsd[[j]]=Sqrt[fv[[j]]]];\\\\n  \
top=Max[wo];wo=Exp[wo-top];like=Total[wo];wo=wo/like;like=Exp[top] like;\\\\n \
 For[j=1,j<=k,j++,\\\\n   gm=m[[j,2]]+observedSlope[[j]] (y-m[[j,1]]);\\\\n   \
mean+=wo[[j]] Erfc[(cut-gm)/observedSqrt[[j]]]/2];\\\\n  \
For[j=1,j<=k,j++,For[a=1,a<=Length[gh],a++,\\\\n   f=fm[[j]]+fsd[[j]] \
gh[[a,1]];\\\\n   For[h=1,h<=k,h++,\\\\n    \
wl[[h]]=latentNorm[[h]]-(f-m[[h,1]])^2/(2 sig[[h,1,1]])];\\\\n   \
top=Max[wl];wl=Exp[wl-top];wl=wl/Total[wl];sm=0.;\\\\n   \
For[h=1,h<=k,h++,\\\\n    gm=m[[h,2]]+latentSlope[[h]] (f-m[[h,1]]);\\\\n    \
sm+=wl[[h]] Erfc[(cut-gm)/latentSqrt[[h]]]/2];\\\\n   qq=sm;first+=wo[[j]] \
gh[[a,2]] qq;\\\\n   variance+=wo[[j]] gh[[a,2]] (qq-mean)^2]];\\\\n  \
cum=wo[[1]];sel=1;\\\\n  \
While[sel<k&&(unif>cum||wo[[sel]]==0.),sel++;cum+=wo[[sel]]];\\\\n  \
While[sel>1&&wo[[sel]]==0.,sel--];\\\\n  f=fm[[sel]]+fsd[[sel]] rv;\\\\n  \
For[h=1,h<=k,h++,wl[[h]]=latentNorm[[h]]-(f-m[[h,1]])^2/(2 \
sig[[h,1,1]])];\\\\n  top=Max[wl];wl=Exp[wl-top];wl=wl/Total[wl];\\\\n  \
For[h=1,h<=k,h++,\\\\n   gm=m[[h,2]]+latentSlope[[h]] (f-m[[h,1]]);\\\\n   \
qsample+=wl[[h]] Erfc[(cut-gm)/latentSqrt[[h]]]/2];\\\\n  \
{mean,variance,like,qsample,first}\\\\n ],RuntimeOptions->\\\\\\\"Quality\\\\\
\\\",CompilationTarget->\\\\\\\"WVM\\\\\\\"];\\\\n\\\\n(* BDPU-Threshold \
1.0.0 candidate: batch dispatch with the original quadrature kernel.\\\\n   \
No draw reduction, relaxed tolerance, changed quadrature or new runtime. *)\\\
\\nClearAll[nfBDPUBatchKernel,nfBDPUParallelCheckedKernel,\
nfBDPUBatchedMoments,nfBDPUReferenceMoments];\\\\nnfBDPUBatchKernel=With[{\
moment=If[Head[nfBDPUPreparedMomentKernel]===CompiledFunction,\
nfBDPUPreparedMomentKernel,nfBDPUMomentKernel],largest=$MaxMachineNumber},\\\\\
n Compile[{{weights,_Real,2},{means,_Real,3},{totals,_Real,4},\\\\n   \
{y,_Real},{r,_Real,2},{cut,_Real},{gh,_Real,2},{ghHigh,_Real,2},{tape,_Real,2}\
},\\\\n  Module[{n=Length[weights],k=Length[weights[[1]]],out=Table[{0.,0.,0.,\
0.,0.},{Length[weights]}],\\\\n    \
low={0.,0.,0.,0.,0.},high={0.,0.,0.,0.,0.},sig=totals[[1]],fm=weights[[1]],fv=\
weights[[1]],\\\\n    \
i=0,j=0,a=0,flag=0.,finite=True,highFinite=True,sharp=False,beta=0.,residual=\
0.,\\\\n    \
minwidth=largest,width=0.,scale=0.,lo=0.,hi=0.,slopeLo=0.,slopeHi=0.,variance=\
0.},\\\\n   For[i=1,i<=n,i++,\\\\n    \
low=moment[weights[[i]],means[[i]],totals[[i]],y,r,cut,gh,tape[[i,1]],tape[[i,\
2]]];\\\\n    \
finite=True;For[a=1,a<=5,a++,If[!(Abs[low[[a]]]<=largest),finite=False]];\\\\\
n    flag=0.;variance=low[[2]];\\\\n    \
If[!finite||low[[3]]<=0.,flag=2.,\\\\n     If[r[[1,1]]==0.,variance=0.,\\\\n  \
    high=moment[weights[[i]],means[[i]],totals[[i]],y,r,cut,ghHigh,tape[[i,1]]\
,tape[[i,2]]];\\\\n      \
highFinite=True;For[a=1,a<=5,a++,If[!(Abs[high[[a]]]<=largest),highFinite=\
False]];\\\\n      sig=totals[[i]];minwidth=largest;scale=0.;\\\\n      \
For[j=1,j<=k,j++,\\\\n       sig[[j]]=totals[[i,j]]-r;\\\\n       \
fm[[j]]=means[[i,j,1]]+sig[[j,1,1]]/totals[[i,j,1,1]] \
(y-means[[i,j,1]]);\\\\n       fv[[j]]=sig[[j,1,1]] \
r[[1,1]]/totals[[i,j,1,1]];\\\\n       beta=sig[[j,2,1]]/sig[[j,1,1]];\\\\n   \
    residual=sig[[j,2,2]]-sig[[j,2,1]]^2/sig[[j,1,1]];\\\\n       \
width=If[beta==0.,largest,Sqrt[residual]/Abs[beta]];\\\\n       \
minwidth=Min[minwidth,width];scale=Max[scale,Sqrt[fv[[j]]]]];\\\\n      \
sharp=minwidth<.25 scale;\\\\n      If[k==2,\\\\n       lo=Min[fm]-12 \
scale;hi=Max[fm]+12 scale;\\\\n       \
slopeLo=-(lo-means[[i,1,1]])/sig[[1,1,1]]+(lo-means[[i,2,1]])/sig[[2,1,1]];\\\
\\n       \
slopeHi=-(hi-means[[i,1,1]])/sig[[1,1,1]]+(hi-means[[i,2,1]])/sig[[2,1,1]];\\\
\\n       sharp=sharp||Max[Abs[slopeLo],Abs[slopeHi]] scale>4];\\\\n      \
If[sharp||!highFinite||Abs[low[[2]]-high[[2]]]>2.*^-11+2.*^-8 \
Abs[high[[2]]]||\\\\n        Abs[low[[5]]-low[[1]]]>2.*^-11+2.*^-8 \
Abs[low[[1]]]||\\\\n        Abs[high[[5]]-low[[1]]]>2.*^-11+2.*^-8 \
Abs[low[[1]]]||\\\\n        variance<0.||variance>low[[1]] \
(1-low[[1]])+5.*^-11,flag=1.]\\\\n     ]\\\\n    ];\\\\n    \
out[[i]]={low[[1]],variance,low[[3]],low[[4]],flag}\\\\n   ];out\\\\n  \
],RuntimeOptions->\\\\\\\"Quality\\\\\\\",CompilationTarget->\\\\\\\"WVM\\\\\\\
\",\\\\n  CompilationOptions->{\\\\\\\"InlineCompiledFunctions\\\\\\\"->True,\
\\\\\\\"InlineExternalDefinitions\\\\\\\"->True}]\\\\n];\\\\n\\\\n(* Listable \
compiled threading is local to Wolfram. Inputs are generated before\\\\n   \
dispatch and rows retain their original order; no worker kernels or \
settings\\\\n   changes are required. A serial WVM batch remains available as \
a fallback. \
*)\\\\nnfBDPUParallelCheckedKernel=With[{batch=nfBDPUBatchKernel},Compile[\\\\\
n {{w,_Real,1},{m,_Real,2},{t,_Real,3},{y,_Real},{r,_Real,2},{cut,_Real},\\\\\
n  {gh,_Real,2},{high,_Real,2},{u,_Real},{z,_Real}},\\\\n \
First[batch[{w},{m},{t},y,r,cut,gh,high,{{u,z}}]],\\\\n \
RuntimeOptions->\\\\\\\"Quality\\\\\\\",CompilationTarget->\\\\\\\"WVM\\\\\\\"\
,\\\\n CompilationOptions->{\\\\\\\"InlineCompiledFunctions\\\\\\\"->True,\\\\\
\\\"InlineExternalDefinitions\\\\\\\"->True},\\\\n \
RuntimeAttributes->{Listable},Parallelization->True]];\\\\n\\\\\
nnfBDPUReferenceMoments[samples_,y_,r_,cut_,gh_,tape_] := Table[\\\\n \
With[{s=samples[[i]]},nfBayesOneFast[s[\\\\\\\"weights\\\\\\\"],s[\\\\\\\"\
means\\\\\\\"],s[\\\\\\\"total_covariances\\\\\\\"],\\\\n   \
y,r,cut,gh,tape[[i,1]],tape[[i,2]]]],{i,Length[samples]}];\\\\n\\\\\
nnfBDPUBatchedMoments[samples_,y_,r_,cut_,gh_,tape_] := Module[\\\\n \
{weights,means,totals,extracted,n=Length[samples],k,rr,gg,tt,order,batch,\
flagged,check,failed=False},\\\\n If[n==0,Return[{}]];\\\\n \
extracted=Quiet[Check[Developer`ToPackedArray[Lookup[samples,#]]&/@{\\\\\\\"\
weights\\\\\\\",\\\\\\\"means\\\\\\\",\\\\\\\"total_covariances\\\\\\\"},$\
Failed]];\\\\n \
If[!ListQ[extracted]||Length[extracted]=!=3,Return[nfBDPUReferenceMoments[\
samples,y,r,cut,gh,tape]]];\\\\n {weights,means,totals}=extracted;\\\\n \
If[!(Developer`PackedArrayQ[weights,Real,2]||MatrixQ[weights,MachineNumberQ])|\
|\\\\n   !(Developer`PackedArrayQ[means,Real,3]||ArrayQ[means,3,\
MachineNumberQ])||\\\\n   \
!(Developer`PackedArrayQ[totals,Real,4]||ArrayQ[totals,4,MachineNumberQ])||\\\
\\n   !MachineNumberQ[y]||!MachineNumberQ[cut],Return[nfBDPUReferenceMoments[\
samples,y,r,cut,gh,tape]]];\\\\n k=Length[First[weights]];\\\\n \
If[!MemberQ[{1,2},k]||Dimensions[weights]=!={n,k}||Dimensions[means]=!={n,k,2}\
||\\\\n   \
Dimensions[totals]=!={n,k,2,2}||Dimensions[r]=!={2,2}||Min[weights]<=0,\\\\n  \
Return[nfBDPUReferenceMoments[samples,y,r,cut,gh,tape]]];\\\\n \
{rr,gg,tt}=Developer`ToPackedArray/@{N[r],N[gh],N[tape]};\\\\n \
If[!And@@(Developer`PackedArrayQ/@{weights,means,totals,rr,gg,tt})||\
Dimensions[tt]=!={n,2},\\\\n  \
Return[nfBDPUReferenceMoments[samples,y,r,cut,gh,tape]]];\\\\n \
order=Min[256,Max[64,2 Length[gh]]];\\\\n \
batch=Quiet[Check[nfBDPUParallelCheckedKernel[weights,means,totals,y,rr,cut,\
gg,\\\\n    \
Developer`ToPackedArray[N[nfBayesHermite[order]]],tt[[All,1]],tt[[All,2]]],$\
Failed]];\\\\n If[!MatrixQ[batch,NumberQ]||Dimensions[batch]=!={n,5},\\\\n  \
batch=Quiet[Check[nfBDPUBatchKernel[weights,means,totals,y,rr,cut,gg,\\\\n    \
 Developer`ToPackedArray[N[nfBayesHermite[order]]],tt],$Failed]]];\\\\n \
If[!MatrixQ[batch,NumberQ]||Dimensions[batch]=!={n,5},\\\\n  \
Return[nfBDPUReferenceMoments[samples,y,r,cut,gh,tape]]];\\\\n \
If[MemberQ[batch[[All,5]],2.],Return[nfBDPUReferenceMoments[samples,y,r,cut,\
gh,tape]]];\\\\n \
flagged=Flatten[Position[batch[[All,5]],Except[0.],{1},Heads->False]];\\\\n \
(* The unchanged reference wrapper owns every exceptional/adaptive path. *)\\\
\\n Do[check=With[{s=samples[[i]]},nfBayesOneFast[s[\\\\\\\"weights\\\\\\\"],\
s[\\\\\\\"means\\\\\\\"],s[\\\\\\\"total_covariances\\\\\\\"],\\\\n      \
y,r,cut,gh,tape[[i,1]],tape[[i,2]]]];\\\\n   \
If[FailureQ[check]||!MatchQ[check,{_,_,_,_}],failed=True;Break[]];\\\\n   \
batch[[i,1;;4]]=check,{i,flagged}];\\\\n \
If[failed,Return[nfBDPUReferenceMoments[samples,y,r,cut,gh,tape]]];\\\\n \
batch[[All,1;;4]]\\\\n];\\\\n\\\\n(* Replace only the per-draw dispatch \
expression. Public validation, posterior\\\\n   weights, uncertainty \
reductions, interval algorithms and return schemas stay\\\\n   in their \
existing definitions. Reinstallation is structurally idempotent. \
*)\\\\nClearAll[nfBDPUInstallDispatcher];\\\\nnfBDPUInstallDispatcher[] := \
Module[{realRule,ageRule},\\\\n realRule=HoldPattern[\\\\n   \
Table[nfBayesOneFast[a_[\\\\\\\"weights\\\\\\\"],b_[\\\\\\\"means\\\\\\\"],c_[\
\\\\\\\"total_covariances\\\\\\\"],\\\\n     \
y_,r_,cut_,gh_,RandomReal[],RandomVariate[NormalDistribution[]]],{s_,samples_}\
]\\\\n   ]/;SameQ[a,b,c,s]:>\\\\n    nfBDPUBatchedMoments[samples,y,r,cut,gh,\
\\\\n     \
Table[{RandomReal[],RandomVariate[NormalDistribution[]]},{Length[samples]}]];\
\\\\n ageRule=HoldPattern[\\\\n   Table[With[{s_=samples_[[i_]]},\\\\n     \
nfBayesOneFast[N[a_[\\\\\\\"weights\\\\\\\"]],N[b_[\\\\\\\"means\\\\\\\"]],N[\
c_[\\\\\\\"total_covariances\\\\\\\"]],\\\\n       \
y_,r_,cut_,gh_,N[tape_[[j_,1]]],N[tape2_[[j2_,2]]]]],{ii_,Length[samples2_]}]\
\\\\n   ]/;SameQ[a,b,c,s]&&SameQ[i,j,j2,ii]&&SameQ[samples,samples2]&&SameQ[\
tape,tape2]:>\\\\n    \
nfBDPUBatchedMoments[N[samples],y,r,cut,gh,N[tape]];\\\\n \
DownValues[BayesianDiseaseProbability]=DownValues[BayesianDiseaseProbability]/\
.realRule;\\\\n \
DownValues[bduAgeProbability]=DownValues[bduAgeProbability]/.ageRule;\\\\n \
Null\\\\n];\\\\nnfBDPUInstallDispatcher[];\\\\n\\\\n(* Check dense \
machine-real arrays in bulk. Mixed and higher-precision data\\\\n   retain \
the elementwise checks used by each probability model. \
*)\\\\nClearAll[nfBDPURealArrayQ];\\\\nnfBDPURealArrayQ[a_, rank_, \
predicate_] := If[Developer`PackedArrayQ[a, Real, rank],\\\\n TrueQ[-Infinity \
< Min[a] && Max[a] < Infinity], ArrayQ[a, rank, \
predicate]];\\\\n\\\\nDownValues[BayesianDiseaseProbability] = \
DownValues[BayesianDiseaseProbability] /.\\\\n HoldPattern[MatrixQ[a_, \
nfBDPUFiniteQ]] :> nfBDPURealArrayQ[a, 2, \
nfBDPUFiniteQ];\\\\nDownValues[bduAgeProbability] = \
DownValues[bduAgeProbability] /.\\\\n HoldPattern[MatrixQ[a_, bduAgeRealQ]] \
:> nfBDPURealArrayQ[a, 2, \
bduAgeRealQ];\\\\nDownValues[nfBayesWeightedQuantile] = \
DownValues[nfBayesWeightedQuantile] /.\\\\n HoldPattern[VectorQ[a_, \
nfBDPUFiniteQ]] :> nfBDPURealArrayQ[a, 1, nfBDPUFiniteQ];\\\\n\\\\n(* Bounded \
session-local reuse of exact deterministic work. Every hit verifies\\\\n   \
the complete key with SameQ after hashing; failures are never cached. \
*)\\\\nClearAll[nfBDPUCacheRead,nfBDPUCacheWrite,nfBDPUCacheableQ,\
nfBDPUDeterministicOptionsQ,\\\\n \
nfBDPUCachedAgeCurve,BDPUClearCalculationCache,\
BDPUCalculationCacheInformation];\\\\nSetAttributes[nfBDPUCacheRead,HoldFirst]\
;\\\\nnfBDPUCacheRead[cache_,key_] := \
Module[{hash=Hash[key,\\\\\\\"SHA256\\\\\\\"],entry},\\\\n \
entry=Lookup[cache,hash,Missing[\\\\\\\"NotCached\\\\\\\"]];\\\\n \
If[AssociationQ[entry]&&SameQ[entry[\\\\\\\"Key\\\\\\\"],key],entry[\\\\\\\"\
Value\\\\\\\"],Missing[\\\\\\\"NotCached\\\\\\\"]]\\\\n];\\\\nSetAttributes[\
nfBDPUCacheWrite,HoldFirst];\\\\nnfBDPUCacheWrite[cache_,key_,value_,limit_\
Integer] := Module[{hash=Hash[key,\\\\\\\"SHA256\\\\\\\"]},\\\\n \
cache=KeyDrop[cache,hash];AssociateTo[cache,hash-><|\\\\\\\"Key\\\\\\\"->key,\
\\\\\\\"Value\\\\\\\"->value|>];\\\\n \
If[Length[cache]>limit,cache=KeyDrop[cache,First[Keys[cache]]]];value\\\\n];\\\
\\nnfBDPUCacheableQ[fit_] := \
AssociationQ[fit]&&FreeQ[fit,_RuleDelayed];\\\\nnfBDPUDeterministicOptionsQ[f_\
] := FreeQ[Options[f],_RuleDelayed]&&IntegerQ[\\\\\\\"Seed\\\\\\\"/.Options[f]\
];\\\\nBDPUClearCalculationCache[] := \
(nfBDPUAgeFitCache=<||>;nfBDPUCurveCache=<||>;\\\\n \
nfBDPUReuseCounts=<|\\\\\\\"AgeConditionHits\\\\\\\"->0,\\\\\\\"\
AgeConditionMisses\\\\\\\"->0,\\\\\\\"CurveHits\\\\\\\"->0,\\\\\\\"\
CurveMisses\\\\\\\"->0|>;Null);\\\\nBDPUClearCalculationCache[];\\\\\
nBDPUCalculationCacheInformation[] := <|\\\\n \\\\\\\"Version\\\\\\\"->\\\\\\\
\"1.0.0\\\\\\\",\\\\n \\\\\\\"CompiledBackend\\\\\\\"->\\\\\\\"Wolfram \
virtual machine\\\\\\\",\\\\n \
\\\\\\\"CompiledMomentKernelAvailable\\\\\\\"->(Head[\
nfBDPUPreparedMomentKernel]===CompiledFunction),\\\\n \
\\\\\\\"CompiledListableDispatcherAvailable\\\\\\\"->(Head[\
nfBDPUParallelCheckedKernel]===CompiledFunction),\\\\n \
\\\\\\\"CompiledSerialDispatcherAvailable\\\\\\\"->(Head[nfBDPUBatchKernel]===\
CompiledFunction),\\\\n \
\\\\\\\"LocalCompiledParallelizationRequested\\\\\\\"->True,\\\\n \
\\\\\\\"LocalCompiledParallelizationAvailable\\\\\\\"->(Head[\
nfBDPUParallelCheckedKernel]===CompiledFunction),\\\\n \
\\\\\\\"AdaptiveFallbackAvailable\\\\\\\"->(Length[DownValues[\
nfBDPUAdaptiveVariance]]>0),\\\\\\\"ProcessorCount\\\\\\\"->$ProcessorCount,\\\
\\n \\\\\\\"AgeConditionEntries\\\\\\\"->Length[nfBDPUAgeFitCache],\\\\\\\"\
AgeConditionLimit\\\\\\\"->16,\\\\n \
\\\\\\\"CurveEntries\\\\\\\"->Length[nfBDPUCurveCache],\\\\\\\"CurveLimit\\\\\
\\\"->2,\\\\\\\"ReuseCounts\\\\\\\"->nfBDPUReuseCounts|>;\\\\n\\\\n(* \
Preserve a reference definition once, and refresh it if an explicit \
source\\\\n   initialization has restored the original definition. Never wrap \
a wrapper. \
*)\\\\nIf[FreeQ[DownValues[BayesianAgeConditionFit],\
nfBDPUAgeConditionReference],\\\\n \
ClearAll[nfBDPUAgeConditionReference];\\\\n \
DownValues[nfBDPUAgeConditionReference]=DownValues[BayesianAgeConditionFit]/.\
\\\\n   BayesianAgeConditionFit->nfBDPUAgeConditionReference;\\\\n \
Options[nfBDPUAgeConditionReference]=Options[BayesianAgeConditionFit]];\\\\\
nBayesianAgeConditionFit[fit_Association,age_] := \
Module[{key={fit,age},cached,value},\\\\n \
If[!nfBDPUCacheableQ[fit],Return[nfBDPUAgeConditionReference[fit,age]]];\\\\n \
cached=nfBDPUCacheRead[nfBDPUAgeFitCache,key];\\\\n \
If[!MissingQ[cached],nfBDPUReuseCounts[\\\\\\\"AgeConditionHits\\\\\\\"]++;\
Return[cached]];\\\\n \
nfBDPUReuseCounts[\\\\\\\"AgeConditionMisses\\\\\\\"]++;value=\
nfBDPUAgeConditionReference[fit,age];\\\\n \
If[AssociationQ[value],nfBDPUCacheWrite[nfBDPUAgeFitCache,key,value,16],value]\
\\\\n];\\\\n\\\\nIf[FreeQ[DownValues[nfBayesCurve],nfBDPUCurveReference],\\\\\
n ClearAll[nfBDPUCurveReference];\\\\n \
DownValues[nfBDPUCurveReference]=DownValues[nfBayesCurve]/.nfBayesCurve->\
nfBDPUCurveReference;\\\\n \
Options[nfBDPUCurveReference]=Options[nfBayesCurve]];\\\\nnfBayesCurve[fit_,\
lo_,hi_,cut_,level_] := Module[\\\\n \
{key={\\\\\\\"Real\\\\\\\",fit,lo,hi,cut,level,Options[\
BayesianDiseaseProbability]},cached,value},\\\\n \
If[!nfBDPUCacheableQ[fit]||!nfBDPUDeterministicOptionsQ[\
BayesianDiseaseProbability],\\\\n  \
Return[nfBDPUCurveReference[fit,lo,hi,cut,level]]];\\\\n \
cached=nfBDPUCacheRead[nfBDPUCurveCache,key];\\\\n \
If[!MissingQ[cached],nfBDPUReuseCounts[\\\\\\\"CurveHits\\\\\\\"]++;Return[\
cached]];\\\\n \
nfBDPUReuseCounts[\\\\\\\"CurveMisses\\\\\\\"]++;value=nfBDPUCurveReference[\
fit,lo,hi,cut,level];\\\\n \
If[ListQ[value]&&Length[value]>0&&AllTrue[value,AssociationQ],\\\\n  \
nfBDPUCacheWrite[nfBDPUCurveCache,key,value,2],value]\\\\n];\\\\\
nnfBDPUCachedAgeCurve[fit_,lo_,hi_,cut_,level_,tape_] := Module[\\\\n \
{key={\\\\\\\"Age\\\\\\\",fit,lo,hi,cut,level,tape,Options[\
BayesianAgeDiseaseProbability]},cached,value,eligible},\\\\n \
eligible=nfBDPUCacheableQ[fit]&&FreeQ[tape,_RuleDelayed]&&\
nfBDPUDeterministicOptionsQ[BayesianAgeDiseaseProbability];\\\\n \
If[eligible,cached=nfBDPUCacheRead[nfBDPUCurveCache,key];\\\\n  \
If[!MissingQ[cached],nfBDPUReuseCounts[\\\\\\\"CurveHits\\\\\\\"]++;Return[\
cached]]];\\\\n nfBDPUReuseCounts[\\\\\\\"CurveMisses\\\\\\\"]++;\\\\n \
value=Table[BayesianAgeDiseaseProbability[fit,x,\\\\\\\"ReferenceThreshold\\\\\
\\\"->cut,\\\\n   \\\\\\\"CredibleLevel\\\\\\\"->level,\\\\\\\"RandomTape\\\\\
\\\"->tape],{x,Subdivide[N[lo],N[hi],40]}];\\\\n \
If[eligible&&ListQ[value]&&Length[value]>0&&AllTrue[value,AssociationQ],\\\\n \
 nfBDPUCacheWrite[nfBDPUCurveCache,key,value,2],value]\\\\n];\\\\nDownValues[\
bduAgeRealEvaluation]=DownValues[bduAgeRealEvaluation]/.\\\\n \
(HoldPattern[Table[BayesianAgeDiseaseProbability[fit_,x_,\\\\\\\"\
ReferenceThreshold\\\\\\\"->cut_,\\\\n    \
\\\\\\\"CredibleLevel\\\\\\\"->level_,\\\\\\\"RandomTape\\\\\\\"->tape_],{xx_,\
Subdivide[N[lo_],N[hi_],40]}]]/;SameQ[x,xx]:>\\\\n   \
nfBDPUCachedAgeCurve[fit,lo,hi,cut,level,tape]);\\\";\\nToExpression[\
nfBDPUOptimizationSource,InputForm];\\nnfBDPUUpdateEmbeddedSource[s_String]:=\
Module[{prefix=s,positions},positions=StringPosition[s,\\\"(* BDPU-Threshold \
Exact Native Optimization 1.0.0 \
*)\\\"];If[positions=!={},prefix=StringTake[s,First[First[positions]]-1]];\
StringReplace[prefix,RegularExpression[\\\"[;\\\\\\\\s]+$\\\"]->\\\"\\\"]<>\\\
\";\\\\n\\\"<>nfBDPUOptimizationSource];\\nIf[StringQ[nfBayesDefinitionSource]\
,nfBayesDefinitionSource=nfBDPUUpdateEmbeddedSource[nfBayesDefinitionSource]];\
\\nIf[StringQ[nfBayesInterfaceSource],nfBayesInterfaceSource=\
nfBDPUUpdateEmbeddedSource[nfBayesInterfaceSource]];\\nIf[StringQ[\
bduAgeCompleteSource],bduAgeCompleteSource=nfBDPUUpdateEmbeddedSource[\
bduAgeCompleteSource]];\\nIf[StringQ[bduHCompleteSource],bduHCompleteSource=\
nfBDPUUpdateEmbeddedSource[bduHCompleteSource]];\\nClear[\
nfBDPUUpdateEmbeddedSource];\>\"", ",", "InputForm"}], "]"}]}]], "Input",
 InitializationCell->True,
 CellTags->{"BDPUInitialization", "BDPUExactOptimization"},
 CellLabel->
  "In[273]:=",ExpressionUUID->"a594f7d7-c1be-f048-a475-4c22fa43ce05"]
}, Closed]]
}, Closed]],

