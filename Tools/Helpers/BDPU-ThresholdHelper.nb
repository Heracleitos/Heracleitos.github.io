\\\"]; , Null, \\n nfBayesDisplayResult[r_, disease_, digits_] := \\n   \
Module[{p = If[disease, r[\\\"Probability\\\"], 1 - r[\\\"Probability\\\"]], \
ci, qi}, \\n    ci = If[disease, r[\\\"ParameterCredibleInterval\\\"], 1 - \
Reverse[r[\\\"ParameterCredibleInterval\\\"]]]; \\n     qi = If[disease, r[\\\
\"TotalQCredibleInterval\\\"], 1 - \
Reverse[r[\\\"TotalQCredibleInterval\\\"]]]; \\n     Grid[Prepend[({#1[[1]], \
NumberForm[#1[[2]], {12, digits}]} & ) /@ \\n        {{\\\"Evaluated \
measurement value\\\", r[\\\"ObservedResult\\\"]}, {\\\"Evaluated reference \
threshold\\\", \\n          r[\\\"ReferenceThreshold\\\"]}, {\\\"Posterior \
probability\\\", p}, \\n         {\\\"Sampling parameter standard uncertainty\
\\\", r[\\\"SamplingParameterSD\\\"]}, \\n         {\\\"Measurement standard \
uncertainty (new result)\\\", r[\\\"MeasurementNewResultSD\\\"]}, \\n         \
{\\\"Total standard uncertainty\\\", r[\\\"TotalSD\\\"]}, {\\\"Relative \
sampling uncertainty\\\", \\n          If[p > 0, \
r[\\\"SamplingParameterSD\\\"]/p, Indeterminate]}, \\n         {\\\"Relative \
measurement uncertainty\\\", If[p > 0, r[\\\"MeasurementNewResultSD\\\"]/p, \
\\n           Indeterminate]}, {\\\"Relative total uncertainty\\\", If[p > 0, \
r[\\\"TotalSD\\\"]/p, \\n           Indeterminate]}, {\\\"Parameter credible \
interval\\\", ci}, {\\\"Total-Q credible interval\\\", qi}, \\n         \
{\\\"Posterior draw count\\\", r[\\\"DrawCount\\\"]}, {\\\"Importance \
effective sample size\\\", \\n          r[\\\"ImportanceESS\\\"]}, \
{\\\"Variance closure\\\", r[\\\"VarianceClosure\\\"]}}, \\n       \
{\\\"Quantity\\\", \\\"Result\\\"}], Frame -> All, Alignment -> Left, \\n     \
 Background -> {None, {RGBColor[0.92, 0.96, 1.], {White}}}, FrameStyle -> \
Blend[{Blue, Cyan}, 0.35], Spacings -> {1.2, 0.7}, BaseStyle -> {FontFamily \
-> \\\"Source Sans Pro\\\", FontSize -> 12, FontWeight -> Plain}, ItemStyle \
-> {{}, {Directive[FontWeight -> Plain], {Directive[FontWeight -> \
Plain]}}}]]; , Null, \\n nfBayesProbabilityPlot[curve_, disease_, predictor_, \
unit_, band_:\\\"ParameterCredibleInterval\\\"] := \\n   Module[{f = \
If[disease, Identity, 1 - #1 & ], lines}, \\n    lines = \
Table[{r[\\\"ObservedResult\\\"], f[r[\\\"Probability\\\"]]}, {r, curve}]; \
\\n     ListLinePlot[{lines, Table[{r[\\\"ObservedResult\\\"], If[disease, \
r[band][[1]], 1 - r[band][[2]]]}, \\n        {r, curve}], \
Table[{r[\\\"ObservedResult\\\"], If[disease, r[band][[2]], 1 - \
r[band][[1]]]}, \\n        {r, curve}]}, Frame -> True, \\n      FrameLabel \
-> {StringJoin[predictor, \\\" (\\\", unit, \\\")\\\"], \\\"Posterior \
probability\\\"}, \\n      PlotRange -> {All, {0, 1}}, PlotStyle -> \
{Directive[], Dashed, Dashed}, Filling -> {2 -> {3}}, PlotLegends -> \\n      \
 {\\\"Probability\\\", If[band == \\\"ParameterCredibleInterval\\\", \
\\\"Parameter interval lower\\\", \\n         \\\"Total-Q interval \
lower\\\"], If[band == \\\"ParameterCredibleInterval\\\", \\n         \
\\\"Parameter interval upper\\\", \\\"Total-Q interval upper\\\"]}, ImageSize \
-> 600, \\n      BaseStyle -> {FontFamily -> \\\"Source Sans Pro\\\", \
FontWeight -> Plain}, PlotTheme -> \\\"Scientific\\\", \\n      LabelStyle -> \
{FontFamily -> \\\"Source Sans Pro\\\", FontWeight -> Plain, FontColor -> \
RGBColor[0.10, 0.22, 0.40]}]]; , Null, \\n nfBayesUncertaintyPlot[curve_, \
relative_, disease_, predictor_, unit_] := \\n   Module[{keys = \
{\\\"SamplingParameterSD\\\", \\\"MeasurementNewResultSD\\\", \
\\\"TotalSD\\\"}, p}, \\n    ListLinePlot[Table[Table[p = If[disease, \
r[\\\"Probability\\\"], 1 - r[\\\"Probability\\\"]]; \\n        \
{r[\\\"ObservedResult\\\"], If[relative && p <= 0, Indeterminate, \
r[key]/If[relative, p, 1.]]}, \\n       {r, curve}], {key, keys}], Frame -> \
True, \\n     FrameLabel -> {StringJoin[predictor, \\\" (\\\", unit, \
\\\")\\\"], \\n       If[relative, \\\"Relative standard uncertainty\\\", \
\\\"Standard uncertainty of probability\\\"]}, \\n     PlotRange -> All, \
PlotStyle -> Automatic, \\n     PlotLegends -> {\\\"Sampling parameter\\\", \
\\\"New-result measurement\\\", \\\"Total\\\"}, ImageSize -> 600, \\n     \
BaseStyle -> {FontFamily -> \\\"Source Sans Pro\\\", FontWeight -> Plain}, \
PlotTheme -> \\\"Scientific\\\", \\n     LabelStyle -> {FontFamily -> \
\\\"Source Sans Pro\\\", FontWeight -> Plain, FontColor -> RGBColor[0.10, \
0.22, 0.40]}]]; , Null, \\n nfBayesDensityPlot[fit_, lo_, hi_, predictor_, \
unit_] := \\n   Module[{xs = Subdivide[N[lo], N[hi], 80], grid}, \\n    grid \
= Transpose[{xs, bduHObservedPredictiveDensity[fit, xs]}]; \\n     \
ListLinePlot[grid, Frame -> True, \\n      FrameLabel -> \
{StringJoin[predictor, \\\" (\\\", unit, \\\")\\\"], \\n        \
\\\"Observed-measurement predictive density\\\"}, PlotRange -> All, PlotStyle \
-> Automatic, \\n      ImageSize -> 600, BaseStyle -> {FontFamily -> \
\\\"Source Sans Pro\\\", FontWeight -> Plain}, \\n      PlotTheme -> \
\\\"Scientific\\\", LabelStyle -> {FontFamily -> \\\"Source Sans Pro\\\", \
FontWeight -> Plain, FontColor -> RGBColor[0.10, 0.22, 0.40]}]]; , Null, \
ClearAll[bduHScientificGraphics]; , \\n bduHScientificGraphics[pr_, opts___] \
:= Module[{range, clean, xy, extents, pad, label, plot}, \\n    xy = \
Flatten[Cases[pr, HoldPattern[(Line | Point | Polygon)[c_]] :> If[VectorQ[c, \
NumericQ], \\n          {c}, c], Infinity], 1]; xy = Select[xy, MatchQ[#1, \
{_?NumericQ, _?NumericQ}] & ]; \\n     extents = If[xy === {}, {{0, 1}, {0, \
1}}, MinMax /@ Transpose[xy]]; \\n     range = PlotRange /. {opts} /. \
PlotRange -> All; If[MemberQ[{All, Automatic}, range], \\n      range = \
extents, range = MapThread[If[MemberQ[{All, Automatic}, #1], #2, #1] & , \\n  \
      {range, extents}]]; \\n     range = (If[#1[[1]] == #1[[2]], pad = \
If[#1[[1]] == 0, 1, Max[0.05*Abs[#1[[1]]], 10^(-6)]]; \\n          #1 + \
{-pad, pad}, #1] & ) /@ range; label = PlotLabel /. {opts} /. PlotLabel -> \
None; \\n     clean = DeleteCases[FilterRules[{opts}, Options[ListLinePlot]], \
\\n       HoldPattern[PlotRange | PlotLabel -> _]]; plot = ListLinePlot[{}, \
PlotTheme -> \\\"Scientific\\\", \\n       LabelStyle -> {FontFamily -> \
\\\"Source Sans Pro\\\", FontWeight -> Plain, FontColor -> RGBColor[0.10, \
0.22, 0.40]}, Epilog -> pr, \\n       PlotRange -> range, Sequence @@ clean]; \
If[label === None, plot, \\n      Labeled[plot, Style[label, FontFamily -> \\\
\"Source Sans Pro\\\", FontWeight -> Plain, FontColor -> RGBColor[0.10, 0.22, \
0.40]], Top]]]; , Null, \\n ClearAll[bduHTable, bduHFormat, \
bduHSimulationSummary, bduHInitialEvaluation]; , \\n bduHFormat[x_, \
digits_:4] := Which[bduAgeRealQ[x], NumberForm[N[x], {12, digits}], \\n    \
VectorQ[x, bduAgeRealQ], NumberForm[N[x], {12, digits}], Head[x] === Missing \
|| FailureQ[x], \\n    \\\"undefined\\\", True, x]; , bduHTable[rows_, \
alignment_:Left] := \\n   Grid[rows, Frame -> All, Alignment -> Left, \\n    \
Background -> {None, {RGBColor[0.92, 0.96, 1.], {White}}}, \\n    BaseStyle \
-> {FontFamily -> \\\"Source Sans Pro\\\", FontSize -> 12, FontWeight -> \
Plain}, FrameStyle -> Blend[{Blue, Cyan}, 0.35], Spacings -> {1.2, 0.7}, \
ItemStyle -> {{}, {Directive[FontWeight -> Plain], {Directive[FontWeight -> \
Plain]}}}]; , \\n bduHInitialEvaluation[af_, bf_, enabled_, age_, value_, \
cut_, level_, lo_, hi_, \\n    tape_:Automatic] := Module[{effective, r}, \\n \
   effective = If[TrueQ[enabled], BayesianAgeConditionFit[af, age], bf]; \\n  \
   If[FailureQ[effective], Return[effective]]; \\n     r = If[TrueQ[enabled], \
BayesianAgeDiseaseProbability[effective, value, \\n        \
\\\"ReferenceThreshold\\\" -> cut, \\\"CredibleLevel\\\" -> level, \
\\\"RandomTape\\\" -> tape], \\n       BayesianDiseaseProbability[bf, value, \
\\\"ReferenceThreshold\\\" -> cut, \\n        \\\"CredibleLevel\\\" -> \
level]]; If[FailureQ[r], Return[r]]; Association[\\\"Mode\\\" -> \
\\\"Real\\\", \\n      \\\"Result\\\" -> r, \\\"Curve\\\" -> {}, \
\\\"EffectiveFit\\\" -> effective, \\\"AgeFit\\\" -> af, \\n      \
\\\"AgeEnabled\\\" -> TrueQ[enabled], \\\"Age\\\" -> If[TrueQ[enabled], age, \
None], \\\"Value\\\" -> value, \\n      \\\"Threshold\\\" -> cut, \\\"Level\\\
\" -> level, \\\"Range\\\" -> {lo, hi}]]; , \\n SetAttributes[bduAgeRender, \
HoldFirst]; , \\n bduAgeRender[expr_, applied_] := \
Block[{nfBayesProbabilityLabel, bduSimProbabilityLabel}, \\n    \
nfBayesProbabilityLabel[d_:True] := bduAgeProbabilityLabel[d, applied[\\\"Age\
\\\"], \\n       applied[\\\"AgeEnabled\\\"]]; \
bduSimProbabilityLabel[d_:True] := bduAgeProbabilityLabel[d, \\n       \
applied[\\\"Age\\\"], applied[\\\"AgeEnabled\\\"]]; expr]; , \\n \
SetAttributes[bduAgePlotLabel, HoldFirst]; , \\n bduAgePlotLabel[expr_, \
applied_] := \\n   Column[{Style[If[TrueQ[applied[\\\"AgeEnabled\\\"]], Row[{\
\\\"Conditional on recorded age \\\", \
bduHAgeNumberText[applied[\\\"Age\\\"]], \\n        \\\" years\\\"}], \\\"Age \
not used\\\"], FontFamily -> \\\"Source Sans Pro\\\", FontWeight -> Plain, \
FontColor -> RGBColor[0.10, 0.22, 0.40]], bduAgeRender[expr, applied]}, \\n   \
 BaseStyle -> {FontFamily -> \\\"Source Sans Pro\\\", FontWeight -> Plain}, \
Spacings -> 0.7]; , \\n bduAgeRealSummary[applied_, disease_, digits_] := \\n \
  Column[{Row[{\\\"Evaluated endpoint: \\\", bduAgeAppliedLabel[applied, \
\\\"ReferenceLabel\\\", \\\"Reference\\\"], \\n       \\\" \[GreaterEqual] \\\
\", applied[\\\"Result\\\"][\\\"ReferenceThreshold\\\"], \\\" \\\", \
bduAgeAppliedLabel[applied, \\n        \\\"MeasurementUnit\\\", \\\"original \
scale\\\"], If[TrueQ[applied[\\\"AgeEnabled\\\"]], \\n        Row[{\\\"; age \
\\\", applied[\\\"Age\\\"], \\\" years\\\"}], \\\"\\\"]}], \
nfBayesDisplayResult[applied[\\\"Result\\\"], \\n      disease, digits]}, \
BaseStyle -> {FontFamily -> \\\"Source Sans Pro\\\", 12}]; , \\n \
nfBayesUncertaintyTable[curve_, relative_, disease_, predictor_, unit_, \
digits_] := \\n   bduHTable[Prepend[Table[With[{p = If[TrueQ[disease], \
r[\\\"Probability\\\"], 1 - r[\\\"Probability\\\"]]}, \\n       \
Prepend[(bduHFormat[#1, digits] & ) /@ If[TrueQ[relative], \\n          If[p \
> 0, r /@ {\\\"SamplingParameterSD\\\", \\\"MeasurementNewResultSD\\\", \
\\\"TotalSD\\\"}/p, \\n           ConstantArray[Missing[\\\"ZeroProbability\\\
\"], 3]], r /@ {\\\"SamplingParameterSD\\\", \\n            \
\\\"MeasurementNewResultSD\\\", \\\"TotalSD\\\"}], \
bduHFormat[r[\\\"ObservedResult\\\"], digits]]], \\n      {r, curve}], \
{StringJoin[predictor, \\\" (\\\", unit, \\\")\\\"], \\\"Sampling parameter\\\
\", \\n      \\\"New-result measurement\\\", \\\"Total\\\"}], Left]; , \\n \
bduHSimulationSummary[applied_, disease_, digits_] := \\n   Module[{r = \
applied[\\\"Result\\\"], key = If[TrueQ[disease], \\\"Disease\\\", \
\\\"Nondisease\\\"], p, sd, ci}, \\n    p = Lookup[r, StringJoin[key, \
\\\"Probability\\\"], Missing[\\\"Undefined\\\"]]; \\n     sd = Lookup[r, \
StringJoin[key, \\\"StandardUncertainty\\\"], Missing[\\\"Undefined\\\"]]; \
\\n     ci = Lookup[r, StringJoin[key, \\\"Interval\\\"], \
Missing[\\\"Undefined\\\"]]; \\n     Column[{\\\"Pointwise bootstrap \
uncertainty of the sample-fitted probability; fixed generating \\\\\\nmodel \
shown separately.\\\", bduHTable[Prepend[({#1[[1]], bduHFormat[#1[[2]], \
digits]} & ) /@ \\n          {{\\\"Evaluated measurement value\\\", \
r[\\\"ObservedResult\\\"]}, {\\\"Applied age\\\", \\n            \
If[TrueQ[applied[\\\"AgeEnabled\\\"]], applied[\\\"Age\\\"], \\\"not \
used\\\"]}, \\n           {\\\"Sample-fitted probability\\\", p}, {\\\"Known \
generating probability\\\", \\n            Lookup[r, \
StringJoin[\\\"Generating\\\", key, \\\"Probability\\\"], \
Missing[\\\"Undefined\\\"]]}, \\n           {\\\"Bootstrap sampling standard \
uncertainty\\\", sd}, {\\\"Relative standard uncertainty\\\", \\n            \
If[bduAgeRealQ[p] && p > 0 && bduAgeRealQ[sd], sd/p, \
Missing[\\\"Undefined\\\"]]}, \\n           {\\\"Pointwise percentile \
interval\\\", ci}, {\\\"Confidence level\\\", r[\\\"ConfidenceLevel\\\"]}, \
\\n           {\\\"Valid bootstrap replicates\\\", \
r[\\\"ValidReplicates\\\"]}, {\\\"Total replicates\\\", \\n            \
r[\\\"TotalReplicates\\\"]}, {\\\"Status\\\", r[\\\"Status\\\"]}}, \
{\\\"Quantity\\\", \\\"Result\\\"}]], \\n       Lookup[r, \\\"StatusMessage\\\
\", \\\"\\\"]}, BaseStyle -> {FontFamily -> \\\"Source Sans Pro\\\", 12}]]; , \
\\n bduUnifiedSimChart[primitives_, curve_List, yRange_, yLabel_] := \\n   \
Module[{xs, xr}, xs = Select[Lookup[curve, \\\"ObservedResult\\\", \
Missing[]], bduSimRealQ]; \\n     xr = If[Length[xs] > 0, MinMax[xs], {0, \
1}]; If[xr[[1]] == xr[[2]], xr = xr + {-1, 1}]; \\n     \
bduHScientificGraphics[primitives, Frame -> True, Axes -> False, FrameLabel \
-> {\\\"Test result (original scale)\\\", \\n        yLabel}, PlotRange -> \
{xr, yRange}, PlotRangePadding -> Scaled[0.02], ImageSize -> 600, \\n      \
AspectRatio -> 1/GoldenRatio, BaseStyle -> {FontFamily -> \\\"Source Sans Pro\
\\\", FontWeight -> Plain}]]; , \\n \
bduUnifiedSimIntervalPrimitives[curve_List, disease_] := \\n   Module[{key = \
bduUnifiedSimKey[disease, \\\"Interval\\\"], runs, lower, upper}, \\n    runs \
= bduUnifiedSimValidRuns[curve, Lookup[#1, \\\"Status\\\", \\\"\\\"] === \
\\\"Complete\\\" && \\n         MatchQ[Lookup[#1, key, Missing[]], \
{_?bduSimRealQ, _?bduSimRealQ}] & ]; \\n     Function[run, lower = \
