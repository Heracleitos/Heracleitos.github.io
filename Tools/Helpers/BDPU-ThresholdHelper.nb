Cell[TextData[{
 "Select ",
 StyleBox["Start analysis",
  FontWeight->Plain,
  FontColor->RGBColor[0.1451, 0.3137, 0.4588]],
 ". Choose ",
 StyleBox["Real data",
  FontWeight->Plain,
  FontColor->RGBColor[0.1451, 0.3137, 0.4588]],
 " and ",
 StyleBox["Disease",
  FontWeight->Plain,
  FontColor->RGBColor[0.1451, 0.3137, 0.4588]],
 ", enter an observed FPG of 126 mg/dL, and enter 95 for a 95% interval. \
Select ",
 StyleBox["Calculate probabilities",
  FontWeight->Plain,
  FontColor->RGBColor[0.1451, 0.3137, 0.4588]],
 ". The default settings use the embedded fits and a reference OGTT threshold \
of 200 mg/dL. To work directly with Wolfram Language cells, select ",
 StyleBox["Load functions for examples",
  FontWeight->Plain,
  FontColor->RGBColor[0.1451, 0.3137, 0.4588]],
 "."
}], "Text",ExpressionUUID->"60bf40ae-4f7d-884c-a026-72a56f413018"],

Cell[TextData[
                {"Read the probability for the selected outcome above ", StyleBox["Tables", 
                  FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], " and ", StyleBox["Plots", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ". The line below \
the probability identifies the applied source, result, interval level and any conditioning age. The \
probability table gives the interval and total standard uncertainty. The uncertainty table and plots \
show how results vary across the test range. Axis and legend labels appear in regular-weight navy. ", StyleBox["Export results", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], 
                 " saves the applied analysis."}], "Text", ExpressionUUID -> 
                "03a16134-5032-4c40-b8c8-1441493f734b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Change inputs or fit a model", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"90f9b895-9e24-7047-adbd-\
3aa5c0172c70"],

Cell[TextData[{"Use ", StyleBox[
                  "More settings", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], 
                 " to change the reference threshold, plot range or conditioning age, then select ", 
                 StyleBox["Calculate probabilities", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ". It also controls decimal \
places, the real-data interval type and the uncertainty scale. Display changes reuse the applied result. \
If an input is invalid or a calculation is interrupted, the last successful result and its labels stay \
visible."}], "Text", ExpressionUUID -> "e3c28dee-4dcd-aa41-9c1d-e5e8edccc226"],

Cell[TextData[
                {"To fit real data, open ", StyleBox["Data and model", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ". Prepare a \
header-free numeric CSV with positive test and reference measurements in the first two columns. Add \
recorded age in years as a third column for an age model. Set the analytical CVs as fractions, select \
the mixture component count and sampler settings, and choose ", StyleBox["Import CSV and fit", 
                  FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ". Changes to training data, analytical CVs, priors or the \
component count require an explicit refit. The interface uses the documented prior and fits one \
exploratory chain. ", StyleBox["Restore reference posteriors", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], 
                 " restores the embedded pair."}], "Text", ExpressionUUID -> 
                "59368a98-1de3-134c-82b8-cbaaf4dd7be0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Simulated data and age analyses", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"6d42a69b-28b0-5449-8a1d-\
3a98e1988e8b"],

Cell[TextData[{"Choose ", StyleBox[
                  "Simulated data", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], " and open ", StyleBox["Data and model", 
                  FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ". Set a distribution, mean, standard deviation and sample count \
for each class. Specify prevalence separately from the class counts. Select ", StyleBox[
                  "Generate simulation and bootstrap", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ", then ", 
                 StyleBox["Calculate probabilities", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], 
                 ". Regenerate the simulation after changing its generating settings."}], "Text", 
               ExpressionUUID -> "b8a1f4fc-fd24-3740-9dd2-d4377101bed2"],

Cell["The simulation headline \
is the sample-fitted probability. The probability table also gives the known generating probability, \
calculated from the supplied class distributions and prevalence. The parametric bootstrap resamples from \
the fitted distributions and refits their means and standard deviations. It holds the distribution \
families, prevalence, Student t degrees of freedom and any supplied age effects fixed.", "Text", 
               ExpressionUUID -> "b873abd8-cbda-e246-8d2f-26eaa097320b"],

Cell["At each observed value, \
the bootstrap supplies a sampling standard uncertainty and a pointwise percentile confidence interval \
when at least 100 replicates are available and all requested replicates give a defined probability. The \
status and valid-replicate count explain a missing interval, including failures caused by limited \
distribution support.", "Text", ExpressionUUID -> "6da170cc-a94f-524f-80dd-487fad304fae"],

Cell[TextData[{"For an age-specific real-data estimate, enable ", StyleBox[
                  "Condition on age", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], " under ", StyleBox["More settings", 
                  FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ", enter an age within the fitted training range and calculate. \
In a simulation, the age controls specify changes per decade from an anchor age in the two class means \
and the log-odds of prevalence."}], "Text", ExpressionUUID -> "ce7f6166-2125-974d-a276-8485ec480921"],

Cell[TextData[{"Open ", StyleBox["Age analyses", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], " for an ", 
                 StyleBox["Age profile", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ", ", StyleBox["Probability surface", 
                  FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], " or ", StyleBox["Compare models", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ". A \
profile evaluates a fixed observed result at each age. A surface evaluates an explicit grid of test \
values and ages. Each view has its own calculation action and records the inputs used. In the age \
profile, enter the interval level as a fraction such as 0.95."}], "Text", ExpressionUUID -> 
                "41890ef5-3654-844e-b451-fd52ff567f84"],

Cell[TextData[
                {"For a custom real-data comparison, select ", StyleBox["Fit paired comparison models", 
                  FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], " in ", StyleBox["Data and model", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], 
                 " and supply the same three-column CSV for both fits. Under ", StyleBox[
                  "Compare models", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ", choose the comparison age and select ", 
                 StyleBox["Compare with / without age", FontWeight -> Plain, FontColor -> RGBColor[0.1451, 0.3137, 0.4588]], ". The resulting curves \
describe the fitted models at the chosen settings. Evidence about predictive performance comes from an \
evaluation on held-out outcomes."}], "Text", ExpressionUUID -> "1f02d864-5adc-9b4d-bc97-507b8ef10455"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Scope and models", "Section",
 FontSize->24,
 CellTags->"Scope",ExpressionUUID->"2b8d84b9-d21e-b145-bbe8-61f94ccd7b75"],

Cell["BDPU-Threshold estimates disease or nondisease probability conditional on a quantitative test \
result. With paired real measurements, it infers the joint distribution of the test and reference and \
propagates uncertainty in the new test measurement. With simulated data, it uses the specified \
prevalence and the two class densities to calculate a probability at the observed value.", "Text", 
            ExpressionUUID -> "1827247e-d651-c54f-b3a6-ea9976ce5ef9"],

Cell["Primary case study: NHANES \
2013-2014 adults aged 20-79 who reported no diabetes (DIQ010=2), with paired positive FPG and OGTT, no \
known pregnancy, complete challenge, collection 105-135 min after challenge, and positive OGTT subsample \
weight. The complete cohort contains 1702 participants and 68 measured OGTT positives. A seeded \
stratified split reserves 341 participants (14 positives); 1361 participants (54 positives) train the \
model. HbA1c completeness is not required. The primary case uses one survey cycle to avoid pooling \
across instrument changes.", "Text", ExpressionUUID -> "8f29f289-9e19-4947-9029-8d0daf102f12"],

Cell[CellGroupData[{

Cell["Two-dimensional model", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"2aa3e0de-c845-7b4a-8168-\
20c89d0dfb9c"],

Cell["The reference analysis defines disease as \
an analytical-error-free same-visit OGTT of at least 200 mg/dL. Observed FPG is the predictor. The two \
mixture components describe heterogeneity in the joint measurement distribution. The age-disabled \
analysis estimates probability over the selected age range.", "Text", ExpressionUUID -> 
                "51163c7d-6b5e-5e49-b884-49effc8c2c94"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Optional age extension", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"d293bd01-a5b2-0745-b0c2-\
1d524bc4d9a6"],

Cell["The age model is fitted separately to log \
test, log reference and recorded age. Conditioning on age updates the mixture component weights and the \
posterior draw weights through the age likelihood. The observed test result then contributes its \
predictive likelihood. The model supports age-specific estimates within the observed training-age \
range.", "Text", ExpressionUUID -> "b7fac083-0f7e-aa43-9953-f42773a83810"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Model and posterior conditioning", "Section",
 FontSize->24,
 FontColor->RGBColor[0.8, 0.043137254901960784`, 0.00784313725490196],
 CellTags->"Model",ExpressionUUID->"3eb4fba5-4efe-be4c-90e9-a2c5ce180009"],

Cell["Observed log FPG and log \
OGTT follow a two-component bivariate normal mixture. Weights have Dirichlet(1,1) prior. Component \
observed covariances have inverse-Wishart(nu0=4,Psi0=diag(0.04,0.25)) prior; means conditional on \
covariance have normal prior with m0=log(100,110), kappa0=0.1. Each covariance prior is restricted to \
T-R positive definite. Zero-mean log analytical errors have fixed covariance R=diag(log(1+CV^2)); \
concentration results are therefore median-unbiased under the model. Low-concentration QC pooled CV \
1.3321 percent informs FPG; high-concentration QC pooled CV 1.0230 percent is an explicitly assumed OGTT \
proxy. Values derive from the rounded 2013-2014 fasting-glucose QC table and 125 within-lot degrees of \
freedom.", "Text", ExpressionUUID -> "9404bf8c-2d12-224f-94b2-e7df696c531b"],

Cell["Gibbs sampling alternates component allocations, normalized gamma draws for mixture \
weights and restricted normal-inverse-Wishart updates for the component parameters. The reference fit \
contains 6000 retained draws from four archived independent chains. For a new observed log test value y, \
the model reweights each parameter draw by its predictive likelihood. Within each draw, it averages the \
conditional probability Q over the unknown error-free log test F given y and the draw. The reported \
probability is the weighted mean of these draw-specific averages.", "Text", ExpressionUUID -> 
             "61a60d23-7e55-af43-a345-cce18379bd6d"],

Cell[BoxData[FormBox[RowBox[{SubscriptBox["W", "i"], "=", SubscriptBox["Z", "i"], "+", 
                SubscriptBox["\[Epsilon]", "i"]}], TraditionalForm]], "DisplayFormula", 
            ExpressionUUID -> "9a9caac9-6b15-624d-90fd-016fdff66d25"],

Cell[BoxData[FormBox[RowBox[{SubscriptBox["T", "k"], "=", SubscriptBox["\[CapitalSigma]", 
                 "k"], "+", "R"}], TraditionalForm]], "DisplayFormula", ExpressionUUID -> 
             "77a8c7d6-f846-5142-b348-11429d283a0e"],

Cell[BoxData[FormBox[RowBox[{"p", "(", "\[Theta]", 
                "|", "\[ScriptCapitalD]", ",", "y", ")", "=", FractionBox[RowBox[{"p", "(", "y", "|", 
                   "\[Theta]", ")", "p", "(", "\[Theta]", "|", "\[ScriptCapitalD]", ")"}], 
                 RowBox[{"p", "(", "y", "|", "\[ScriptCapitalD]", ")"}]]}], TraditionalForm]], 
            "DisplayFormula", ExpressionUUID -> "7ae48b55-1cf7-fe40-9dc1-f4cfa2db60be"],

Cell[BoxData[FormBox[RowBox[{"Q", "=", StyleBox["Pr", FontSlant -> "Plain"], "(", "D", "=", 
                "1", "|", "F", ",", "\[Theta]", ")"}], TraditionalForm]], "DisplayFormula", 
            ExpressionUUID -> "5fe6c1b0-86d4-0f48-a197-fdd11fe37c58"],

Cell[BoxData[FormBox[RowBox[{SuperscriptBox[SubscriptBox["u", "s"], "2"], "=", 
                SubscriptBox[StyleBox["Var", FontSlant -> "Plain"], RowBox[{"\[Theta]", "|", 
                   "\[ScriptCapitalD]", ",", "y"}]], "[", SubscriptBox[OverscriptBox["q", "_"], 
                 "\[Theta]"], "(", "y", ")", "]"}], TraditionalForm]], "DisplayFormula", 
            ExpressionUUID -> "cb885772-711b-cb4b-860b-e375a69ba995"],

Cell[BoxData[FormBox[RowBox[{SuperscriptBox[SubscriptBox["u", "m"], "2"], "=", 
                SubscriptBox[StyleBox["E", FontSlant -> "Plain"], RowBox[{"\[Theta]", "|", 
                   "\[ScriptCapitalD]", ",", "y"}]], "[", SubscriptBox[StyleBox["Var", FontSlant -> 
                   "Plain"], RowBox[{"F", "|", "y", ",", "\[Theta]"}]], "(", "Q", ")", "]"}], 
              TraditionalForm]], "DisplayFormula", ExpressionUUID -> 
             "719fc088-20f6-804d-8799-f07ece96bf61"],

Cell[BoxData[FormBox[RowBox[{SubscriptBox["u", StyleBox["total", FontSlant -> "Plain"]], "=", 
                SqrtBox[RowBox[{SuperscriptBox[SubscriptBox["u", "s"], "2"], "+", SuperscriptBox[
                    SubscriptBox["u", "m"], "2"]}]]}], TraditionalForm]], "DisplayFormula", 
            ExpressionUUID -> "40d33ff1-796f-8241-a6f9-6d4d17872613"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interpret probability and uncertainty", "Section",
 FontSize->24,
 FontColor->RGBColor[0.8, 0.043137254901960784`, 0.00784313725490196],
 CellTags->
  "Uncertainty",ExpressionUUID->"c00d2743-eb06-024d-8e0c-bdba71eb1020"],

Cell["SamplingParameterSD denotes posterior parameter uncertainty conditional on the \
training-data analytical model. MeasurementNewResultSD denotes uncertainty of Q caused by the unobserved \
analytical-error-free FPG for the new individual. Training-reference imprecision affects parameter \
inference and is already included in the parameter component. TotalSD combines these defined components \
by the law of total variance and excludes Bernoulli outcome variability. This decomposition does not \
separate every training measurement contribution from sampling. Bias, preanalytical effects, day-to-day \
biological variation, and uncertainty in the assumed CVs are not identified and are not included in this \
conditional total; fixed CV sensitivity is reported.", "Text", ExpressionUUID -> 
             "bb732cb4-468d-a14b-9cda-9837feffb061"],

Cell["ParameterCredibleInterval gives the \
posterior quantiles of the probability after averaging over the unknown error-free test result within \
each parameter draw. TotalQCredibleInterval also varies the latent test result within each draw. Select \
Parameter or Total Q in the real-data credible interval control under More settings. Both intervals \
describe probabilities on the 0 to 1 scale.", "Text", ExpressionUUID -> 
             "59f046cc-5fce-ee4f-a910-9c55b6fc896c"],

Cell["The calculator reports prior and posterior \
probabilities on the 0 to 1 scale. The headline and tables use this scale for the selected outcome. \
Interval endpoints and standard uncertainties are also in probability units. For nondisease, the \
probability is 1 minus the disease probability and the interval is obtained by complementing the \
endpoints in reverse order. Relative standard uncertainty divides a standard uncertainty by the selected \
outcome probability when that probability is positive.", "Text", ExpressionUUID -> 
             "36917143-c60a-204a-bb54-ed07103182d0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["NHANES reference example", "Section",
 FontSize->24,
 CellTags->"CaseStudy",ExpressionUUID->"11335672-0190-c54c-b496-df7d8479ec92"],

Cell[BoxData[TagBox[GridBox[{{"\"FPG (mg/dL)\"", "\"Probability\"", 
                 "\"Sampling parameter SD\"", "\"New FPG analytical SD\"", "\"Total SD\""}, 
                {"90.`", "0.0057447805653898084`", "0.001060131400449457`", "0.0006556508641683788`", 
                 "0.0012464977504607333`"}, {"100.`", "0.016154095619740946`", "0.0020064878570044084`", 
                 "0.0023118172921329735`", "0.003061126053025451`"}, {"110.`", "0.04469884103928465`", 
                 "0.005020148140238395`", "0.006672146562537891`", "0.008349815992099779`"}, 
                {"120.`", "0.12295120391002734`", "0.01592447332379031`", "0.020692271396493364`", 
                 "0.026110514092722237`"}, {"126.`", "0.22278194041982902`", "0.030610921973813786`", 
                 "0.03363827518302717`", "0.04548144788126228`"}, {"140.`", "0.4640510630063498`", 
                 "0.06762517845333187`", "0.021055018524472283`", "0.07082710332853413`"}, 
                {"160.`", "0.6228844910798806`", "0.07909685332510234`", "0.014006105212013897`", 
                 "0.08032735019370897`"}}, AutoDelete -> False, GridBoxAlignment -> 
                {"Columns" -> {{Left}}}, GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
               GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, FrameStyle -> 
                RGBColor[0., 0.35, 1.], GridBoxBackground -> {"Columns" -> {{None}}, "Rows" -> 
                  {RGBColor[0.92, 0.96, 1.], {GrayLevel[1]}}}, GridBoxSpacings -> {"Columns" -> {{1.2}}, 
                 "Rows" -> {{0.7}}}, GridBoxItemStyle -> {"Rows" -> {Directive[FontWeight -> Plain], 
                   {Directive[FontWeight -> Plain]}}}, BaseStyle -> {FontFamily -> "Source Sans Pro", 
                 FontSize -> 12, FontWeight -> Plain}], "Grid"]], "Output", 
            CellTags -> "FormalCaseStudyTable", ExpressionUUID -> 
             "be9a5dc7-c1bc-d04f-8781-83e7aefd5b8c"],

Cell["With age conditioning off, an FPG of 126 \
mg/dL gives a posterior probability of 0.222782 for the reference endpoint. The sampling parameter, new \
FPG measurement and total standard uncertainties are 0.030611, 0.033638 and 0.045481. The 95% parameter \
credible interval is 0.167982 to 0.285964. The current default Wolfram calculation gives a 95% total-Q \
interval of 0.144341 to 0.320423. The archived calculation reported 0.143984 to 0.322303. Total-Q \
quantiles depend on the random latent test draws. Archived label-invariant rank split R-hat values were \
below 1.0015. At 126 mg/dL the importance ESS was 5933 of 6000, the autocorrelation-ratio ESS was 2817 \
and the probability MCSE was 0.000580. The 32- and 64-node quadrature estimates agreed to numerical \
precision.", "Text", ExpressionUUID -> "c0808eae-f72f-254f-9302-d4c2add93c95"],

Cell[CellGroupData[{

Cell["Reproduce the reference probability", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"adfe9491-6625-2149-b515-\
acbc1e3752ce"],

Cell["\<\
Select Load functions for examples or Start analysis under Use the \
calculator. Evaluate this cell with Shift+Enter to inspect the point \
estimate, both credible intervals and the standard uncertainties. For \
nondisease, take one minus the disease probability and reverse the \
complemented interval endpoints.\
\>", "Text",ExpressionUUID->"b0efc8a5-08fb-8247-b8dc-396dfdcaacb8"],

