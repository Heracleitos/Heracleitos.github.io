If[TrueQ[relative], \\\"Relative uncertainty comparison\\\", \\\"Uncertainty \
comparison\\\"]], \\\": \\\", \\n        If[TrueQ[disease], \\\"disease\\\", \
\\\"nondisease\\\"], If[kind === \\\"Uncertainty\\\", \\n         If[mode === \
\\\"Real\\\", StringJoin[\\\"; \\\", metric, \\\" SD\\\"], \\\"; bootstrap SD\
\\\"], \\\"\\\"]}]; \\n     chart = bduUnifiedSimChart[primitives, \
Flatten[curves, 1], {0, ymax}, ylabel]; \\n     If[mode === \\\"Real\\\", \
chart = chart /. HoldPattern[FrameLabel -> {_, y_}] :> \\n         FrameLabel \
-> {StringJoin[bduAgeAppliedLabel[c[\\\"WithAge\\\"], \\\"PredictorLabel\\\", \
\\\"Test\\\"], \\n            \\\" (\\\", \
bduAgeAppliedLabel[c[\\\"WithAge\\\"], \\\"MeasurementUnit\\\", \\\"original \
scale\\\"], \\\")\\\"], y}]; \\n     Column[{Style[heading, Plain], chart, \
bduHLineLegend[styles, bduAgeComparisonLabels[c], \\n        LegendLayout -> \
\\\"Column\\\", LabelStyle -> {FontFamily -> \\\"Source Sans Pro\\\", \
FontWeight -> Plain, FontColor -> RGBColor[0.10, 0.22, 0.40]}, \\n        \
LegendMarkerSize -> {40, 12}], If[kind === \\\"Probability\\\", \\n        \
Pane[If[mode === \\\"Real\\\", StringJoin[ToString[100*c[\\\"Level\\\"]], \
\\\"% \\\", \\n           If[band === \\\"TotalQCredibleInterval\\\", \
\\\"total-Q\\\", \\\"parameter\\\"], \\n           \\\" credible bands for \
each fit.\\\"], StringJoin[ToString[100*c[\\\"Level\\\"]], \\n           \
\\\"% pointwise bootstrap percentile bands; gaps retain unavailable \
support.\\\"]], 760], \\n        If[mode === \\\"Simulated\\\", \
Pane[\\\"Bootstrap SD is reported only with complete support. \
\\\\\\nUndefined values remain gaps; relative SD uses each curve's own \
probability.\\\", 760], \\\"\\\"]], \\n       bduAgeComparisonNotice[c]}, \
BaseStyle -> {FontFamily -> \\\"Source Sans Pro\\\", FontWeight -> Plain}, \
\\n      Spacings -> 0.7]]; , bduAgeComparisonPlot[_, ___] := \\n   \
\\\"Select Compare with / without age to generate both curves.\\\"; , \\n \
bduAgeComparisonRows[c_Association] := \\n   Flatten[Table[(Join[#1, \
Association[\\\"Scenario\\\" -> scenario, \\\"ComparisonMode\\\" -> \
c[\\\"Mode\\\"], \\n         \\\"ComparisonAge\\\" -> c[\\\"Age\\\"], \
\\\"ComparisonScope\\\" -> c[\\\"Scope\\\"]]] & ) /@ \\n      \
c[scenario][\\\"Curve\\\"], {scenario, {\\\"WithoutAge\\\", \
\\\"WithAge\\\"}}], 1]; , \\n bduAgeDefaultFit = \
