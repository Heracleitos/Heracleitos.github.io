                      ShowStringCharacters -> False], -0.2950109891167426, AutoDelete -> True], 
                    NumberForm[#1, {8, 2}] & ], "\" to \"", TagBox[InterpretationBox[StyleBox[
                      "\"0.91\"", ShowStringCharacters -> False], 0.912908763720933, AutoDelete -> 
                      True], NumberForm[#1, {8, 2}] & ], "\")\""}, "RowDefault"], TemplateBox[
                  {TagBox[InterpretationBox[StyleBox["\"0.59\"", ShowStringCharacters -> False], 
                     0.589668338405319, AutoDelete -> True], NumberForm[#1, {8, 2}] & ], "\" (\"", 
