         wl[[h]] = pi[[h]]*(Exp[-(f - \
m[[h,1]])^2/(2*sig[[h,1,1]])]/Sqrt[sig[[h,1,1]]]); \\n           ws += \
wl[[h]]; gm = m[[h,2]] + (sig[[h,2,1]]/sig[[h,1,1]])*(f - m[[h,1]]); \\n      \
