Sqrt[tot[[j,1,1]]]); like += wo[[j]]; fm[[j]] = m[[j,1]] + \\n             \
(sig[[j,1,1]]/tot[[j,1,1]])*(y - m[[j,1]]); fv[[j]] = sig[[j,1,1]]*\\n        \
     (r[[1,1]]/tot[[j,1,1]])]; wo = wo/like; For[j = 1, j <= k, j++, \\n      \
    gm = m[[j,2]] + (sig[[j,2,1]]/tot[[j,1,1]])*(y - m[[j,1]]); \\n           \
v = sig[[j,2,2]] - sig[[j,2,1]]^2/tot[[j,1,1]]; \\n           mean += \
wo[[j]]*((1 + Erf[(gm - cut)/Sqrt[2*v]])/2); For[a = 1, a <= Length[gh], a++, \
