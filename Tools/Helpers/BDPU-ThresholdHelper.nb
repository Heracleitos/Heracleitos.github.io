           "     ", ButtonBox["Functions and examples", BaseStyle -> "Hyperlink", 
            ButtonData -> "Fitting"], "     ", ButtonBox["Reference example", BaseStyle -> "Hyperlink", 
            ButtonData -> "CaseStudy"], "     ", ButtonBox["Archived holdout", BaseStyle -> "Hyperlink", 
            ButtonData -> "Holdout"], "     ", ButtonBox["Numerical checks", BaseStyle -> "Hyperlink", 
            ButtonData -> "Checks"], "\n", ButtonBox["Scope", BaseStyle -> "Hyperlink", 
            ButtonData -> "Scope"], "     ", ButtonBox["Model", BaseStyle -> "Hyperlink", 
            ButtonData -> "Model"], "     ", ButtonBox["Uncertainty", BaseStyle -> "Hyperlink", 
            ButtonData -> "Uncertainty"], "     ", ButtonBox["Notation", BaseStyle -> "Hyperlink", 
            ButtonData -> "Notation"], "     ", ButtonBox["Implementation", BaseStyle -> "Hyperlink", 
            ButtonData -> "Implementation"]}], "Text", ExpressionUUID -> 
          "04731542-59cb-a542-b4dc-f7bbb5be3644"]
}, Open  ]],

