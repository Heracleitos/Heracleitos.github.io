Cell[CellGroupData[{

Cell["Read a saved curve", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"df6791a3-2a8a-4341-b7c3-\
d5a150d368be"],

Cell["\<\
lCDefaultCurve[lcDefaultCurves, level] returns the saved curve for 0.90, 0.95 \
or 0.99. Its grid and points are paired. The following cell reads the \
archived point at 126 mg/dL. lCCurveValidQ[curve] checks the stored \
probabilities, complementary bounds and variance decomposition.\
\>", "Text",
 CellChangeTimes->{{4.004319078478422*^9, 4.004319080002449*^9}, {
  4.0043191632089634`*^9, 
  4.0043191632099705`*^9}},ExpressionUUID->"4483077b-590d-ed4c-be51-\
770c2627406d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Read", " ", "the", " ", "archived", " ", "point"}], ";", " ", 
    RowBox[{
     RowBox[{"a", " ", "fresh", " ", "total"}], "-", 
     RowBox[{"Q", " ", "draw", " ", "can", " ", "have", " ", "different", " ", 
      RowBox[{"endpoints", "."}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", "=", 
      RowBox[{"lCDefaultCurve", "[", 
       RowBox[{"lcDefaultCurves", ",", "0.95`"}], "]"}]}], "}"}], ",", 
    RowBox[{"KeyTake", "[", 
     RowBox[{
      RowBox[{"SelectFirst", "[", 
       RowBox[{
        RowBox[{"c", "[", "\"\<points\>\"", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#1", "[", "\"\<value\>\"", "]"}], "\[Equal]", "126.`"}], 
         "&"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<value\>\"", ",", "\"\<probability\>\"", 
        ",", "\"\<parameter_interval\>\"", ",", "\"\<total_q_interval\>\""}], 
       "}"}]}], "]"}]}], "]"}]}]], "Input",
 Evaluatable->True,
 CellChangeTimes->{4.0043190816648407`*^9, 4.0043191645344696`*^9},
 CellTags->"lCExampleCurve",
 CellLabel->
  "In[277]:=",ExpressionUUID->"1356781f-a733-ba4f-b1c5-dbdeff55ca78"],

Cell[BoxData[
 TemplateBox[{
  "KeyTake", "invrl", 
   "\"The argument \\!\\(\\*RowBox[{\\\"Missing\\\", \\\"[\\\", \
\\\"\\\\\\\"NotFound\\\\\\\"\\\", \\\"]\\\"}]\\) is not a valid Association \
or a list of rules.\"", 2, 277, 8, 24686132622956226923, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{4.0043642641388836`*^9},
 CellTags->"lCExampleCurve",
 CellLabel->
  "During evaluation of \
In[277]:=",ExpressionUUID->"2c0d673e-5b06-5a4e-9ce5-cf1e20387242"],

Cell[BoxData[
 RowBox[{"KeyTake", "[", 
  RowBox[{
   RowBox[{"Missing", "[", "\<\"NotFound\"\>", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\<\"value\"\>", ",", "\<\"probability\"\>", 
     ",", "\<\"parameter_interval\"\>", ",", "\<\"total_q_interval\"\>"}], 
    "}"}]}], "]"}]], "Output",
 CellChangeTimes->{4.004364264144884*^9},
 CellTags->"lCExampleCurve",
 CellLabel->
  "Out[277]=",ExpressionUUID->"5acdcf6c-8216-494f-a45f-eae20867cb52"]
}, Open  ]]
