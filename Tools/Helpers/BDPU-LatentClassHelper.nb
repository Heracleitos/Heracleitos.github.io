Cell[CellGroupData[{

Cell["Accuracy at an assay threshold", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"c93d4912-9719-1f4f-9b86-\
d2d844446e68"],

Cell["\<\
lCAccuracy[fit, threshold, level] returns model-implied sensitivity and \
specificity for an observed first-assay threshold. For each posterior draw, \
the calculation evaluates the observed-assay normal upper tail for class 1 \
and the lower tail for class 0. It averages each tail across draws and \
reports its interval.\
\>", "Text",
 CellChangeTimes->{{4.0043190754415283`*^9, 
  4.0043190754415283`*^9}},ExpressionUUID->"9c435f09-0767-8743-a0a3-\
7393a1808692"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"lCAccuracy", "[", 
  RowBox[{"lcDefaultFit", ",", "126.`", ",", "0.95`"}], "]"}]], "Input",
 Evaluatable->True,
 CellChangeTimes->{4.004319076850666*^9, 4.0043191609789696`*^9},
 CellTags->"lCExampleAccuracy",
 CellLabel->
  "In[276]:=",ExpressionUUID->"5c7e5261-a6d0-a343-9365-8f2b1a3f3b6b"],

Cell[BoxData[
 RowBox[{"lCAccuracy", "[", 
  RowBox[{"lcDefaultFit", ",", "126.`", ",", "0.95`"}], "]"}]], "Output",
 CellChangeTimes->{4.004364264093546*^9},
 CellTags->"lCExampleAccuracy",
