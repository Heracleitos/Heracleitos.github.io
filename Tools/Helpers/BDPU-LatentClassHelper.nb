Cell[CellGroupData[{

Cell["Sources and scope", "Section",
 FontSize->24,
 FontColor->RGBColor[0.8, 0.043137254901960784`, 0.00784313725490196],
 CellTags->"Sources",ExpressionUUID->"c8a914ca-54ef-ce4a-b204-fc3dca32a881"],

Cell[TextData[{
 "Chatzimichail T, Chatzimichail RA, Hatjimihail AT. ",
 StyleBox["Latent class probabilities and uncertainty estimation without a \
gold standard",
  FontSlant->"Italic"],
 ". Technical Report XXXII. Hellenic Complex Systems Laboratory; 2026. ",
 ButtonBox["https://www.doi.org/10.5281/zenodo.24447301",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.doi.org/10.5281/zenodo.24447301"], None},
  ButtonNote->"https://www.doi.org/10.5281/zenodo.24447301"],
 "\n\tSee the accompanying technical report for the complete case study and \
its research scope."
}], "Text",
 CellChangeTimes->{{4.0042484303612976`*^9, 4.0042484797675896`*^9}, 
   4.004249838305977*^9, 4.004249871145035*^9, {4.004251715826769*^9, 
   4.0042517405552692`*^9}, {4.0043639367303886`*^9, 4.004363994337452*^9}, {
   4.0043641150741863`*^9, 
   4.0043641325236073`*^9}},ExpressionUUID->"1b84de38-9b2c-374f-97ae-\
e5f5a06e3997"],

Cell[TextData[{
 "National Center for Health Statistics. ",
 ButtonBox["NHANES 2013\[Dash]2014 examination and laboratory data",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://wwwn.cdc.gov/nchs/nhanes/continuousnhanes/default.aspx?\
BeginYear=2013"], None}],
 ". \n\tThe case study uses paired fasting and two-hour glucose measurements."
}], "Text",
 CellChangeTimes->{{4.004251746938156*^9, 
  4.0042517474661713`*^9}},ExpressionUUID->"228ee0a2-438c-6645-bb43-\
fd9294ae9e42"],

Cell[TextData[{
 "Hui SL, Walter SD (1980). ",
 ButtonBox["Estimating the error rates of diagnostic tests",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://pubmed.ncbi.nlm.nih.gov/7370371/"], None}],
 ". Biometrics 36, 167\[Dash]171. \n\tFoundational work on diagnostic-test \
estimation with latent class membership."
}], "Text",
 CellChangeTimes->{{4.004251757002159*^9, 
  4.00425175824218*^9}},ExpressionUUID->"0add8c86-d801-4a49-8ab7-\
1df526ffa616"],

Cell["The paired-assay \
latent-class endpoint differs from a measured reference-threshold endpoint. \
Results from reference-threshold, age-adjusted and simulation analyses \
address different questions. The present calculator estimates the two-class \
quantitative model described above.", "Text", ExpressionUUID -> 
             "49878377-255c-ee43-bfcf-0831d192eb3d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Notation",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 0.00784313725490196]]], "Section",
 FontSize->24,
 FontColor->RGBColor[
  0.7914854657816434, 0.31950865949492635`, 0.09958037689784084],
 CellTags->"Notation",ExpressionUUID->"8681dea1-7e77-454b-8add-17020fb0328b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bb80a4c9-b661-c34f-aea7-c8bf55263496"],
 " : Observed assay-1 result\n",
 Cell[BoxData[
  FormBox["D", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "f82dc7a1-cc0a-1642-8a37-9904ba68d581"],
 " : Latent class\n",
 Cell[BoxData[
  FormBox["d", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4222f24a-3e0e-c54a-86be-dfcbdd864624"],
 " : Class index (0 or 1)\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "(", "x", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e2e6d877-64b9-7c43-a78f-5a0ff41933c8"],
 " : Posterior probability of latent class 1\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", "p", "(", "x", ")"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"0bfe6866-efb6-c34b-8c5e-69efc8084347"],
 " : Posterior probability of latent class 0\n",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "6bf736f9-27bb-3940-8ba4-97f0d35307da"],
 " : Class-1 probability conditional on the latent new-test value and model \
parameters\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", 
    StyleBox["parameter",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "1d21c711-d5c7-ef43-893a-44cf953bcdb2"],
 " : Parameter standard uncertainty\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", 
    StyleBox["measurement",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "222847cc-892e-4e43-beaf-ac8a76f8c1bb"],
 " : New-result measurement standard uncertainty\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", 
    StyleBox["Q",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "21369e56-4384-e84b-9cca-96b40235d787"],
 " : Total standard uncertainty\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["CV", 
    StyleBox["j",
     FontSlant->"Plain"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "0a981cc6-40a6-634e-8637-3635716e35bd"],
 " : Fixed analytical coefficient of variation for assay j, expressed as a \
fraction\n",
 Cell[BoxData[
  FormBox["R", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "11a6b5a6-5e6f-8540-b84e-e12a7f863ac1"],
 " : Analytical-error covariance matrix\n",
 Cell[BoxData[
  FormBox["\[Theta]", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "dcd9ca3a-a9ef-fa44-914b-b345e60395ad"],
 " : Model parameters\n",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ab021476-9a13-5949-a635-40c4100c2e3d"],
 " : Number of training observations\n",
 Cell[BoxData[
  FormBox["S", TraditionalForm]], "InlineFormula",ExpressionUUID->
  "4020bfa2-ec71-1c4d-a937-8e5c155c0357"],
 " : Number of retained posterior draws\nMCMC settings : Iterations, burn-in, \
thinning, and seed\nImportance ESS : Effective sample size after \
predictive-likelihood weighting\nCredible level : Posterior probability mass \
of the credible interval\nParameter interval : Credible interval for \
probability averaged over latent new-test uncertainty\nTotal-Q interval : \
Credible interval for conditional probability across posterior parameter and \
latent new-test draws\n",
 Cell[BoxData[
  FormBox["y", TraditionalForm]], "InlineFormula",ExpressionUUID->
