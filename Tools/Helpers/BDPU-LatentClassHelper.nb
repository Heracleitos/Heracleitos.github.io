     "saved", " ", "fit", " ", "once"}], ",", " ", 
    RowBox[{"then", " ", "select", " ", "the", " ", "result", " ", 
     RowBox[{"fields", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
