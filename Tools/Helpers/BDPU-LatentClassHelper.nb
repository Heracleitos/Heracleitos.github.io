Cell[CellGroupData[{

Cell[TextData[StyleBox["Use the calculator",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 0.00784313725490196]]], "Section",
 FontSize->24,
 FontColor->RGBColor[
  0.11999694819562066`, 0.2899977111467155, 0.39000534065766385`],
 CellTags->"Start",ExpressionUUID->"15540a3d-f868-2445-9c18-e69fb7022847"],

Cell["\<\
The reference model was fitted to paired fasting plasma glucose (FPG) and \
two-hour oral glucose tolerance test glucose (OGTT). A new prediction needs \
only the observed FPG. Class 1 is the latent class with the higher mean log \
FPG.\
\>", "Text",ExpressionUUID->"76b00626-5dce-0e4f-ba03-f3e92b44e842"],

Cell[BoxData[
 DynamicModuleBox[{message$$, busy$$, companion$$}, 
  TagBox[GridBox[{
     {
      TemplateBox[{
        ButtonBox[
        "\"Open calculator\"", ButtonFunction :> With[{path$ = FileNameJoin[{
               NotebookDirectory[
                EvaluationNotebook[]], 
               "BayesianDiagnosticProbabilityAndUncertainty.nb"}]}, 
           If[
            TrueQ[
             companion$$[path$, False]], 
            NotebookOpen[path$], message$$ = 
            "Place the matching BDPU-LC calculator notebook in the same \
folder as this helper."]], Method -> "Queued", Appearance -> Automatic, 
         Evaluator -> Automatic], 
        TemplateBox[{12}, "Spacer1"], 
        ButtonBox["\"Load functions for examples\"", ButtonFunction :> If[
           Not[
            TrueQ[busy$$]], busy$$ = True; 
           message$$ = "Loading functions and the reference fit..."; 
           message$$ = If[
              TrueQ[
               CheckAbort[
                companion$$[
                 FileNameJoin[{
                   NotebookDirectory[
                    EvaluationNotebook[]], 
                   "BayesianDiagnosticProbabilityAndUncertainty.nb"}], True], 
                False]], 
              "Functions are ready. Select an example input cell and press \
Shift+Enter.", 
              "Loading failed. Keep both updated notebooks together and try \
again."]; busy$$ = False], Enabled -> Dynamic[
           Not[
            TrueQ[busy$$]]], Method -> "Queued", Appearance -> Automatic, 
         Evaluator -> Automatic]},
       "RowDefault"]},
     {
      DynamicBox[ToBoxes[
        If[
         And[
          StringQ[message$$], message$$ =!= ""], message$$, 
         Spacer[{0, 0}]], StandardForm],
       ImageSizeCache->{0., {0., 0.}},
       TrackedSymbols:>{message$$}]}
    },
    DefaultBaseStyle->"Column",
    GridBoxAlignment->{"Columns" -> {{Left}}},
    GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
    GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{0.4}}}],
   "Column"],
  DynamicModuleValues:>{},
  Initialization:>(companion$$ = Function[{file, initialize}, 
     Module[{book, engine}, If[
        Not[
         FileExistsQ[file]], 
        Return[False, Module]]; book = Quiet[
         Check[
          Get[file], $Failed]]; If[Head[book] =!= Notebook, 
        Return[False, Module]]; engine = Cases[
         First[book], Condition[
           Cell[
            BoxData[
             Pattern[boxes, 
              Blank[]]], "Input", 
            Pattern[opts, 
             BlankNullSequence[]]], 
           MemberQ[{opts}, CellTags -> "BDPUlCStandaloneInitialization"]] :> 
         boxes, Infinity]; If[Length[engine] =!= 1, 
        Return[False, Module]]; If[
        Not[
         TrueQ[initialize]], 
        Return[True, Module]]; And[
        Block[{$Context = "Global`", $ContextPath = {"System`", "Global`"}}, 
         Quiet[
          Check[ToExpression[
             First[engine], StandardForm]; True, False]]], 
        And[
        DownValues[lCProbability] =!= {}, 
         DownValues[lCPriorProbability] =!= {}, DownValues[lCFit] =!= {}, 
         AssociationQ[ngsDefaultFit], 
         AssociationQ[ngsDefaultRecord], 
         AssociationQ[ngsDefaultCurves], 
         TrueQ[ngsDefaultFit["model"] == "BDPU-LC-0.1"]]]]]),
  SynchronousInitialization->True,
  UnsavedVariables:>{message$$, busy$$, companion$$}]], "Output",
 GeneratedCell->False,
 CellAutoOverwrite->False,
 FontWeight->"Plain",
 CellTags->
  "lCHelperStart",ExpressionUUID->"2208f7dd-c54f-5649-bf53-d0d8bb2185de"],

Cell["\<\
Keep the two notebooks in the same folder. Open calculator opens the main \
notebook. To run the examples here in a fresh kernel, choose Load functions \
for examples. This loads the functions and embedded reference fit from the \
companion calculator.\
\>", "Text",ExpressionUUID->"1dcfe286-5d9f-df49-9b16-499480803cf0"],

Cell[CellGroupData[{

Cell["Calculate a probability", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"c372cb41-b61d-b64e-be1f-\
3656428e772f"],

Cell["\<\
In the calculator, choose Start analysis. Review the active dataset, enter an \
observed first-assay result in the displayed units and choose an interval \
level. Select Calculate probabilities to apply the inputs. For the reference \
model, use FPG 126 mg/dL and a 95% credible interval.\
\>", "Text",ExpressionUUID->"398d64e2-9f7e-a940-a62b-3871ebdca807"],

Cell["\<\
The headline gives the class-1 probability before and after the observation, \
both as decimals on the 0 to 1 scale. The fitted pretest probability is the \
mean class-1 mixture weight across posterior draws. Tables gives both \
classes, the parameter and total-Q intervals, and the uncertainty components. \
Class 0 has probability 1 minus the class-1 probability and reflected \
interval limits.\
\>", "Text",ExpressionUUID->"9329bfe6-cfc5-f945-9c96-30782ca503a2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Explore curves and save a result", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"5c541f2f-823f-1a43-ab6a-\
f39c64f0a1fa"],

Cell["\<\
In Plots, set positive lower and upper assay limits, select 3 to 201 regular \
grid nodes and choose Generate curves. When the applied observation lies \
inside the range, the plot includes its exact value. The table remains \
available for observations outside the displayed range.\
\>", "Text",ExpressionUUID->"4585f075-fff7-eb45-9654-9c3db8470230"],

Cell["\<\
Export result writes the applied record to JSON. Restore reference returns to \
the embedded NHANES analysis. A newly opened calculator starts with the \
reference fit.\
\>", "Text",ExpressionUUID->"b442cd7c-bd57-c54c-9f75-343a51a16da1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Model and posterior conditioning",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 0.00784313725490196]]], "Section",
 FontSize->24,
 FontColor->RGBColor[0.12, 0.29, 0.39],
 CellTags->"Model",ExpressionUUID->"40184b46-1f9c-f74f-9470-b81e48dab176"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Latent classes and assay error",
 FontSize->20,
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 0.00784313725490196]]], "Subsection",
 FontSize->16,
 FontColor->RGBColor[
  0.21, 0.34, 0.42],ExpressionUUID->"7f473582-e2ce-6846-b725-804bee107222"],

Cell["Let D denote \
an unobserved binary class, Z the latent pair of log concentrations and Y the \
observed log pair. Conditional on class d, Z is bivariate normal with mean \
vector \[Mu]d and covariance \[CapitalSigma]d. Independent analytical error \
adds a diagonal variance matrix R on the log scale. Each diagonal element is \
log(1 + CV squared) for the corresponding assay.", "Text", ExpressionUUID -> 
                "8fad82b2-be03-9143-bd51-0be7d0f3b222"],

Cell[BoxData[
                FormBox[RowBox[{RowBox[{RowBox[{SubscriptBox["Y", "i"], " ", 
                       "|", " ", RowBox[{RowBox[{SubscriptBox["D", "i"], " ", 
                          RowBox[{"=", " ", "d"}]}], "\[Tilde]", " ", 
                         RowBox[{RowBox[{"\[ScriptCapitalN]", "("}], 
                          SubscriptBox["\[Mu]", "d"]}]}]}], ",", " ", 
                     RowBox[{SubscriptBox["\[CapitalSigma]", "d"], " ", 
                       RowBox[{"+", " ", "R"}]}]}], ")"}], TraditionalForm]], 
               "DisplayFormula", ExpressionUUID -> 
                "0e0f55ce-11f7-f14a-a13e-2025a96a89db"],

Cell["The full \
covariance model allows assay dependence within each class. Class 1 has the \
higher mean log concentration on the first assay. Neither assay supplies an \
error-free reference label. The observed second assay contributes to fitting \
through the joint likelihood.", "Text", ExpressionUUID -> 
                "51ddfb04-a7f7-2c49-8259-8a5f9ce291e3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Posterior weighting for one new result",
 FontSize->20,
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 0.00784313725490196]]], "Subsection",
 FontSize->16,
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"f407bf78-9e91-f941-a907-\
aada407385ac"],

Cell["For a positive \
observed concentration x, let y = log x. For posterior draw s, let \[Pi]ds be \
the class proportion and fds(y) the marginal observed log-assay density for \
class d. The predictive density hs is the sum of the two class-weighted \
densities. The class-1 probability across equally weighted posterior draws \
is", "Text", ExpressionUUID -> "edfc38d6-1252-444c-83aa-6583765e388a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"p", "(", "x", ")"}], " ", "=", " ", 
    FractionBox[
     RowBox[{
      UnderscriptBox["\[Sum]", "s"], 
      SubscriptBox["\[Pi]", 
       RowBox[{"1", "s"}]], 
      SubscriptBox["f", 
       RowBox[{"1", "s"}]], 
      RowBox[{"(", "y", ")"}]}], 
     RowBox[{
      UnderscriptBox["\[Sum]", "s"], 
      SubscriptBox["h", "s"]}]]}], ",", "     ", 
   RowBox[{
    SubscriptBox["h", "s"], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Pi]", 
       RowBox[{"0", "s"}]], 
      SubscriptBox["f", 
       RowBox[{"0", "s"}]], 
      RowBox[{"(", "y", ")"}]}], " ", "+", " ", 
     RowBox[{
      SubscriptBox["\[Pi]", 
       RowBox[{"1", "s"}]], 
      SubscriptBox["f", 
       RowBox[{"1", "s"}]], 
      RowBox[{"(", "y", ")"}]}]}]}]}], TraditionalForm]], "DisplayFormula",Exp\
ressionUUID->"1523890f-55ff-224b-96cc-8f9d80a90f83"],

Cell["Thus a \
parameter draw receives more weight when it predicts the observed assay value \
more readily. The parameter interval uses quantiles of the per-draw class \
probability under these weights. Here and below, all predictions also \
condition on the training data.", "Text", ExpressionUUID -> 
                "30ead304-9e3e-fd47-a342-bef1b02ad519"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Interpret probability and uncertainty",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 0.00784313725490196]]], "Section",
 FontSize->24,
 FontColor->RGBColor[0.12, 0.29, 0.39],
 CellTags->
  "Uncertainty",ExpressionUUID->"e7264fea-5c13-4b43-8d6b-5ca501823ea8"],

Cell["Define Q as the \
class-1 probability conditional on the latent first-assay value and the model \
parameters \[Theta]. Its posterior variance at the new observation has two \
components.", "Text", ExpressionUUID -> 
             "af04e5b9-16ce-2946-affc-b0c8b6535f6a"],

Cell[BoxData[FormBox[RowBox[{SuperscriptBox[SubscriptBox["u", 
                  "Q"], "2"], " ", "=", " ", RowBox[{SuperscriptBox[
                   SubscriptBox["u", "parameter"], "2"], " ", "+", " ", 
                  SuperscriptBox[SubscriptBox["u", "measurement"], "2"]}]}], 
              TraditionalForm]], "DisplayFormula", ExpressionUUID -> 
             "d31916f5-0b7d-4641-94e6-dbb8b2ff8d5e"],

Cell["Parameter \
variance is the posterior variance of E[Q | y, \[Theta]] across draws \
conditioned on y. New-result measurement variance is the posterior mean of \
Var(Q | y, \[Theta]). The square root of each variance gives the \
corresponding standard uncertainty in probability units. For nonzero total \
variance, the calculator also reports the percentage attributable to each \
component. A zero first-assay analytical CV makes the new-result measurement \
variance zero.", "Text", ExpressionUUID -> 
             "d91cc53e-5b3d-9248-812f-3c01252f9db0"],

Cell["The total-Q \
interval uses posterior simulated values of Q and includes both \
contributions. The calculator draws the latent first-assay values in seeded \
order and evaluates the two class densities for the sampled values together. \
It excludes future Bernoulli outcome variation, uncertainty about clinical \
class meaning, structural model uncertainty and uncertainty in the fixed CVs. \
Changing the interval level changes the quantiles. It does not change the \
mean probability or its standard uncertainties.", "Text", ExpressionUUID -> 
             "7a6bfe17-728c-0a43-bbd2-7ed977aed3b7"],

Cell["Curves connect \
calculated nodes. The limits at each node are pointwise credible limits. They \
do not provide simultaneous coverage of the entire curve. An ordered pair of \
class means does not impose monotonicity of the posterior class probability \
across observed values.", "Text", ExpressionUUID -> 
             "4361642e-1cd9-f441-9ca2-a3bc32f6507e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["NHANES reference example", "Section",
 FontSize->24,
 FontColor->RGBColor[0.8, 0.043137254901960784`, 0.00784313725490196],
 CellTags->"Reference",ExpressionUUID->"62fbe35c-34ec-3345-99a3-9486040776d0"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Cohort and fit",
 FontSize->20,
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 0.00784313725490196]]], "Subsection",
 FontSize->16,
 FontColor->RGBColor[
  0.21, 0.34, 0.42],ExpressionUUID->"0365d67f-1083-6c46-89b6-3be54c234665"],

Cell["The selected NHANES 2013\[Dash]2014 cohort had 1,702 \
paired FPG and OGTT observations. A split stratified on measured OGTT status \
produced 1,361 training pairs and 341 held-out pairs. The original split \
indicator was OGTT at least 200 mg/dL. Only the measurements enter the fitted \
likelihood. No survey weights enter this analysis.", "Text", 
               ExpressionUUID -> "92ccbb8d-6e35-9e47-8abe-a51fe85c8494"],

Cell["The bundled fit uses four chains with seeds 72101 through \
72104. Each chain ran for 6,500 iterations with 2,000 discarded and every \
third subsequent draw retained, giving 6,000 draws in total. Fixed analytical \
CVs are 0.01332098 for FPG and 0.01023046 for OGTT. The second CV is an \
assumed proxy.", "Text", ExpressionUUID -> 
                "8506a3f1-476c-ad45-b146-6593cd5ba504"],

Cell["The reference \
Dirichlet prior on the class weights has concentration parameters (1, 1). The \
location centers before log transformation are (90, 95) and (130, 180) mg/dL. \
The normal-inverse-Wishart parameters are \[Kappa] = 0.1, \[Nu] = 4 and \
diagonal scale entries (0.04, 0.25). Proposals must preserve the class \
ordering and positive-definite latent covariance after subtraction of the \
analytical-error covariance.", "Text", ExpressionUUID -> 
                "a73117cf-d1f5-8a4b-815f-72b48e9f4f75"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Read the saved result",
 FontSize->20]], "Subsection",
 FontSize->16,
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"52b642c2-496b-964d-81f9-\
aca571aece50"],

Cell["The fitted class-1 probability before observing FPG is \
0.0654. At FPG 126 mg/dL the posterior probability is 0.4411. The 95% \
parameter interval is 0.2041 to 0.6843. Parameter, new-result measurement and \
total-Q standard uncertainties are 0.1218, 0.0815 and 0.1466. The ratio \
estimate has Monte Carlo standard error of about 0.0042.", "Text", 
               ExpressionUUID -> "c6ca479d-a3fc-7940-b744-5e6926c52f95"],

Cell["The saved reference realization gives a 95% total-Q \
interval of 0.1794 to 0.7371. It uses 24,000 draws and seed 8271. Calculate \
probabilities uses the Wolfram random-number stream with the same draw count \
and seed. With this posterior at 126 mg/dL, the Wolfram 15.0.1 calculation \
gives 0.1752 to 0.7396. The three default curves retain saved records at 103 \
nodes from 67 to 333 mg/dL, including 110 and 126 mg/dL. Each level uses the \
same grid.", "Text", ExpressionUUID -> 
                "c016b8f1-30df-3f41-9eec-8f471888eec7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Check assumptions",
 FontSize->20]], "Subsection",
 FontSize->16,
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"80bf8029-4ad1-2f4f-b39a-\
083475bb2202"],

Cell["An exploratory diagonal-covariance fit changed the \
class-1 probability at 126 mg/dL from 0.4411 to 0.6659. The held-out joint \
log score of \[Minus]8.6080 per participant measures prediction of the paired \
observed concentrations. The selected cohort and the class definition limit \
clinical and population interpretation.", "Text", ExpressionUUID -> 
                "3193b909-6a19-2643-b0b8-fe42aab1c363"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fit custom data", "Section",
 FontSize->24,
 FontColor->RGBColor[0.8, 0.043137254901960784`, 0.00784313725490196],
 CellTags->"Custom",ExpressionUUID->"39a6685a-73b0-904e-a32a-53bed0eaf3d9"],

Cell["\<\
In Data and model, prepare a headerless CSV with at least 20 complete rows \
and exactly two positive numeric columns in assay-1, assay-2 order. Enter the \
assay names and units, analytical CVs as fractions, and the prior settings. \
The prior centers use the units of their respective assay columns.\
\>", "Text",ExpressionUUID->"34614867-88a7-d54b-ae0b-f4c773ea9678"],

Cell["\<\
Select the covariance structure, iterations, burn-in, thinning and seed. \
Choose Import CSV and fit one exploratory chain. After a successful fit, \
enter a first-assay value and select Calculate probabilities. A failed import \
or fit leaves the previous fit active. Changes to the paired data, analytical \
CVs, dependence structure or prior settings require a new fit. Assess \
convergence across several independent chains and examine sensitivity to the \
model assumptions.\
\>", "Text",ExpressionUUID->"3a3729bc-457b-754e-9593-843c2db8a5c6"],

Cell["\<\
For imported data the record identifies the CSV by the SHA-256 hash of its \
source bytes. The fit fingerprint uses a key-sorted Wolfram RawJSON \
serialization. Both the result and its provenance are retained by Export \
result.\
\>", "Text",ExpressionUUID->"758aeabd-c190-f246-87e4-1aeb8cca5cbf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Callable functions and examples", "Section",
 FontSize->24,
 CellTags->"Examples",ExpressionUUID->"b6f2abf4-8156-2e4c-b71d-1092660b295a"],

Cell["\<\
Select Load functions for examples above, then select an input cell and press \
Shift+Enter. Each example runs independently. The functions accept credible \
levels as fractions, for example 0.95. They return numeric probabilities and \
limits on the 0 to 1 scale.\
\>", "Text",ExpressionUUID->"f0daf43d-4837-2242-ab30-0b19e2a61edf"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Pretest and posterior probabilities",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 0.00784313725490196]]], "Subsection",ExpressionU\
UID->"b3ac8742-0faa-4344-a43b-469cc305dac8"],

Cell["\<\
lCPriorProbability[fit] returns the fitted probability of class 1 before a \
new result. lCProbability[fit, value] conditions on a positive observed \
first-assay concentration. The Level option sets the interval mass. The \
example uses the full saved posterior.\
\>", "Text",
 CellChangeTimes->{{4.0043190643678513`*^9, 
  4.0043190660666103`*^9}},ExpressionUUID->"bb2801e6-19be-834a-9cb7-\
d5ae36a1fe18"],

