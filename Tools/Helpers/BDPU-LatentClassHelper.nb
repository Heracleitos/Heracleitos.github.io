Cell[CellGroupData[{

Cell["Fit a paired dataset", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"69fc58b2-c0c7-9941-81cb-\
9fa5014c4ba2"],

Cell["\<\
lCFit[pairs, options] takes an n by 2 numeric matrix of paired assay \
concentrations. Its default priors and analytical CVs are those of the \
reference analysis. AnalyticalCV supplies a two-element list of fractions, \
PriorMeans supplies two pairs of centers in original assay units and \
Dependence selects full or diagonal covariance. Options[lCFit] lists all \
settings.\
\>", "Text",
 CellChangeTimes->{{4.0043190829854393`*^9, 
  4.00431908576182*^9}},ExpressionUUID->"b024408d-21ad-8449-a2b3-\
5d1358831048"],

Cell["\<\
This short example uses the first 60 embedded pairs and a single seeded chain \
to demonstrate the call. It returns the row count and the number of retained \
draws. Use suitable priors and compare longer independent chains for \
inference.\
\>", "Text",ExpressionUUID->"1b33b5c1-60f5-5f4b-9e3b-f1aa01ac9017"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"f", "=", 
     RowBox[{"lCFit", "[", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{"lcTrainingData", ",", "60"}], "]"}], ",", 
       RowBox[{"\"\<Iterations\>\"", "\[Rule]", "150"}], ",", 
       RowBox[{"\"\<BurnIn\>\"", "\[Rule]", "50"}], ",", 
       RowBox[{"\"\<Thin\>\"", "\[Rule]", "2"}], ",", 
       RowBox[{"\"\<Seed\>\"", "\[Rule]", "72101"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FailureQ", "[", "f", "]"}], ",", "f", ",", 
     RowBox[{"Association", "[", 
      RowBox[{
       RowBox[{"\"\<training_rows\>\"", "\[Rule]", 
        RowBox[{"f", "[", "\"\<n\>\"", "]"}]}], ",", 
       RowBox[{"\"\<retained_draws\>\"", "\[Rule]", 
        RowBox[{"Length", "[", 
         RowBox[{"f", "[", "\"\<draws\>\"", "]"}], "]"}]}]}], "]"}]}], 
    "]"}]}], "]"}]], "Input",
 Evaluatable->True,
 CellChangeTimes->{4.0043190877624435`*^9, 4.00431917345269*^9},
 CellTags->"lCExampleFit",
 CellLabel->
  "In[278]:=",ExpressionUUID->"6d1c45a1-d72a-5646-8a6f-3764b910165d"],

Cell[BoxData[
 TemplateBox[{
  "Take", "take", 
   "\"Cannot take positions \\!\\(\\*RowBox[{\\\"1\\\"}]\\) through \
\\!\\(\\*RowBox[{\\\"60\\\"}]\\) in \\!\\(\\*RowBox[{\\\"lcTrainingData\\\"}]\
\\).\"", 2, 278, 9, 24686132622956226923, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{4.004364264191551*^9},
 CellTags->"lCExampleFit",
 CellLabel->
  "During evaluation of \
In[278]:=",ExpressionUUID->"5195167f-392f-e14d-9d48-df061f7ecccd"],

