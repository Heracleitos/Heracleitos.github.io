 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r", "=", 
     RowBox[{"lCProbability", "[", 
      RowBox[{"lcDefaultFit", ",", "126.`", ",", 
       RowBox[{"\"\<Level\>\"", "\[Rule]", "0.9`"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"KeyTake", "[", 
    RowBox[{"r", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<level\>\"", ",", "\"\<probability\>\"", 
       ",", "\"\<parameter_sd\>\"", ",", "\"\<measurement_sd\>\"", 
       ",", "\"\<total_sd\>\"", ",", "\"\<parameter_interval\>\"", 
       ",", "\"\<total_q_interval\>\""}], "}"}]}], "]"}]}], "]"}]], "Input",
