Cell[CellGroupData[{

Cell["Export a calculated record", "Subsection",
 FontColor->RGBColor[
  0.8, 0.043137254901960784`, 
   0.00784313725490196],ExpressionUUID->"e24389ab-d8af-6a44-9f4a-\
aec9dc144342"],

Cell["\<\
lCRecord[fit, metadata, value, level] packages the calculated point with its \
applied settings, fit fingerprint and dataset information. \
lCExportRecord[path, record] writes this association to JSON. This example \
creates a new temporary folder and returns the full path.\
\>", "Text",
 CellChangeTimes->{{4.0043190891731052`*^9, 
  4.0043190905685062`*^9}},ExpressionUUID->"6ab36ccc-3d26-8f43-a997-\
4bc2c78df4f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r", "=", 
     RowBox[{"lCRecord", "[", 
      RowBox[{"lcDefaultFit", ",", 
       RowBox[{"lcDefaultRecord", "[", "\"\<dataset\>\"", "]"}], ",", "126.`",
        ",", "0.95`"}], "]"}]}], "}"}], ",", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"FailureQ", "[", "r", "]"}], ",", "r", ",", 
     RowBox[{"lCExportRecord", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"CreateDirectory", "[", "]"}], 
          ",", "\"\<BDPUlC-result.json\>\""}], "}"}], "]"}], ",", "r"}], 
      "]"}]}], "]"}]}], "]"}]], "Input",
 Evaluatable->True,
 CellChangeTimes->{{4.0043190228515625`*^9, 4.00431903297682*^9}, {
  4.0043191803674564`*^9, 4.004319181447489*^9}},
 CellTags->"lCExampleExport",
 CellLabel->
  "In[279]:=",ExpressionUUID->"bf7050a3-bf3a-e140-86ac-92631b66ae7b"],

