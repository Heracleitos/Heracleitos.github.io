         RowBox[{"nD", "+", "nH"}]], "]"}]}], ";", 
      RowBox[{"objective", "=", 
       RowBox[{"dauMeasureExpression", "[", 
        RowBox[{"canonicalMeasure", ",", 
         RowBox[{"dauUpperTail", "[", 
          RowBox[{
          "canonicalModelD", ",", "thresholdVariable", ",", "muD", ",", 
           "sigmaD"}], "]"}], ",", 
         RowBox[{"dauLowerTail", "[", 
          RowBox[{
          "canonicalModelH", ",", "thresholdVariable", ",", "muH", ",", 
           "sigmaH"}], "]"}], ",", "prevalence"}], "]"}]}], ";", 
      RowBox[{"optimum", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NMaximize", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"objective", ",", 
              RowBox[{"thresholdVariable", ">", "muH"}]}], "}"}], ",", 
            "thresholdVariable"}], "]"}], ",", "$Failed"}], "]"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"optimum", "===", "$Failed"}], "||", 
         RowBox[{"!", 
          RowBox[{"MatchQ", "[", 
           RowBox[{"optimum", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"_", "?", "daiFiniteRealQ"}], ",", 
              RowBox[{"{", 
               RowBox[{"_Rule", ".."}], "}"}]}], "}"}]}], "]"}]}]}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      RowBox[{"best", "=", 
