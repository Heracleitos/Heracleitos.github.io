  RowBox[{
   RowBox[{"dauCanonicalModel", "[", "model_", "]"}], ":=", 
   RowBox[{"Switch", "[", 
    RowBox[{
     RowBox[{"ToLowerCase", "[", 
      RowBox[{"ToString", "[", "model", "]"}], "]"}], ",", 
     RowBox[{"\"\<normal\>\"", "|", "\"\<normaldistribution\>\""}], 
     ",", "\"\<Normal\>\"", ",", 
     RowBox[{"\"\<lognormal\>\"", "|", "\"\<log-normal\>\"", 
      "|", "\"\<lognormaldistribution\>\""}], ",", "\"\<Lognormal\>\"", ",", 
     RowBox[{"\"\<gamma\>\"", "|", "\"\<gammadistribution\>\""}], 
     ",", "\"\<Gamma\>\"", ",", "_", ",", "$Failed"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"dauCanonicalMeasure", "[", "measure_", "]"}], ":=", 
   RowBox[{"Switch", "[", 
    RowBox[{
     RowBox[{"ToLowerCase", "[", 
      RowBox[{"StringReplace", "[", 
       RowBox[{
        RowBox[{"ToString", "[", "measure", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\< \>\"", "\[Rule]", "\"\<\>\""}], ",", 
          RowBox[{"\"\<_\>\"", "\[Rule]", "\"\<\>\""}], ",", 
          RowBox[{"\"\<-\>\"", "\[Rule]", "\"\<\>\""}]}], "}"}]}], "]"}], 
      "]"}], ",", 
     RowBox[{"\"\<sns\>\"", "|", "\"\<se\>\"", "|", "\"\<sensitivity\>\""}], 
     ",", "\"\<Sensitivity\>\"", ",", 
     RowBox[{"\"\<spc\>\"", "|", "\"\<sp\>\"", "|", "\"\<specificity\>\""}], 
     ",", "\"\<Specificity\>\"", ",", 
     RowBox[{"\"\<oda\>\"", "|", "\"\<acc\>\"", "|", "\"\<accuracy\>\"", 
      "|", "\"\<overalldiagnosticaccuracy\>\""}], ",", "\"\<Accuracy\>\"", ",", 
     RowBox[{"\"\<ppv\>\"", "|", "\"\<positivepredictivevalue\>\""}], 
     ",", "\"\<PPV\>\"", ",", 
     RowBox[{"\"\<npv\>\"", "|", "\"\<negativepredictivevalue\>\""}], 
     ",", "\"\<NPV\>\"", ",", 
     RowBox[{"\"\<dor\>\"", "|", "\"\<diagnosticoddsratio\>\""}], 
     ",", "\"\<DOR\>\"", ",", 
     RowBox[{"\"\<plr\>\"", "|", "\"\<lr+\>\"", "|", "\"\<lrpositive\>\"", 
      "|", "\"\<positivelikelihoodratio\>\""}], ",", "\"\<LRPositive\>\"", ",", 
     RowBox[{"\"\<nlr\>\"", "|", "\"\<lr\>\"", "|", "\"\<lrnegative\>\"", 
      "|", "\"\<negativelikelihoodratio\>\""}], ",", "\"\<LRNegative\>\"", ",", 
     RowBox[{"\"\<js\>\"", "|", "\"\<j\>\"", "|", "\"\<youden\>\"", 
      "|", "\"\<youdenindex\>\""}], ",", "\"\<Youden\>\"", ",", 
     RowBox[{"\"\<ba\>\"", "|", "\"\<balancedaccuracy\>\""}], 
