  RowBox[{
   RowBox[{"daiNumber", "[", 
    RowBox[{"value_", ",", 
     RowBox[{"digits_", ":", "4"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"safeDigits", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"IntegerQ", "[", "digits", "]"}], "&&", 
          RowBox[{"digits", ">", "0"}]}], ",", "digits", ",", "4"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"value", "===", "\[Infinity]"}], ",", "\[Infinity]", ",", 
       RowBox[{"value", "===", 
        RowBox[{"-", "\[Infinity]"}]}], ",", 
       RowBox[{"-", "\[Infinity]"}], ",", 
       RowBox[{"!", 
