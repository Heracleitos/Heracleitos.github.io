       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"N", "[", "value", "]"}], "]"}], "\[GreaterEqual]", 
         SuperscriptBox["10", 
          RowBox[{"safeDigits", "+", "2"}]]}], "||", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"N", "[", "value", "]"}], "]"}], "<", 
         SuperscriptBox["10", 
          RowBox[{"-", "safeDigits"}]]}]}], ",", 
