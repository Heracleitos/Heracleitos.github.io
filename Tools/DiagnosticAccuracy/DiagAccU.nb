        "confidenceLevel", ",", "\"\<StudentT\>\"", ",", 
         "effectiveDegreesOfFreedom"}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"coverageFactor", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      RowBox[{"expandedUncertainty", "=", 
       RowBox[{"coverageFactor", " ", "totalStandardUncertainty"}]}], ";", 
      RowBox[{"rawInterval", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"value", "-", "expandedUncertainty"}], ",", 
         RowBox[{"value", "+", "expandedUncertainty"}]}], "}"}]}], ";", 
      RowBox[{"measureRange", "=", 
       RowBox[{"dauMeasureRange", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"result", ",", "\"\<measure\>\"", ",", "measure"}], "]"}], 
        "]"}]}], ";", 
      RowBox[{"confidenceInterval", "=", 
       RowBox[{"dauConstrainInterval", "[", 
        RowBox[{"rawInterval", ",", "measureRange"}], "]"}]}], ";", 
      RowBox[{"Join", "[", 
       RowBox[{"result", ",", 
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<SourceVariances\>\"", "\[Rule]", "sourceVariances"}], ",", 
          
          RowBox[{"\"\<SourceStandardUncertainties\>\"", "\[Rule]", 
           "sourceStandardUncertainties"}], ",", 
          
          RowBox[{"\"\<FirstOrderMeasurementStandardUncertainty\>\"", "\[Rule]",
            "firstOrderMeasurementStandardUncertainty"}], ",", 
          
          RowBox[{"\"\<MeasurementStandardUncertainty\>\"", "\[Rule]", 
           "measurementStandardUncertainty"}], ",", 
          RowBox[{"\"\<TotalVariance\>\"", "\[Rule]", "totalVariance"}], ",", 
          
          RowBox[{"\"\<TotalStandardUncertainty\>\"", "\[Rule]", 
           "totalStandardUncertainty"}], ",", 
          
          RowBox[{"\"\<EffectiveDegreesOfFreedom\>\"", "\[Rule]", 
           "effectiveDegreesOfFreedom"}], ",", 
          RowBox[{"\"\<CoverageFactor\>\"", "\[Rule]", "coverageFactor"}], ",", 
          RowBox[{"\"\<ExpandedUncertainty\>\"", "\[Rule]", 
           "expandedUncertainty"}], ",", 
          RowBox[{"\"\<RawConfidenceInterval\>\"", "\[Rule]", "rawInterval"}],
           ",", 
          RowBox[{"\"\<MeasureRange\>\"", "\[Rule]", "measureRange"}], ",", 
          
          RowBox[{"\"\<ConfidenceInterval\>\"", "\[Rule]", 
           "confidenceInterval"}], ",", 
          
          RowBox[{"\"\<IntervalInterpretation\>\"", 
           "\[Rule]", "\"\<Two-sided expanded-uncertainty interval with \
nonlinear propagation\>\""}], ",", 
          
          RowBox[{"\"\<ThresholdPropagationMethod\>\"", 
           "\[Rule]", "\"\<Nine-point Gauss-Hermite propagation of one shared \
threshold\>\""}]}], "]"}]}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"daiOptimalDPCI", "[", 
    RowBox[{
     RowBox[{"threshold_", "?", "NumericQ"}], ",", 
     RowBox[{"confidenceLevel_", "?", "NumericQ"}], ",", 
     RowBox[{"nD_", "?", "NumericQ"}], ",", 
     RowBox[{"nH_", "?", "NumericQ"}], ",", "muD_", ",", "muH_", ",", 
