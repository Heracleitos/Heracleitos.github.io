  RowBox[{
   RowBox[{"daiOptimalThresholdRecord", "[", 
    RowBox[{
    "measure_", ",", "confidenceLevel_", ",", "nD_", ",", "nH_", ",", "muD_", 
     ",", "muH_", ",", "sigmaD_", ",", "sigmaH_", ",", 
     "measurementSampleSize_", ",", "b0_", ",", "b1_", ",", "nl_", ",", 
     "modelD_", ",", "modelH_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
