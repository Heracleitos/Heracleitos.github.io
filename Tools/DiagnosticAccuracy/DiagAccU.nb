      "b1_", ",", "nl_", ",", "measure_", ",", "modelD_", ",", "modelH_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"result", ",", "interval"}], "}"}], ",", 
     RowBox[{
      RowBox[{"result", "=", 
       RowBox[{"daiOptimalInterval", "[", 
        RowBox[{
        "threshold", ",", "confidenceLevel", ",", "nD", ",", "nH", ",", "muD",
          ",", "muH", ",", "sigmaD", ",", "sigmaH", ",", 
