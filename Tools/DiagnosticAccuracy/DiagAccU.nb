     RowBox[{"\"\<cz\>\"", "|", "\"\<concordance\>\"", 
      "|", "\"\<concordanceprobability\>\""}], 
     ",", "\"\<ConcordanceProbability\>\"", ",", 
     RowBox[{"\"\<fmi\>\"", "|", "\"\<fowlkesmallows\>\"", 
      "|", "\"\<fowlkesmallowsindex\>\""}], ",", "\"\<FowlkesMallows\>\"", ",", 
     RowBox[{"\"\<ck\>\"", "|", "\"\<kappa\>\"", "|", "\"\<cohenkappa\>\"", 
      "|", "\"\<cohenskappa\>\""}], ",", "\"\<CohenKappa\>\"", ",", 
     RowBox[{"\"\<pabak\>\"", 
      "|", "\"\<prevalenceadjustedbiasadjustedkappa\>\""}], 
     ",", "\"\<PABAK\>\"", ",", 
     RowBox[{"\"\<f1s\>\"", "|", "\"\<f1\>\"", "|", "\"\<f1score\>\""}], 
     ",", "\"\<F1\>\"", ",", 
     RowBox[{"\"\<mcc\>\"", "|", "\"\<matthews\>\"", 
      "|", "\"\<matthewscorrelationcoefficient\>\""}], ",", "\"\<MCC\>\"", ",",
      "_", ",", "$Failed"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"dauUpperTail", "[", 
    RowBox[{"\"\<Normal\>\"", ",", "t_", ",", "mu_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"Erfc", "[", 
     FractionBox[
      RowBox[{"t", "-", "mu"}], 
      RowBox[{
       SqrtBox["2"], " ", "sigma"}]], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"dauUpperTail", "[", 
    RowBox[{"\"\<Lognormal\>\"", ",", "t_", ",", "mu_", ",", "sigma_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "v", "}"}], ",", 
     RowBox[{
      RowBox[{"v", "=", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["sigma", "mu"], ")"}], "2"]}], "]"}]}], ";", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"Erfc", "[", 
        FractionBox[
         RowBox[{
          RowBox[{"Log", "[", 
           FractionBox["t", "mu"], "]"}], "+", 
          FractionBox["v", "2"]}], 
         SqrtBox[
          RowBox[{"2", " ", "v"}]]], "]"}]}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"dauUpperTail", "[", 
    RowBox[{"\"\<Gamma\>\"", ",", "t_", ",", "mu_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{"GammaRegularized", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["mu", "sigma"], ")"}], "2"], ",", 
     FractionBox[
      RowBox[{"t", " ", "mu"}], 
      SuperscriptBox["sigma", "2"]]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"dauLowerTail", "[", 
    RowBox[{"\"\<Normal\>\"", ",", "t_", ",", "mu_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"Erfc", "[", 
     FractionBox[
      RowBox[{"mu", "-", "t"}], 
      RowBox[{
       SqrtBox["2"], " ", "sigma"}]], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"dauLowerTail", "[", 
    RowBox[{"\"\<Lognormal\>\"", ",", "t_", ",", "mu_", ",", "sigma_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "v", "}"}], ",", 
     RowBox[{
      RowBox[{"v", "=", 
       RowBox[{"Log", "[", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["sigma", "mu"], ")"}], "2"]}], "]"}]}], ";", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"Erfc", "[", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{"Log", "[", 
            FractionBox["t", "mu"], "]"}], "+", 
           FractionBox["v", "2"]}], 
          SqrtBox[
           RowBox[{"2", " ", "v"}]]]}], "]"}]}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"dauLowerTail", "[", 
    RowBox[{"\"\<Gamma\>\"", ",", "t_", ",", "mu_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{"GammaRegularized", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["mu", "sigma"], ")"}], "2"], ",", "0", ",", 
     FractionBox[
      RowBox[{"t", " ", "mu"}], 
      SuperscriptBox["sigma", "2"]]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"dauCentralMoments34", "[", 
    RowBox[{"\"\<Normal\>\"", ",", "mu_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"3", " ", 
      SuperscriptBox["sigma", "4"]}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"dauCentralMoments34", "[", 
    RowBox[{"\"\<Lognormal\>\"", ",", "mu_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "c", "}"}], ",", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"1", "+", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["sigma", "mu"], ")"}], "2"]}]}], ";", 
      RowBox[{"{", 
       RowBox[{
        FractionBox[
         RowBox[{
          SuperscriptBox["sigma", "4"], " ", 
          RowBox[{"(", 
           RowBox[{"c", "+", "2"}], ")"}]}], "mu"], ",", 
        RowBox[{
         SuperscriptBox["sigma", "4"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["c", "4"], "+", 
           RowBox[{"2", " ", 
            SuperscriptBox["c", "3"]}], "+", 
           RowBox[{"3", " ", 
            SuperscriptBox["c", "2"]}], "-", "3"}], ")"}]}]}], "}"}]}]}], 
    "]"}]}], ";", 
  RowBox[{
   RowBox[{"dauCentralMoments34", "[", 
    RowBox[{"\"\<Gamma\>\"", ",", "mu_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", 
       SuperscriptBox["sigma", "4"]}], "mu"], ",", 
     RowBox[{
      RowBox[{"3", " ", 
       SuperscriptBox["sigma", "4"]}], "+", 
      FractionBox[
       RowBox[{"6", " ", 
        SuperscriptBox["sigma", "6"]}], 
       SuperscriptBox["mu", "2"]]}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"dauMeanSDCovariance", "[", 
    RowBox[{"model_", ",", "n_", ",", "mu_", ",", "sigma_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"centralMoment3", ",", "centralMoment4"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"centralMoment3", ",", "centralMoment4"}], "}"}], "=", 
       RowBox[{"dauCentralMoments34", "[", 
        RowBox[{"model", ",", "mu", ",", "sigma"}], "]"}]}], ";", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           SuperscriptBox["sigma", "2"], "n"], ",", 
          FractionBox["centralMoment3", 
           RowBox[{"2", " ", "n", " ", "sigma"}]]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          FractionBox["centralMoment3", 
           RowBox[{"2", " ", "n", " ", "sigma"}]], ",", 
          FractionBox[
           RowBox[{"centralMoment4", "-", 
            FractionBox[
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "-", "3"}], ")"}], " ", 
              SuperscriptBox["sigma", "4"]}], 
             RowBox[{"n", "-", "1"}]]}], 
           RowBox[{"4", " ", "n", " ", 
            SuperscriptBox["sigma", "2"]}]]}], "}"}]}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"dauMeasureExpression", "[", 
    RowBox[{
    "measure_", ",", "sensitivity_", ",", "specificity_", ",", 
     "prevalence_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "accuracy", ",", "predictedPositive", ",", "ppv", ",", "npv", ",", 
       "expectedAgreement", ",", "youden", ",", "denominator"}], "}"}], ",", 
     RowBox[{
      RowBox[{"accuracy", "=", 
       RowBox[{
        RowBox[{"prevalence", " ", "sensitivity"}], "+", 
