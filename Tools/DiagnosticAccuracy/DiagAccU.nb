          RowBox[{"6", " ", "sigmaH"}]}]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{"positiveSupport", ",", 
        RowBox[{"lower", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0.01`", ",", "lower"}], "]"}]}]}], "]"}], ";", 
