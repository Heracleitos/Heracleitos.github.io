        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", "lower", "]"}], ",", 
          RowBox[{"N", "[", "upper", "]"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
  RowBox[{
