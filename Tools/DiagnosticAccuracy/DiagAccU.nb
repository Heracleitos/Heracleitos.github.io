        RowBox[{"DiagonalMatrix", "[", "adjustedEigenvalues", "]"}], ".", 
        "eigenvectors"}]}], ";", 
      RowBox[{"N", "[", 
       FractionBox[
        RowBox[{"adjusted", "+", 
         TemplateBox[{"adjusted"},
          "Transpose"]}], "2"], "]"}]}]}], "]"}]}], ";", 
