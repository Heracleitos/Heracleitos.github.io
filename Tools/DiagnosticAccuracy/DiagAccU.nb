      RowBox[{"canonicalModelD", "=", 
       RowBox[{"daiCanonicalModel", "[", "modelD", "]"}]}], ";", 
      RowBox[{"canonicalModelH", "=", 
       RowBox[{"daiCanonicalModel", "[", "modelH", "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "canonicalMeasure", ",", "canonicalModelD", ",", 
            "canonicalModelH"}], "}"}], ",", "$Failed"}], "]"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      RowBox[{"prevalence", "=", 
