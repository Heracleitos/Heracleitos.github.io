        "threshold", ",", "nD", ",", "nH", ",", "muD", ",", "muH", ",", 
         "sigmaD", ",", "sigmaH", ",", "b0", ",", "b1", ",", "nl", ",", 
         "measure", ",", "modelD", ",", "modelH"}], "]"}]}], ";", 
      RowBox[{"sourceVariances", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"result", ",", "\"\<SourceVariances\>\"", ",", 
         RowBox[{"Missing", "[", "]"}]}], "]"}]}], ";", 
      RowBox[{"sourceDegreesOfFreedom", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"result", ",", "\"\<SourceDegreesOfFreedom\>\"", ",", 
         RowBox[{"Missing", "[", "]"}]}], "]"}]}], ";", 
      RowBox[{"value", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"result", ",", "\"\<Value\>\"", ",", "Indeterminate"}], 
        "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"AssociationQ", "[", "sourceVariances", "]"}]}], "||", 
         RowBox[{"!", 
          RowBox[{"AssociationQ", "[", "sourceDegreesOfFreedom", "]"}]}], "||", 
         RowBox[{"!", 
          RowBox[{"daiFiniteRealQ", "[", "value", "]"}]}], "||", 
         RowBox[{"!", 
          RowBox[{
          "daiFiniteRealQ", "[", "measurementStandardUncertainty", "]"}]}]}], 
        ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
      RowBox[{"firstOrderMeasurementStandardUncertainty", "=", 
       SqrtBox[
        RowBox[{"Max", "[", 
         RowBox[{"0.`", ",", 
          RowBox[{"Lookup", "[", 
           RowBox[{
           "sourceVariances", ",", "\"\<ThresholdMeasurement\>\"", ",", 
            "0.`"}], "]"}]}], "]"}]]}], ";", 
      RowBox[{"sourceVariances", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"sourceVariances", ",", 
         RowBox[{"Association", "[", 
          RowBox[{"\"\<ThresholdMeasurement\>\"", "\[Rule]", 
           SuperscriptBox["measurementStandardUncertainty", "2"]}], "]"}]}], 
        "]"}]}], ";", 
      RowBox[{"sourceStandardUncertainties", "=", 
       RowBox[{"Sqrt", "/@", "sourceVariances"}]}], ";", 
      RowBox[{"totalVariance", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"Values", "[", "sourceVariances", "]"}], "]"}]}], ";", 
      RowBox[{"denominator", "=", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"key", ",", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"variance", "=", 
                RowBox[{"Lookup", "[", 
                 RowBox[{"sourceVariances", ",", "key", ",", "0.`"}], "]"}]}],
                ",", 
               RowBox[{"degrees", "=", 
                RowBox[{"Lookup", "[", 
                 RowBox[{
                 "sourceDegreesOfFreedom", ",", "key", ",", "\[Infinity]"}], 
                 "]"}]}]}], "}"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"TrueQ", "[", 
                 RowBox[{"variance", "\[Equal]", "0"}], "]"}], "||", 
                RowBox[{"degrees", "===", "\[Infinity]"}]}], ",", "0.`", ",", 
               FractionBox[
                SuperscriptBox["variance", "2"], "degrees"]}], "]"}]}], 
            "]"}]}], "]"}], "/@", 
         RowBox[{"Keys", "[", "sourceVariances", "]"}]}], "]"}]}], ";", 
      RowBox[{"effectiveDegreesOfFreedom", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"totalVariance", "\[Equal]", "0"}], "]"}], ",", 
         "\[Infinity]", ",", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"denominator", "\[Equal]", "0"}], "]"}], ",", "\[Infinity]",
          ",", "True", ",", 
         FractionBox[
          SuperscriptBox["totalVariance", "2"], "denominator"]}], "]"}]}], ";", 
      RowBox[{"totalStandardUncertainty", "=", 
       SqrtBox[
        RowBox[{"Max", "[", 
         RowBox[{"0.`", ",", "totalVariance"}], "]"}]]}], ";", 
      RowBox[{"coverageFactor", "=", 
       RowBox[{"dauCoverageFactor", "[", 
