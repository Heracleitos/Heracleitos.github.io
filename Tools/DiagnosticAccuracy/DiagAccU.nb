          RowBox[{"thresholdVariable", "/.", "\[VeryThinSpace]", 
           RowBox[{"Last", "[", "optimum", "]"}]}], "]"}], ",", 
         RowBox[{"N", "[", 
          RowBox[{"First", "[", "optimum", "]"}], "]"}]}], "}"}]}], ";", 
      RowBox[{"components", "=", 
       RowBox[{"daiOptimalComponents", "[", 
        RowBox[{
         RowBox[{
